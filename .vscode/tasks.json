{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Compile",
			"type": "shell",
			"command": "bun run compile",
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}/editors/code"
			},
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Watch",
			"type": "shell",
			"command": "bun run watch",
			"options": {
				"cwd": "${workspaceFolder}/editors/code"
			},
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc-watch"
			]
		}
	]
}