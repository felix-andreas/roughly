---
import '@fontsource/geist-sans/400.css'
import '@fontsource/geist-sans/500.css'
import '@fontsource/geist-sans/600.css'
import '@fontsource/geist-mono/400.css'
import '@fontsource/geist-mono/500.css'

const navLinks = [
  { label: 'Docs', href: '/getting-started' },
  { label: 'Type Checker', href: '/type-checker' },
  { label: 'Formatter', href: '/formatter' },
  { label: 'Linter', href: '/linter' },
  { label: 'Config', href: '/configuration' },
  { label: 'GitHub', href: 'https://github.com/felix-andreas/roughly' },
]

const capabilities = [
  {
    title: 'Language server',
    accent: 'cyan',
    blurb:
      'Completion, hover, go-to-definition, references, rename, and inlay hints — live in your editor.',
    link: { label: 'Language server', href: '/language-server' },
  },
  {
    title: 'Code analyzer',
    accent: 'violet',
    blurb:
      'Lint diagnostics on by default — plus the first static type checker for R, opt-in.',
    link: { label: 'Type checker', href: '/type-checker' },
  },
  {
    title: 'Formatter',
    accent: 'emerald',
    blurb:
      'roughly fmt rewrites your whole project to one consistent style, with a --diff mode for CI.',
    link: { label: 'Formatter', href: '/formatter' },
  },
]

const lspTabs = [
  { key: 'completion', label: 'Completion' },
  { key: 'hover', label: 'Hover' },
  { key: 'gotodef', label: 'Go-to-definition' },
  { key: 'refs', label: 'Find references' },
  { key: 'rename', label: 'Rename' },
  { key: 'inlay', label: 'Inlay hints' },
]

const analysisTabs = [
  { key: 'typecheck', label: 'Type checking' },
  { key: 'inference', label: 'Inference' },
  { key: 'linting', label: 'Linting' },
]

const formatterTabs = [
  { key: 'spacing', label: 'Operators & spacing' },
  { key: 'pipeline', label: 'Pipelines' },
  { key: 'normalize', label: 'Quotes, comments & types' },
]

const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Roughly — the first type checker for R, and the tooling to match</title>
    <meta
      name="description"
      content="Roughly is a fast Rust toolchain for R: the first static type checker, a full language server, and a project formatter in one tool. Catch type errors before you run — without changing your existing code."
    />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      // Set the reveal/static mode synchronously before first paint so the
      // hidden-until-scroll hero choreography never flashes its end state.
      ;(function () {
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches
        document.documentElement.classList.add(reduce ? 'hero-static' : 'hero-reveal')
      })()
    </script>
  </head>
  <body>
    <header class="nav" id="nav">
      <a class="brand" href="/getting-started" aria-label="Roughly home">
        <img class="logo" src="/logo.svg" alt="" width="24" height="24" />
        <span class="wordmark">Roughly</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              target={l.label === 'GitHub' ? '_blank' : undefined}
              rel={l.label === 'GitHub' ? 'noreferrer' : undefined}
            >
              {l.label}
            </a>
          ))
        }
        <a class="cta" href="/getting-started">Get started</a>
      </nav>
    </header>

    <main>
      <!-- ---------- hero ---------- -->
      <section id="hero">
        <div class="hero-viewport" id="hero-viewport">
        <canvas id="hero-canvas" aria-hidden="true"></canvas>
        <div class="hero-vignette" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="eyebrow">the first type checker for R · written in rust</p>
          <h1>Modern developer tooling for R.</h1>
          <p class="subhead">
            Roughly is a fast, Rust-built toolchain — a static type checker, a language server, and a
            formatter in one. It catches type errors before you run your code, works in your editor,
            and changes nothing about the R you already have.
          </p>
          <div class="cta-cluster">
            <a class="cta cta-lg" href="/getting-started">Get started</a>
            <a
              class="btn-vscode"
              href="https://marketplace.visualstudio.com/items?itemName=felix-andreas.roughly"
              target="_blank"
              rel="noopener"
            >
              <svg class="brand-logo" width="18" height="18" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <mask id="vscMaskHero" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M70.9119 99.3171C72.4869 99.9307 74.2828 99.8914 75.8725 99.1264L96.4604 89.2197C98.6242 88.1787 100 85.9892 100 83.5872V16.4133C100 14.0113 98.6243 11.8218 96.4605 10.7808L75.8725 0.873756C73.7862 -0.130129 71.3446 0.11576 69.5135 1.44695C69.252 1.63711 69.0028 1.84943 68.769 2.08341L29.3551 38.0387L12.1872 25.0054C10.589 23.7919 8.35363 23.8919 6.86933 25.2444L1.36303 30.2592C-0.453713 31.9133 -0.455738 34.7779 1.35853 36.4347L16.2471 50.0001L1.35853 63.5655C-0.455738 65.2223 -0.453713 68.0869 1.36303 69.7411L6.86933 74.7558C8.35363 76.1084 10.589 76.2083 12.1872 74.9948L29.3551 61.9615L68.769 97.9168C69.3897 98.5345 70.1186 98.9942 70.9119 99.3171ZM75.0152 27.2989L45.1091 50.0001L75.0152 72.7012V27.2989Z" fill="white"/>
                </mask>
                <g mask="url(#vscMaskHero)"><rect width="100" height="100" fill="#0098FF"/></g>
              </svg>
              <span>Install in VS Code</span>
            </a>
            <a
              class="btn-vscode"
              href="https://zed.dev/extensions/roughly"
              target="_blank"
              rel="noopener"
            >
              <svg class="brand-logo zed-logo" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 128 128" aria-hidden="true"><path fill="#ffffff" d="M12 8a4 4 0 0 0-4 4v88H0V12C0 5.373 5.373 0 12 0h107.172c5.345 0 8.022 6.463 4.242 10.243L57.407 76.25H76V68h8v10.25a6 6 0 0 1-6 6H49.407L35.657 98H98V48h8v50a8 8 0 0 1-8 8H27.657l-14 14H116a4 4 0 0 0 4-4V28h8v88c0 6.627-5.373 12-12 12H8.828c-5.345 0-8.022-6.463-4.242-10.243L70.343 52H52v8h-8V50a6 6 0 0 1 6-6h28.343l14-14H30v50h-8V30a8 8 0 0 1 8-8h70.343l14-14Z"/></svg>
              <span>Install in Zed</span>
            </a>
          </div>
        </div>
        <div class="scroll-hint" aria-hidden="true">
          <span>scroll</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="m6 13 6 6 6-6" /></svg>
        </div>
        </div>
      </section>

      <!-- ---------- capabilities triad ---------- -->
      <section id="capabilities" class="band dotted">
        <div class="col">
          <p class="eyebrow">three tools, one binary</p>
          <h2>Three tools, one binary.</h2>
          <p class="lede">
            Built for R users who have outgrown RStudio: editor smarts, problem-catching analysis,
            and one consistent style from a single binary. R has world-class statistics — Roughly
            brings the IDE-grade tooling other ecosystems already take for granted, fast enough to
            scale past 300k lines.
          </p>
        </div>
        <div class="col show-col">
          <div class="cap-grid">
            {
              capabilities.map((c) => (
                <article class={`cap accent-${c.accent}`}>
                  <span class="cap-badge" aria-hidden="true">
                    {c.accent === 'cyan' && (
                      <svg class="cap-icon" xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" aria-hidden="true"><path d="m10 9l-3 3l3 3m4 0l3-3l-3-3" /><rect width="18" height="18" x="3" y="3" rx="2" /></svg>
                    )}
                    {c.accent === 'violet' && (
                      <svg class="cap-icon" xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12l2 2l4-4" /></svg>
                    )}
                    {c.accent === 'emerald' && (
                      <svg class="cap-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path class="rag" d="M5 8h9" />
                        <path class="rag" d="M5 12h6" />
                        <path class="rag" d="M5 16h11" />
                        <path class="guide" d="M19 6v12" />
                        <path class="tick tick-1" d="M14 8h5" />
                        <path class="tick tick-2" d="M11 12h8" />
                      </svg>
                    )}
                  </span>
                  <h3>{c.title}</h3>
                  <p>{c.blurb}</p>
                  <a class="doclink" href={c.link.href}>
                    {c.link.label} <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ---------- language server ---------- -->
      <section id="language-server" class="band has-accent accent-cyan">
        <div class="col">
          <p class="eyebrow">write</p>
          <h2>IDE features in your editor.</h2>
          <p class="lede">
            Completion, hover, go-to-definition, find references, rename, and inlay hints. Ships as a
            VS Code extension and speaks LSP, so it drops into any editor that does too.
          </p>
        </div>
        <div class="col show-col">
          <div class="tabs cap-cyan" data-tabs data-orientation="vertical">
            <div role="tablist" aria-label="Language server features" aria-orientation="vertical">
              {
                lspTabs.map((t, i) => (
                  <button
                    role="tab"
                    id={`tab-${t.key}`}
                    aria-controls={`panel-${t.key}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    {t.label}
                  </button>
                ))
              }
            </div>
            <div class="tab-panels">
              <!-- Completion -->
              <div role="tabpanel" id="panel-completion" aria-labelledby="tab-completion" tabindex="0">
                <div class="ed">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">model.R</span></div>
                  <div class="ed-body">
                    <div class="ln"><span class="c-fn">df</span> {'<- '}<span class="c-fn">read_csv</span>(<span class="c-str">"data.csv"</span>)</div>
                    <div class="ln comp-anchor"><span class="c-fn">df</span><span class="t-cap">$</span><span class="caret-blink" aria-hidden="true"></span><span class="ghosttext">count</span>
                      <div class="comp-pop" role="presentation">
                        <div class="comp-rowhl" aria-hidden="true"></div>
                        <div class="comp-row"><span class="kglyph">var</span><span class="comp-name">count</span></div>
                        <div class="comp-row"><span class="kglyph">var</span><span class="comp-name">category</span></div>
                        <div class="comp-row"><span class="kglyph">var</span><span class="comp-name">created_at</span></div>
                        <div class="comp-row"><span class="kglyph">var</span><span class="comp-name">is_active</span></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Hover -->
              <div role="tabpanel" id="panel-hover" aria-labelledby="tab-hover" tabindex="0" hidden>
                <div class="ed">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">model.R</span></div>
                  <div class="ed-body hover-wrap">
                    <div class="hover-tip" aria-hidden="true">
                      <code class="tip-sig"><span class="t-cap">add</span>: <span class="t-cap">{'<T: numeric>'}</span> fn(a: <span class="t-cap">T</span>, b: <span class="t-cap">T</span>) {'-> '}<span class="t-cap">T</span></code>
                      <div class="tip-doc">Inferred — no annotation required.</div>
                      <span class="tip-notch"></span>
                    </div>
                    <div class="ln hover-line"><span class="c-fn hover-tok">add</span><span class="hover-underline" aria-hidden="true"></span> {'<- '}<span class="c-kw">function</span>(a, b) a + b</div>
                  </div>
                </div>
              </div>
              <!-- Go-to-definition -->
              <div role="tabpanel" id="panel-gotodef" aria-labelledby="tab-gotodef" tabindex="0" hidden>
                <div class="ed">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">model.R</span></div>
                  <div class="ed-body gotodef-body">
                    <svg class="gotodef-connector" viewBox="0 0 320 110" preserveAspectRatio="none" aria-hidden="true">
                      <path class="gd-line" d="M70 20 C 30 44, 30 66, 58 86" />
                      <path class="gd-arrow" d="M52 80 l 7 7 l 8 -4" />
                    </svg>
                    <div class="ln"><span class="c-fn">total</span> {'<- '}<span class="gd-link">score</span>(x)</div>
                    <div class="gd-divider" aria-hidden="true"></div>
                    <div class="ln gd-def"><span class="gd-gutter" aria-hidden="true"></span><span class="c-fn gd-name">score</span> {'<- '}<span class="c-kw">function</span>(x) x * weight</div>
                  </div>
                </div>
              </div>
              <!-- Find references -->
              <div role="tabpanel" id="panel-refs" aria-labelledby="tab-refs" tabindex="0" hidden>
                <div class="refs-wrap">
                  <div class="refs-head"><span class="refs-chip"><span class="refs-count">3</span> references</span></div>
                  <div class="ed">
                    <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">model.R</span></div>
                    <div class="ed-body">
                      <div class="ln"><span class="c-fn">score</span> {'<- '}<span class="c-kw">function</span>(x) x * <span class="ref">weight</span></div>
                      <div class="ln"><span class="c-fn">adj</span> {'<- '}<span class="ref">weight</span> * 2</div>
                    </div>
                  </div>
                  <div class="ed">
                    <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">score.R</span></div>
                    <div class="ed-body">
                      <div class="ln"><span class="ref">weight</span> {'<- '}0.7</div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Rename -->
              <div role="tabpanel" id="panel-rename" aria-labelledby="tab-rename" tabindex="0" hidden>
                <div class="ed">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">model.R</span></div>
                  <div class="ed-body">
                    <div class="ln"><span class="c-fn">score</span> {'<- '}<span class="c-kw">function</span>(x) x * <span class="rename-box"><span class="rename-text">weight</span><span class="caret-blink" aria-hidden="true"></span></span></div>
                    <div class="ln"><span class="c-fn">adj</span> {'<- '}<span class="ghost-tok">weight</span> * 2 <span class="will-dot" aria-hidden="true"></span></div>
                    <div class="ln"><span class="ghost-tok">weight</span> {'<- '}0.7 <span class="will-dot" aria-hidden="true"></span></div>
                  </div>
                </div>
              </div>
              <!-- Inlay hints -->
              <div role="tabpanel" id="panel-inlay" aria-labelledby="tab-inlay" tabindex="0" hidden>
                <div class="ed">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">model.R</span></div>
                  <div class="ed-body">
                    <div class="ln"><span class="c-fn">add</span> {'<- '}<span class="c-kw">function</span>(a, b) a + b <span class="inlay-pill">{'<T: numeric>'} fn(a: T, b: T) {'-> '}T</span></div>
                    <div class="ln"><span class="c-fn">score</span>(<span class="inlay-arg">x:</span> data)</div>
                  </div>
                </div>
                <p class="band-note">The inferred signature shows up as an inlay hint — no annotation required.</p>
              </div>
            </div>
          </div>
          <a class="doclink" href="/language-server">Language server docs <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <!-- ---------- code analysis ---------- -->
      <section id="code-analysis" class="band band-spotlight has-accent accent-violet">
        <div class="col">
          <p class="eyebrow">check</p>
          <h2>Code analysis.</h2>
          <p class="lede">
            Lint diagnostics run by default, flagging problems before you even run your code. Go
            deeper with the first static type checker for R — automatic inference checks most of your
            code with zero annotations, and the type checker stays opt-in.
          </p>
        </div>
        <div class="col show-col">
          <div class="tabs cap-violet" data-tabs data-orientation="vertical">
            <div role="tablist" aria-label="Code analysis" aria-orientation="vertical">
              {
                analysisTabs.map((t, i) => (
                  <button
                    role="tab"
                    id={`tab-${t.key}`}
                    aria-controls={`panel-${t.key}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    {t.label}
                  </button>
                ))
              }
            </div>
            <div class="tab-panels">
              <!-- Type checking -->
              <div role="tabpanel" id="panel-typecheck" aria-labelledby="tab-typecheck" tabindex="0">
                <div class="ed">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">model.R</span></div>
                  <div class="ed-body">
                    <div class="ln c-muted"><span class="ann-dot" tabindex="0" role="note" aria-label="A #: comment — an ordinary comment to every other R tool." data-tip="A #: comment — an ordinary comment to every other R tool.">#:</span> fn(count: integer) {'-> '}integer</div>
                    <div class="ln"><span class="c-fn">double_count</span> {'<- '}<span class="c-kw">function</span>(count) count + count</div>
                    <div class="ln"><span class="c-fn">double_count</span>(<span class="squig-wrap"><span class="c-str">"two"</span><span class="squig" aria-hidden="true"></span></span>)</div>
                    <div class="ln caret-line" aria-hidden="true"><span class="caret">             ^^^^^</span></div>
                    <div class="ln err-line"><span class="c-muted">#</span> <span class="diag-err">error[type-error]</span> expected <span class="pill">integer</span>, found <span class="pill">character</span></div>
                  </div>
                </div>
                <p class="doclink-row"><a class="doclink" href="/type-checker">Type checker docs <span aria-hidden="true">→</span></a></p>
              </div>
              <!-- Inference -->
              <div role="tabpanel" id="panel-inference" aria-labelledby="tab-inference" tabindex="0" hidden>
                <div class="ed">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">model.R</span></div>
                  <div class="ed-body">
                    <div class="ln"><span class="c-fn">add</span> {'<- '}<span class="c-kw">function</span>(<span class="param">a</span>, <span class="param">b</span>) <span class="param">a</span> + <span class="param">b</span>   <span class="infer-hint">{'# inferred: '}<span class="t-cap">{'<T: numeric>'}</span> fn(a: <span class="t-cap">T</span>, b: <span class="t-cap">T</span>) {'-> '}<span class="t-cap">T</span></span></div>
                  </div>
                </div>
                <p class="band-note">Most code needs no annotations at all — inference resolves the types for you.</p>
                <p class="doclink-row"><a class="doclink" href="/type-checker">How inference works <span aria-hidden="true">→</span></a></p>
              </div>
              <!-- Linting -->
              <div role="tabpanel" id="panel-linting" aria-labelledby="tab-linting" tabindex="0" hidden>
                <div class="ed term">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">felix@host: ~/project</span></div>
                  <div class="ed-body">
                    <div class="ln"><span class="prompt">$</span> <span class="lint-cmd">roughly check</span></div>
                    <div class="ln lint-err"><span class="diag-err">error:</span> Syntax Error: unexpected <span class="pill">{'"{"'}</span>  <span class="c-muted">(R/main.R)</span></div>
                    <div class="ln lint-warn"><span class="diag-warn">warning:</span> variable <span class="pill">x</span> is never used  <span class="c-muted">(R/utils.R)</span></div>
                  </div>
                </div>
                <p class="doclink-row"><a class="doclink" href="/linter">Linter docs <span aria-hidden="true">→</span></a></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ---------- formatter ---------- -->
      <section id="formatter" class="band has-accent accent-emerald dotted">
        <div class="col">
          <p class="eyebrow">ship</p>
          <h2>One consistent style.</h2>
          <p class="lede">
            Bad R reflows into formatted R in place — spacing tightens around some operators and
            opens around others, indentation snaps to a grid, quotes and comments normalize, and
            changed tokens flash red, then green, then settle. <code>roughly fmt</code> (and
            <code>--diff</code> for CI).
          </p>
        </div>
        <div class="col show-col">
          <div class="tabs fmt-tabs cap-emerald" data-tabs data-morph-section data-orientation="horizontal">
            <div role="tablist" aria-label="Formatter examples" aria-orientation="horizontal">
              {
                formatterTabs.map((t, i) => (
                  <button
                    role="tab"
                    id={`tab-${t.key}`}
                    aria-controls={`panel-${t.key}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    {t.label}
                  </button>
                ))
              }
            </div>
            <div class="tab-panels">
              <!-- Operators & spacing -->
              <div role="tabpanel" id="panel-spacing" aria-labelledby="tab-spacing" tabindex="0">
                <div class="ed">
                  <div class="ed-bar"><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-dot"></span><span class="ed-name">operators.R · roughly fmt</span></div>
                  <div class="ed-body fmt-body">
                    <div class="fmt-morph" aria-hidden="true">
