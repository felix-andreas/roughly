    <script>
      // ======================================================================
      // Hero particle field. On load the field runs a one-shot intro: fine sharp
      // particles fly in and assemble into the R logo leaving soft light trails,
      // hold, then burst outward into a drifting ambient field. As you then scroll
      // the hero, the same particles are constrained into the headline "Modern
      // developer tooling for R." — the letters are drawn by the particles
      // themselves; there is no separate DOM heading laid on top.
      // ======================================================================
      type Particle = {
        x: number
        y: number
        vx: number
        vy: number
        // The three shapes a particle can lock onto, in scroll order: its logo
        // point (assembled during the intro), its "Roughly" wordmark point, and its
        // headline point. When claimed by none it flows freely on the field.
        lx: number
        ly: number
        rx: number
        ry: number
        hx: number
        hy: number
        // Scatter home: a spread-out spot across the field the particle disperses to
        // between shapes, so the swarm reads as individual particles rather than a
        // blob before it re-gathers into the next shape.
        sx: number
        sy: number
        // How strongly this particle joins the shapes: ~1 = settles onto the glyph
        // and then the letters, 0 = a pure drifter that only ever flows.
        logoness: number
        depth: number
        seed: number
      }
      type Target = { x: number; y: number }

      const heroCanvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null
      // The particle field fills the sticky viewport pin (100svh), not the tall
      // scroll stage (#hero) that drives the scroll morph.
      const heroEl = document.getElementById('hero-viewport') as HTMLElement | null

      // As you scroll, the particles resolve through two text shapes: first the
      // "Roughly" wordmark, then the headline (wrapped to two lines so the particle
      // text roughly matches the hidden <h1>).
      const ROUGHLY_LINES = ['Roughly']
      const HEADING_LINES = ['Modern developer', 'tooling for R.']

      function initHero() {
        if (!heroCanvas || !heroEl) return
        const ctx = heroCanvas.getContext('2d')
        if (!ctx) return
        const context = ctx
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        // Load intro (seconds): particles fly in and assemble onto the logo. `intro`
        // (below) rises 0->1 over the assemble window and then stays 1 — the logo
        // holds rather than dispersing.
        const INTRO_DELAY = 0.25
        const ASSEMBLE = 1.7
        // Idle cycle (seconds): parked at the top, the shape holds, then bursts
        // outward into a streaming swarm, drifts as the swarm, and re-gathers into
        // the other shape — logo, then the "Roughly" wordmark, back and forth. One
        // half-cycle is HOLD -> FALL (the burst) -> STREAM -> RISE (gather); the two
        // shapes alternate each half-cycle.
        const CYCLE_HOLD = 5
        const CYCLE_FALL = 1
        const CYCLE_STREAM = 4
        const CYCLE_RISE = 2
        const CYCLE_HALF = CYCLE_HOLD + CYCLE_FALL + CYCLE_STREAM + CYCLE_RISE

        let dpr = Math.min(window.devicePixelRatio || 1, 2)
        let cssW = 0
        let cssH = 0
        let particles: Particle[] = []
        let logoTargets: Target[] = []
        let roughlyTargets: Target[] = []
        let headingTargets: Target[] = []
        let running = false
        let rafId = 0
        let clock = 0
        let lastTime = 0
        let progress = 0
        // Seconds parked at the top (drives the idle logo<->swarm<->"Roughly" cycle);
        // resets whenever the reader scrolls so returning to the top always starts on
        // the logo. `burstHalf` latches the one outward impulse fired per half-cycle.
        let cycleClock = 0
        let burstHalf = -1
        let centroidX = 0
        let centroidY = 0
        const mouse = { x: -9999, y: -9999, active: false }

        const logoImg = new Image()
        const logoReady = (async () => {
          logoImg.src = '/logo.svg'
          try {
            await logoImg.decode()
          } catch {
            await new Promise<void>((resolve) => {
              logoImg.onload = () => resolve()
              logoImg.onerror = () => resolve()
            })
          }
        })()

        function particleCount() {
          return cssW < 720 ? 2900 : cssW < 1100 ? 4600 : 6200
        }
        function sampleStride() {
          return cssW < 720 ? 4 : 3
        }
        function clamp01(t: number) {
          return t < 0 ? 0 : t > 1 ? 1 : t
        }
        function smooth01(t: number) {
          return t * t * (3 - 2 * t)
        }

        function hash(ix: number, iy: number) {
          const n = Math.sin(ix * 127.1 + iy * 311.7) * 43758.5453
          return n - Math.floor(n)
        }
        function valueNoise(x: number, y: number) {
          const ix = Math.floor(x)
          const iy = Math.floor(y)
          const fx = smooth01(x - ix)
          const fy = smooth01(y - iy)
          const a = hash(ix, iy)
          const b = hash(ix + 1, iy)
          const c = hash(ix, iy + 1)
          const d = hash(ix + 1, iy + 1)
          return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy
        }
        function flowAngle(x: number, y: number, t: number) {
          return valueNoise(x * 0.0016 + t * 0.025, y * 0.0016 - t * 0.012) * Math.PI * 4
        }

        // Shared alpha>128 stride sampler over an already-rendered offscreen
        // canvas. `place` maps a sampled pixel to a CSS-space target; the
        // adaptive stride lands the point count near the particle budget.
        function sampleAlpha(
          data: Uint8ClampedArray,
          w: number,
          h: number,
          ss: number,
          place: (sx: number, sy: number) => Target
        ) {
          const want = Math.round(particleCount() * 0.8)
          const baseStride = sampleStride() * ss
          const run = (st: number) => {
            const out: Target[] = []
            for (let sy = Math.floor(st / 2); sy < h; sy += st) {
              for (let sx = Math.floor(st / 2); sx < w; sx += st) {
                if (data[(sy * w + sx) * 4 + 3] > 128) out.push(place(sx, sy))
              }
            }
            return out
          }
          let pts = run(baseStride)
          if (pts.length > want * 1.15) pts = run(baseStride + 1)
          else if (pts.length < want * 0.7 && baseStride > ss) pts = run(baseStride - 1)
          return pts
        }

        // Logo target: draw /logo.svg into an offscreen canvas at SS=2 and
        // sample its alpha. Also fixes the shared centroid the whole loop reuses.
        function buildLogoTarget(): Target[] {
          const SS = 2
          const logoH = Math.min(cssH * 0.42, 320)
          const logoW = logoH * 0.75
          const left = centroidX - logoW / 2
          const top = centroidY - logoH / 2
          if (!logoImg.width || !logoImg.height) return []
          const off = document.createElement('canvas')
          off.width = Math.max(2, Math.round(logoW * SS))
          off.height = Math.max(2, Math.round(logoH * SS))
          const octx = off.getContext('2d')
          if (!octx) return []
          octx.clearRect(0, 0, off.width, off.height)
          octx.drawImage(logoImg, 0, 0, off.width, off.height)
          let data: Uint8ClampedArray
          try {
            data = octx.getImageData(0, 0, off.width, off.height).data
          } catch {
            return []
          }
          return sampleAlpha(data, off.width, off.height, SS, (sx, sy) => ({
            x: left + sx / SS + (Math.random() - 0.5) * 1.5,
            y: top + sy / SS + (Math.random() - 0.5) * 1.5,
          }))
        }

        // Headline target: render the wrapped headline (matching the <h1>'s sans
        // font and weight) into an offscreen canvas, then run the same alpha
        // sampler. Centered on the shared centroid so it lines up with the DOM copy.
        function buildTextTarget(lines: string[], widthFrac = 0.7, widthCap = 660): Target[] {
          const SS = 2
          const fontFamily = `'Geist Sans', system-ui, sans-serif`
          const probe = document.createElement('canvas').getContext('2d')
          if (!probe) return []
          const basePx = 100
          probe.font = `600 ${basePx}px ${fontFamily}`
          let maxW = 1
          for (const line of lines) maxW = Math.max(maxW, probe.measureText(line).width)
          const targetW = Math.min(cssW * widthFrac, widthCap)
          let fontPx = (basePx * targetW) / maxW
          const maxFont = Math.min(cssW * 0.086, cssH * 0.142)
          if (fontPx > maxFont) fontPx = maxFont
          if (fontPx < 12) fontPx = 12
          const leading = fontPx * 1.04
          const blockW = Math.ceil((maxW * fontPx) / basePx) + Math.ceil(fontPx)
          const blockH = Math.ceil(leading * lines.length + fontPx)
          const off = document.createElement('canvas')
          off.width = Math.max(2, Math.round(blockW * SS))
          off.height = Math.max(2, Math.round(blockH * SS))
          const octx = off.getContext('2d')
          if (!octx) return []
          octx.clearRect(0, 0, off.width, off.height)
          octx.scale(SS, SS)
          octx.fillStyle = '#fff'
          octx.font = `600 ${fontPx}px ${fontFamily}`
          octx.textBaseline = 'middle'
          octx.textAlign = 'center'
          const midX = blockW / 2
          const startY = blockH / 2 - (leading * (lines.length - 1)) / 2
          for (let i = 0; i < lines.length; i++) octx.fillText(lines[i], midX, startY + i * leading)
          let data: Uint8ClampedArray
          try {
            data = octx.getImageData(0, 0, off.width, off.height).data
          } catch {
            return []
          }
          const left = centroidX - blockW / 2
          const top = centroidY - blockH / 2
          return sampleAlpha(data, off.width, off.height, SS, (sx, sy) => ({
            x: left + sx / SS + (Math.random() - 0.5) * 0.5,
            y: top + sy / SS + (Math.random() - 0.5) * 0.5,
          }))
        }

        function spawnParticles() {
          const count = particleCount()
          particles = []
          for (let i = 0; i < count; i++) {
            // Soft radial scatter filling the hero (denser toward the centre, never a
            // hollow ring): this is both the particle's start point and the scatter
            // home it disperses back to between shapes, so the swarm spreads out as
            // individual particles rather than a blob.
            const ang = Math.random() * Math.PI * 2
            const rad = Math.sqrt(Math.random())
            const sx = cssW * (0.5 + Math.cos(ang) * rad * 0.62)
            const sy = cssH * (0.5 + Math.sin(ang) * rad * 0.56)
            particles.push({
              x: sx,
              y: sy,
              vx: 0,
              vy: 0,
              lx: 0,
              ly: 0,
              rx: 0,
              ry: 0,
              hx: 0,
              hy: 0,
              sx,
              sy,
              // ~80% of particles settle (almost) fully onto the glyph so the R
              // reads clearly at rest — a small residual keeps the strokes from
              // looking mechanically stamped; the other ~20% never join a shape and
              // keep flowing across the field so it always feels alive.
              logoness: Math.random() < 0.8 ? 0.96 + Math.random() * 0.04 : 0,
              depth: 0.35 + Math.random() * 0.65,
              seed: Math.random() * Math.PI * 2,
            })
          }
        }

        // Give every particle its logo, "Roughly", and headline points. All three
        // target sets are ordered left-to-right and paired by fractional index, so
        // particles flow horizontally between the shapes rather than crossing over
        // each other. The point counts differ from the particle count, so a few
        // points are shared — the drift hides the slight overlap.
        function pairTargets() {
          if (!logoTargets.length || !roughlyTargets.length || !headingTargets.length) return
          const byX = (a: Target, b: Target) => a.x - b.x || a.y - b.y
          const logo = logoTargets.slice().sort(byX)
          const word = roughlyTargets.slice().sort(byX)
          const head = headingTargets.slice().sort(byX)
          const total = particles.length
          for (let i = 0; i < total; i++) {
            const f = total > 1 ? i / (total - 1) : 0
            const l = logo[Math.min(logo.length - 1, Math.floor(f * logo.length))]
            const w = word[Math.min(word.length - 1, Math.floor(f * word.length))]
            const h = head[Math.min(head.length - 1, Math.floor(f * head.length))]
            const p = particles[i]
            p.lx = l.x
            p.ly = l.y
            p.rx = w.x
            p.ry = w.y
            p.hx = h.x
            p.hy = h.y
          }
        }

        function relayout() {
          dpr = Math.min(window.devicePixelRatio || 1, 2)
          const r = heroEl!.getBoundingClientRect()
          cssW = r.width
          cssH = r.height
          heroCanvas!.width = Math.floor(cssW * dpr)
          heroCanvas!.height = Math.floor(cssH * dpr)
          heroCanvas!.style.width = cssW + 'px'
          heroCanvas!.style.height = cssH + 'px'
          context.setTransform(dpr, 0, 0, dpr, 0, 0)
          // Anchor the particle headline on the invisible <h1>'s laid-out box, so
          // the particle letters land exactly where the heading would sit and the
          // subhead below flows under them without overlap. The <h1> is fully
          // transparent (a screen-reader label) but keeps its layout box.
          const headline = heroEl!.querySelector('.hero-copy h1') as HTMLElement | null
          if (headline) {
            const hr = headline.getBoundingClientRect()
            centroidX = hr.left - r.left + hr.width / 2
            centroidY = hr.top - r.top + hr.height / 2
          } else {
            centroidX = cssW / 2
            centroidY = cssH * 0.44
          }
          logoTargets = buildLogoTarget()
          // The wordmark is a single short word, so cap it narrower than the
          // two-line headline to keep its cap height in the same visual range.
          roughlyTargets = buildTextTarget(ROUGHLY_LINES, 0.34, 400)
          headingTargets = buildTextTarget(HEADING_LINES)
          spawnParticles()
          pairTargets()
        }

        // Logo-assembly amount for the load intro: 0 before it starts, eases up to 1
        // as particles fly onto the glyph, then stays 1 — the logo holds instead of
        // dispersing. The idle cycle and scroll morph take the shape from there.
        function introAmount() {
          if (clock <= INTRO_DELAY) return 0
          if (clock < INTRO_DELAY + ASSEMBLE) return smooth01((clock - INTRO_DELAY) / ASSEMBLE)
          return 1
        }

        // Idle cycle claim (1 = gathered on a shape, 0 = exploded into the streaming
        // swarm) across one half-cycle: hold, fall (burst), stream, rise (gather).
        function cycleClaim(phase: number) {
          if (phase < CYCLE_HOLD) return 1
          if (phase < CYCLE_HOLD + CYCLE_FALL) return 1 - smooth01((phase - CYCLE_HOLD) / CYCLE_FALL)
          if (phase < CYCLE_HOLD + CYCLE_FALL + CYCLE_STREAM) return 0
          return smooth01((phase - (CYCLE_HOLD + CYCLE_FALL + CYCLE_STREAM)) / CYCLE_RISE)
        }
        // Which shape (0 = logo, 1 = "Roughly") the half-cycle rests on: it holds the
        // shape it started from, then gathers onto the other one. The swap happens
        // mid-stream, while nothing is gathered, so there is no visible jump.
        function cycleShapeSel(halfIndex: number, phase: number) {
          const fromShape = halfIndex % 2 === 0 ? 0 : 1
          const swapAt = CYCLE_HOLD + CYCLE_FALL + CYCLE_STREAM / 2
          return phase < swapAt ? fromShape : 1 - fromShape
        }

        // One frame. After the fly-in the shape particles stay assembled: parked at
        // the top they drift between the logo and the "Roughly" wordmark on the idle
        // cycle, and scrolling slides that shape into the headline (scrolling back up
        // returns it to the logo). The ~20% pure drifters never join a shape — they
        // flow across the field on the flow current and wrap at the edges, keeping the
        // hero alive. Rather than clearing, the frame is faded toward black so moving
        // particles leave soft light trails; the trail vanishes to a full clear as the
        // scroll text locks in so the letters read crisp.
        function render(now: number) {
          // The morph completes well before the end of the scroll track so the text
          // resolves quickly; the remaining scroll just holds it.
          const morph = smooth01(clamp01(progress / 0.72))
          const intro = introAmount()
          // Where the idle cycle is right now: which half (logo->swarm->"Roughly" or
          // back), how gathered onto a shape (claim), and which shape it rests on.
          const halfIndex = Math.floor(cycleClock / CYCLE_HALF)
          const phase = cycleClock - halfIndex * CYCLE_HALF
          const claim = cycleClaim(phase)
          const shapeSel = cycleShapeSel(halfIndex, phase)
          // Fire one outward impulse the instant the shape releases (start of FALL),
          // so it bursts into radial streaks rather than just fading into the swarm.
          if (burstHalf !== halfIndex && phase >= CYCLE_HOLD && phase < CYCLE_HOLD + 0.4) {
            burstHalf = halfIndex
            for (const particle of particles) {
              if (particle.logoness <= 0) continue
              particle.vx += (particle.x - centroidX) * 0.012 + (Math.random() - 0.5) * 0.6
              particle.vy += (particle.y - centroidY) * 0.012 + (Math.random() - 0.5) * 0.6
            }
          }
          // How strongly the scroll text is claimed — ramps in fast so the headline
          // reads crisp. Drives the trail crispening below.
          const textForm = smooth01(clamp01(morph / 0.32))
          context.globalAlpha = 1
          // Fade toward black for motion trails; the trail vanishes to a full clear
          // as the scroll text locks in so the letters read crisp, not smeared.
          context.fillStyle = `rgba(0,0,0,${0.13 + 0.86 * textForm})`
          context.fillRect(0, 0, cssW, cssH)
          context.fillStyle = '#fff'
          // Looseness peaks mid-transition so the field breathes as it reshapes.
          const settle = Math.max(intro < 1 ? Math.sin(Math.PI * intro) : 0, Math.sin(Math.PI * morph))
          for (let i = 0; i < particles.length; i++) {
            const p = particles[i]
            // `shaped` = does this dot take part in shapes (1 after the intro), vs a
            // pure drifter (0). `form` = how gathered onto a shape it is right now
            // (drops to 0 as the cycle scatters it into the swarm).
            const shaped = p.logoness * intro
            const form = shaped * claim
            let pullX = 0
            let pullY = 0
            if (shaped > 0.0001) {
              // The shape it gathers onto (logo or "Roughly" by the cycle), slid
              // across to the headline as you scroll.
              const shapeX = p.lx + (p.rx - p.lx) * shapeSel
              const shapeY = p.ly + (p.ry - p.ly) * shapeSel
              const gx = shapeX + (p.hx - shapeX) * morph
              const gy = shapeY + (p.hy - shapeY) * morph
              // Target blends the spread-out scatter home (claim 0 = individual
              // particles) with the gathered shape (claim 1). Gentle spring while
              // scattered, firm once gathered; the intro factor eases the first
              // assembly so the logo glides in rather than snapping.
              const tx = p.sx + (gx - p.sx) * claim
              const ty = p.sy + (gy - p.sy) * claim
              const springK = (0.045 + 0.07 * claim) * intro
              pullX = (tx - p.x) * springK
              pullY = (ty - p.y) * springK
            }
            // Flow current: the pure drifters always flow; a shape dot flows while
            // scattered into the swarm (claim -> 0) and holds steady once gathered.
            const flow = p.logoness > 0 ? (1 - claim) * 0.05 : 0.06
            const angle = flowAngle(p.x, p.y, clock) + p.seed
            p.vx += pullX + Math.cos(angle) * flow
            p.vy += pullY + Math.sin(angle) * flow
            if (mouse.active) {
              const mdx = p.x - mouse.x
              const mdy = p.y - mouse.y
              const d2 = mdx * mdx + mdy * mdy
              if (d2 < 12000 && d2 > 0.01) {
                const push = (1 - d2 / 12000) * 1.7
                const inv = 1 / Math.sqrt(d2)
                p.vx += mdx * inv * push
                p.vy += mdy * inv * push
              }
            }
            // Drifters keep their momentum so the flow streams; assembled shape dots
            // damp harder so the shape settles crisp.
            const damp = 0.92 - 0.05 * form
            p.vx *= damp
            p.vy *= damp
            p.x += p.vx
            p.y += p.vy
            // Only pure drifters wrap the field; shape dots settle at their scatter
            // home (well inside the field) when released, so they never reach a wrap.
            if (p.logoness <= 0) {
              if (p.x < -4) p.x += cssW + 8
              else if (p.x > cssW + 4) p.x -= cssW + 8
              if (p.y < -4) p.y += cssH + 8
              else if (p.y > cssH + 4) p.y -= cssH + 8
            }
            // Fine sharp dots: 1-2px, brighter while sitting on a shape and dim while
            // flowing so the streaming field stays quiet behind the letters.
            const size = p.depth > 0.62 ? 2 : 1
            const base = p.logoness > 0 ? 0.11 + p.depth * 0.16 : 0.1 + p.depth * 0.14
            let alpha = base + form * (0.44 + p.depth * 0.34)
            alpha *= 1 - settle * 0.22
            context.globalAlpha = alpha < 0 ? 0 : alpha > 1 ? 1 : alpha
            context.fillRect(p.x, p.y, size, size)
          }
          context.globalAlpha = 1
        }

        // Scroll only updates progress and the nav/copy/hint reveal. The rAF loop
        // owns rendering so the spring integration advances on a real timestep.
        const stage = document.getElementById('hero')
        const nav = document.getElementById('nav')
        const copy = heroEl!.querySelector('.hero-copy') as HTMLElement | null
        const hint = heroEl!.querySelector('.scroll-hint') as HTMLElement | null

        function syncScroll() {
          const vh = window.innerHeight || 1
          const y = window.scrollY || window.pageYOffset || 0
          const scrollable = Math.max(1, (stage ? stage.offsetHeight : vh) - vh)
          progress = clamp01(y / scrollable)
          if (nav) nav.style.setProperty('--reveal', String(clamp01((y - vh * 0.12) / (vh * 0.16))))
          // The subhead and buttons fade in right after the particles resolve into
          // the headline (which completes at progress 0.72). The headline itself is
          // never shown as DOM text — the particles are the heading.
          const copyP = smooth01(clamp01((progress - 0.6) / 0.22))
          if (copy) copy.style.setProperty('--copy-op', String(copyP))
          if (hint) hint.style.setProperty('--hint-op', String(clamp01(1 - y / (vh * 0.14))))
        }

        function loop(now: number) {
          if (!running) return
          if (lastTime === 0) lastTime = now
          let dt = (now - lastTime) / 1000
          lastTime = now
          if (dt > 0.05) dt = 0.05
          clock += dt
          // Advance the idle logo<->swarm<->"Roughly" cycle only while parked at the
          // very top; any scroll resets it (and re-arms the burst) so returning to the
          // top restarts on the logo.
          if (progress < 0.02) {
            cycleClock += dt
          } else {
            cycleClock = 0
            burstHalf = -1
          }
          render(now)
          rafId = requestAnimationFrame(loop)
        }
        function start() {
          if (running) return
          running = true
          lastTime = 0
          rafId = requestAnimationFrame(loop)
        }
        function stop() {
          running = false
          if (rafId) cancelAnimationFrame(rafId)
          rafId = 0
        }

        let resizeTimer = 0
        window.addEventListener('resize', () => {
          window.clearTimeout(resizeTimer)
          resizeTimer = window.setTimeout(() => {
            relayout()
            syncScroll()
          }, 150)
        })
        window.addEventListener('scroll', syncScroll, { passive: true })
        window.addEventListener('mousemove', (e) => {
          const r = heroCanvas!.getBoundingClientRect()
          mouse.x = e.clientX - r.left
          mouse.y = e.clientY - r.top
          mouse.active = mouse.y >= 0 && mouse.y <= cssH
        })
        window.addEventListener('mouseleave', () => (mouse.active = false))

        const begin = () => {
          relayout()
          syncScroll()
          if (reduceMotion) {
            // No animation: show the crisp DOM headline and copy. The particles rest
            // as a faint static scatter behind the text (intro never runs, so nothing
            // assembles) so nothing competes with the legible <h1>.
            progress = 0
            clock = 0
            render(0)
            if (nav) nav.style.setProperty('--reveal', '1')
            if (copy) copy.style.setProperty('--copy-op', '1')
            return
          }
          if (typeof IntersectionObserver === 'undefined') {
            start()
            return
          }
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) start()
                else stop()
              }
            },
            { threshold: 0 }
          )
          observer.observe(heroEl!)
        }

        const fontsReady =
          document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()
        Promise.all([fontsReady, logoReady]).then(begin).catch(begin)
      }

      // ======================================================================
      // Reusable accessible tabs (roving tabindex, arrows, focus-follows).
      // ======================================================================
      function setupTabs(root: HTMLElement) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const tablist = root.querySelector('[role="tablist"]')
        const tabs = Array.from(root.querySelectorAll('[role="tab"]')) as HTMLElement[]
        const panels = tabs.map(
          (t) => root.querySelector('#' + t.getAttribute('aria-controls')) as HTMLElement | null
        )
        const isMorph = root.hasAttribute('data-morph-section')
        let visible = false
        let loopTimer = 0
        const timers = new WeakMap<HTMLElement, number[]>()
        const intervals = new WeakMap<HTMLElement, number[]>()

        if (reduce && isMorph) root.classList.add('reduced')
        if (isMorph) {
          for (const p of panels) if (p) p.classList.add('is-formatted', 'is-settled')
        }
        if (reduce) applyReducedEndStates()

        function selectedIndex() {
          return tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')
        }

        function activate(index: number, focusTab: boolean) {
          tabs.forEach((t, i) => {
            const sel = i === index
            t.setAttribute('aria-selected', sel ? 'true' : 'false')
            t.tabIndex = sel ? 0 : -1
            const panel = panels[i]
            if (panel) {
              if (sel) panel.hidden = false
              else {
                panel.hidden = true
                stopSignature(panel)
              }
            }
          })
          if (focusTab) tabs[index].focus()
          const panel = panels[index]
          if (panel && visible) triggerSignature(panel)
        }

        function triggerSignature(panel: HTMLElement) {
          if (reduce) return
          if (isMorph) {
            playMorph(panel)
            return
          }
          panel.classList.remove('play')
          void panel.offsetWidth
          panel.classList.add('play')
          runJsSignature(panel)
        }
        function stopSignature(panel: HTMLElement) {
          panel.classList.remove('play')
          if (isMorph) clearMorphTimers(panel)
          cancelJs(panel)
        }

        function clearMorphTimers(panel: HTMLElement) {
          const ts = timers.get(panel)
          if (ts) for (const id of ts) clearTimeout(id)
          timers.set(panel, [])
        }
        function playMorph(panel: HTMLElement) {
          if (reduce) return
          clearMorphTimers(panel)
          panel.classList.add('no-anim')
          panel.classList.remove('is-formatted', 'is-settled')
          void panel.offsetWidth
          panel.classList.remove('no-anim')
          const t1 = window.setTimeout(() => panel.classList.add('is-formatted'), 250)
          const t2 = window.setTimeout(() => panel.classList.add('is-settled'), 250 + 700 + 350)
          timers.set(panel, [t1, t2])
        }

        function runJsSignature(panel: HTMLElement) {
          cancelJs(panel)
          if (panel.id === 'panel-refs') {
            const el = panel.querySelector('.refs-count')
            if (!el) return
            let n = 0
            el.textContent = '0'
            const id = window.setInterval(() => {
              n++
              el.textContent = String(n)
              if (n >= 3) {
                window.clearInterval(id)
              }
            }, 130)
            intervals.set(panel, [id])
          } else if (panel.id === 'panel-rename') {
            const box = panel.querySelector('.rename-text') as HTMLElement | null
            const ghosts = Array.from(panel.querySelectorAll('.ghost-tok')) as HTMLElement[]
            if (!box) return
            box.textContent = 'weight'
            ghosts.forEach((g) => {
              g.textContent = 'weight'
              g.classList.remove('flip')
            })
            const target = 'coefficient'
            let current = 'weight'
            let phase = 0
            const id = window.setInterval(() => {
              if (phase === 0) {
                current = current.slice(0, -1)
                box.textContent = current
                if (current.length === 0) phase = 1
              } else {
                current = target.slice(0, current.length + 1)
                box.textContent = current
                if (current === target) {
                  window.clearInterval(id)
                  ghosts.forEach((g) => {
                    g.textContent = 'coefficient'
                    g.classList.add('flip')
                  })
                }
              }
            }, 42)
            intervals.set(panel, [id])
          }
        }
        function cancelJs(panel: HTMLElement) {
          const ids = intervals.get(panel)
          if (ids) for (const id of ids) clearInterval(id)
          intervals.set(panel, [])
        }

        function applyReducedEndStates() {
          const rename = root.querySelector('#panel-rename')
          if (rename) {
            const box = rename.querySelector('.rename-text')
            if (box) box.textContent = 'coefficient'
            rename.querySelectorAll('.ghost-tok').forEach((g) => (g.textContent = 'coefficient'))
            rename.classList.add('renamed')
          }
        }

        if (tablist) {
          tablist.addEventListener('keydown', (e) => {
            const ev = e as KeyboardEvent
            const cur = selectedIndex()
            const n = tabs.length
            let next = -1
            if (ev.key === 'ArrowDown' || ev.key === 'ArrowRight') next = (cur + 1) % n
            else if (ev.key === 'ArrowUp' || ev.key === 'ArrowLeft') next = (cur - 1 + n) % n
            else if (ev.key === 'Home') next = 0
            else if (ev.key === 'End') next = n - 1
            else return
            ev.preventDefault()
            activate(next, true)
          })
        }
        tabs.forEach((t, i) => t.addEventListener('click', () => activate(i, true)))

        function startLoop() {
          if (!isMorph || reduce) return
          stopLoop()
          loopTimer = window.setInterval(() => {
            if (!visible) return
            const idx = selectedIndex()
            const panel = panels[idx >= 0 ? idx : 0]
            if (panel) playMorph(panel)
          }, 4500)
        }
        function stopLoop() {
          if (loopTimer) {
            clearInterval(loopTimer)
            loopTimer = 0
          }
        }

        if (typeof IntersectionObserver !== 'undefined') {
          const io = new IntersectionObserver(
            (entries) => {
              for (const en of entries) {
                visible = en.intersectionRatio >= 0.35
                if (visible) {
                  const idx = selectedIndex()
                  const panel = panels[idx >= 0 ? idx : 0]
                  if (panel) triggerSignature(panel)
                  startLoop()
                } else {
                  stopLoop()
                  for (const p of panels) if (p) stopSignature(p)
                }
              }
            },
            { threshold: [0, 0.35, 0.6] }
          )
          io.observe(root)
        } else {
          visible = true
          const idx = selectedIndex()
          const panel = panels[idx >= 0 ? idx : 0]
          if (panel) triggerSignature(panel)
        }
      }

      // ======================================================================
      // Closer: dot-matrix halftone field with a sweeping wavefront.
      // Self-contained and namespaced; pauses offscreen; static halftone
      // fallback under reduced motion. Shares no globals with the hero field.
      // ======================================================================
      function initCloserMatrix() {
        const matrixCanvas = document.getElementById('closer-canvas') as HTMLCanvasElement | null
        const matrixSection = document.getElementById('get-started') as HTMLElement | null
        if (!matrixCanvas || !matrixSection) return
        const ctx = matrixCanvas.getContext('2d', { alpha: false })
        if (!ctx) return
        const reduceMatrix = window.matchMedia('(prefers-reduced-motion: reduce)')
        const finePointer = window.matchMedia('(pointer: fine)')

        const BG = '#0a0a0a'
        const TRAIL = 'rgba(10,10,10,0.14)'
        const RAMP = ' ·∶∷▪█'
        const RAMP_CODES = RAMP.split('').map((c) => c.charCodeAt(0))
        const TOKENS = ['integer', 'double', 'character', 'logical', '<T: numeric>', 'fn(..)->']
        const DIR_X = 0.7771
        const DIR_Y = 0.6294
        const PERIOD = 13.0
        const LEVELS = 18
        const WHITE = LEVELS
        const probeR = 130
        const BLOCK = RAMP.charCodeAt(RAMP.length - 1)

        const logoImg = new Image()
        const logoReady = (async () => {
          logoImg.src = '/logo.svg'
          try {
            await logoImg.decode()
          } catch {
            await new Promise<void>((resolve) => {
              logoImg.onload = () => resolve()
              logoImg.onerror = () => resolve()
            })
          }
        })()

        let dpr = 1
        let W = 0
        let H = 0
        let cellW = 11
        let cellH = 18
        let cols = 0
        let rows = 0
        let maxProj = 0
        let bandPx = 0
        let rowStreams: string[] = []
        let styles: string[] = []
        let bx: Float32Array[] = []
        let by: Float32Array[] = []
        let bc: Uint16Array[] = []
        let bn: number[] = []
        let mouseX = -1e9
        let mouseY = -1e9
        let hasMouse = false
        let logoHit: Uint8Array | null = null
        let showFullLogo = false

        function buildStyles() {
          styles = []
          for (let i = 0; i < LEVELS; i++) {
            const a = 0.1 + (i / (LEVELS - 1)) * 0.3
            styles.push('rgba(238,238,238,' + a.toFixed(3) + ')')
          }
        }

        function hash3(x: number, y: number, z: number) {
          let n = (x | 0) * 374761393 + (y | 0) * 668265263 + (z | 0) * 1274126177
          n = (n ^ (n >> 13)) >>> 0
          n = Math.imul(n, 1274126177) >>> 0
          return (n & 0xffffff) / 0x1000000
        }
        function smooth(t: number) {
          return t * t * (3 - 2 * t)
        }
        function vnoise(x: number, y: number, z: number) {
          const xi = Math.floor(x)
          const yi = Math.floor(y)
          const zi = Math.floor(z)
          const xf = x - xi
          const yf = y - yi
          const zf = z - zi
          const u = smooth(xf)
          const v = smooth(yf)
          const w = smooth(zf)
          const c000 = hash3(xi, yi, zi)
          const c100 = hash3(xi + 1, yi, zi)
          const c010 = hash3(xi, yi + 1, zi)
          const c110 = hash3(xi + 1, yi + 1, zi)
          const c001 = hash3(xi, yi, zi + 1)
          const c101 = hash3(xi + 1, yi, zi + 1)
          const c011 = hash3(xi, yi + 1, zi + 1)
          const c111 = hash3(xi + 1, yi + 1, zi + 1)
          const x00 = c000 + (c100 - c000) * u
          const x10 = c010 + (c110 - c010) * u
          const x01 = c001 + (c101 - c001) * u
          const x11 = c011 + (c111 - c011) * u
          const y0 = x00 + (x10 - x00) * v
          const y1 = x01 + (x11 - x01) * v
          return y0 + (y1 - y0) * w
        }
        function fbm(x: number, y: number, z: number) {
          let f = 0
          let amp = 0.5
          let freq = 1
          for (let o = 0; o < 3; o++) {
            f += amp * vnoise(x * freq, y * freq, z * freq)
            freq *= 2.0
            amp *= 0.5
          }
          return f
        }
        function tokenChar(col: number, row: number) {
          const s = rowStreams[row]
          if (!s) return 0
          return s.charCodeAt(col % s.length)
        }

        function resize() {
          dpr = Math.min(window.devicePixelRatio || 1, 2)
          const rect = matrixSection!.getBoundingClientRect()
          W = Math.max(2, Math.round(rect.width))
          H = Math.max(2, Math.round(rect.height))
          const small = W < 720
          cellW = small ? 13 : 11
          cellH = small ? 21 : 18
          matrixCanvas!.width = Math.floor(W * dpr)
          matrixCanvas!.height = Math.floor(H * dpr)
          matrixCanvas!.style.width = W + 'px'
          matrixCanvas!.style.height = H + 'px'
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
          ctx.textBaseline = 'top'
          ctx.textAlign = 'left'
          ctx.font = Math.round(cellH * 0.82) + "px 'Geist Mono', monospace"
          cols = Math.ceil(W / cellW) + 1
          rows = Math.ceil(H / cellH) + 1
          maxProj = W * DIR_X + H * DIR_Y
          bandPx = cellW * 2.6

          rowStreams = new Array(rows)
          for (let r = 0; r < rows; r++) {
            const seed = Math.floor(hash3(r * 7 + 1, 13, 29) * 1000)
            const parts: string[] = []
            for (let k = 0; k < 14; k++) parts.push(TOKENS[(seed + k * 5) % TOKENS.length])
            rowStreams[r] = parts.join('  ') + '  '
          }

          const maxCells = cols * rows
          bx = []
          by = []
          bc = []
          bn = []
          for (let i = 0; i <= LEVELS; i++) {
            bx.push(new Float32Array(maxCells))
            by.push(new Float32Array(maxCells))
            bc.push(new Uint16Array(maxCells))
            bn.push(0)
          }
          ctx.fillStyle = BG
          ctx.fillRect(0, 0, W, H)
          buildLogoMask()
        }

        function buildLogoMask() {
          logoHit = new Uint8Array(cols * rows)
          if (!logoImg.naturalWidth || !logoImg.naturalHeight) return
          const logoH = Math.min(H * 0.62, 440)
          const logoW = logoH * 0.75
          const left = (W - logoW) / 2
          const top = (H - logoH) / 2
          const ow = Math.max(2, Math.round(logoW))
          const oh = Math.max(2, Math.round(logoH))
          const off = document.createElement('canvas')
          off.width = ow
          off.height = oh
          const octx = off.getContext('2d')
          if (!octx) return
          octx.clearRect(0, 0, ow, oh)
          octx.drawImage(logoImg, 0, 0, ow, oh)
          let data: Uint8ClampedArray
          try {
            data = octx.getImageData(0, 0, ow, oh).data
          } catch {
            logoHit = null
            return
          }
          for (let r = 0; r < rows; r++) {
            const cy = r * cellH + cellH * 0.5
            const ly = cy - top
            if (ly < 0 || ly >= logoH) continue
            let sy = Math.floor((ly / logoH) * oh)
            if (sy >= oh) sy = oh - 1
            for (let c = 0; c < cols; c++) {
              const cx = c * cellW + cellW * 0.5
              const lx = cx - left
              if (lx < 0 || lx >= logoW) continue
              let sx = Math.floor((lx / logoW) * ow)
              if (sx >= ow) sx = ow - 1
              if (data[(sy * ow + sx) * 4 + 3] > 128) logoHit[r * cols + c] = 1
            }
          }
        }

        function render(time: number) {
          ctx.fillStyle = TRAIL
          ctx.fillRect(0, 0, W, H)

          for (let i = 0; i <= LEVELS; i++) bn[i] = 0

          const phase = (time / PERIOD) % 1
          const frontPos = phase * (maxProj + bandPx * 4) - bandPx * 2
          const tz = time * 0.15
          const revealIn = bandPx * 2.2
          const revealHold = bandPx * 2.4
          const revealOut = bandPx * 6.5

          for (let r = 0; r < rows; r++) {
            const py = r * cellH
            const cy = py + cellH * 0.5
            for (let c = 0; c < cols; c++) {
              const px = c * cellW
              const cx = px + cellW * 0.5

              let b = fbm(px * 0.006 + 11, py * 0.006 + 7, tz)
              b = (b - 0.25) / 0.5
              if (b < 0) b = 0
              else if (b > 1) b = 1

              const proj = cx * DIR_X + cy * DIR_Y
              const w = proj - frontPos

              if (logoHit && logoHit[r * cols + c]) {
                let reveal: number
                if (showFullLogo) {
                  reveal = 1
                } else {
                  const dpass = frontPos - proj
                  let tin = (dpass + revealIn) / revealIn
                  if (tin < 0) tin = 0
                  else if (tin > 1) tin = 1
                  let tout = 1 - (dpass - revealHold) / revealOut
                  if (tout < 0) tout = 0
                  else if (tout > 1) tout = 1
                  reveal = tin < tout ? tin : tout
                }
                if (reveal > 0.5) {
                  const idx = bn[WHITE]++
                  bx[WHITE][idx] = px
                  by[WHITE][idx] = py
                  bc[WHITE][idx] = BLOCK
                  continue
                } else if (reveal > 0.14) {
                  const lvl = LEVELS - 1
                  const idx = bn[lvl]++
                  bx[lvl][idx] = px
                  by[lvl][idx] = py
                  bc[lvl][idx] = BLOCK
                  continue
                }
              }

              let resolved = w < bandPx && w > -bandPx
              if (!resolved && hasMouse) {
                const dx = cx - mouseX
                const dy = cy - mouseY
                if (dx * dx + dy * dy < probeR * probeR && b > 0.32) resolved = true
              }

              if (resolved) {
                const code = tokenChar(c, r)
                if (code === 32 || code === 0) continue
                const idx = bn[WHITE]++
                bx[WHITE][idx] = px
                by[WHITE][idx] = py
                bc[WHITE][idx] = code
                continue
              }

              if (w <= -bandPx) b = Math.min(1, b + 0.08)

              const gi = Math.min(RAMP_CODES.length - 1, Math.floor(b * RAMP_CODES.length))
              const code = RAMP_CODES[gi]
              if (code === 32) continue

              let lvl = Math.round(b * (LEVELS - 1))
              if (lvl < 0) lvl = 0
              else if (lvl >= LEVELS) lvl = LEVELS - 1
              const idx = bn[lvl]++
              bx[lvl][idx] = px
              by[lvl][idx] = py
              bc[lvl][idx] = code
            }
          }

          for (let lvl = 0; lvl < LEVELS; lvl++) {
            const n = bn[lvl]
            if (!n) continue
            ctx.fillStyle = styles[lvl]
            const xs = bx[lvl]
            const ys = by[lvl]
            const cs = bc[lvl]
            for (let i = 0; i < n; i++) ctx.fillText(String.fromCharCode(cs[i]), xs[i], ys[i])
          }
          const wn = bn[WHITE]
          if (wn) {
            ctx.fillStyle = '#ffffff'
            const xs = bx[WHITE]
            const ys = by[WHITE]
            const cs = bc[WHITE]
            for (let i = 0; i < wn; i++) ctx.fillText(String.fromCharCode(cs[i]), xs[i], ys[i])
          }
        }

        let running = false
        let startTime = 0
        let rafId = 0
        let inView = false

        function loop(now: number) {
          if (!running) return
          if (!startTime) startTime = now
          render((now - startTime) / 1000)
          rafId = requestAnimationFrame(loop)
        }
        function start() {
          if (running) return
          running = true
          startTime = 0
          rafId = requestAnimationFrame(loop)
        }
        function stop() {
          running = false
          if (rafId) cancelAnimationFrame(rafId)
          rafId = 0
        }
        function staticFrame() {
          ctx.fillStyle = BG
          ctx.fillRect(0, 0, W, H)
          hasMouse = false
          showFullLogo = true
          render(PERIOD * 0.5)
          showFullLogo = false
        }

        function onMove(e: MouseEvent) {
          const rect = matrixSection!.getBoundingClientRect()
          const x = e.clientX - rect.left
          const y = e.clientY - rect.top
          if (x >= 0 && x <= W && y >= 0 && y <= H) {
            mouseX = x
            mouseY = y
            hasMouse = true
          } else {
            hasMouse = false
          }
        }
        function onLeave() {
          hasMouse = false
        }

        function setup() {
          buildStyles()
          resize()

          if (reduceMatrix.matches) {
            staticFrame()
          } else {
            if (finePointer.matches) {
              window.addEventListener('mousemove', onMove, { passive: true })
              window.addEventListener('mouseout', onLeave, { passive: true })
            }
            if (typeof IntersectionObserver !== 'undefined') {
              const observer = new IntersectionObserver(
                (entries) => {
                  for (const entry of entries) {
                    inView = entry.isIntersecting
                    if (inView) start()
                    else stop()
                  }
                },
                { threshold: 0 }
              )
              observer.observe(matrixSection!)
            } else {
              inView = true
              start()
            }
          }

          let resizeTimer = 0
          window.addEventListener('resize', () => {
            window.clearTimeout(resizeTimer)
            resizeTimer = window.setTimeout(() => {
              stop()
              resize()
              if (reduceMatrix.matches) staticFrame()
              else if (inView) start()
            }, 150)
          })

          reduceMatrix.addEventListener('change', () => {
            stop()
            if (reduceMatrix.matches) staticFrame()
            else if (inView) start()
          })
        }

        const fontsReady =
          document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()
        Promise.all([fontsReady, logoReady]).then(setup).catch(setup)
      }

      function initNav() {
        const nav = document.getElementById('nav')
        if (!nav) return
        const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8)
        onScroll()
        window.addEventListener('scroll', onScroll, { passive: true })
      }

      // ======================================================================
      // Hero reveal: the first viewport shows only the pinned particle field;
      // scrolling through the tall stage slides the header in and parallaxes
      // the hero copy into place. Drives transform/opacity via CSS variables
      // from a single rAF-coalesced scroll handler — no layout reads per frame
      // beyond scrollY / innerHeight, no layout thrash.
      // ======================================================================
      initHero()
      document
        .querySelectorAll('[data-tabs]')
        .forEach((el) => setupTabs(el as HTMLElement))
      initCloserMatrix()
      initNav()
    </script>

