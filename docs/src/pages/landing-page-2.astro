---
import '@fontsource/geist-sans/400.css'
import '@fontsource/geist-sans/500.css'
import '@fontsource/geist-sans/600.css'
import '@fontsource/geist-mono/400.css'
import '@fontsource/geist-mono/500.css'

const navLinks = [
  { label: 'Docs', href: '/getting-started' },
  { label: 'Type Checker', href: '/type-checker' },
  { label: 'Formatter', href: '/formatter' },
  { label: 'Linter', href: '/linter' },
  { label: 'Config', href: '/configuration' },
  { label: 'GitHub', href: 'https://github.com/felix-andreas/roughly' },
]

const footerLinks = [
  { label: 'Type Checker', href: '/type-checker' },
  { label: 'Language Server', href: '/language-server' },
  { label: 'Linter', href: '/linter' },
  { label: 'Formatter', href: '/formatter' },
  { label: 'Config', href: '/configuration' },
  { label: 'Getting started', href: '/getting-started' },
]

const lsTabs = [
  { key: 'completion', label: 'Completion' },
  { key: 'hover', label: 'Hover' },
  { key: 'gotodef', label: 'Go-to-definition' },
  { key: 'references', label: 'Find references' },
  { key: 'rename', label: 'Rename' },
  { key: 'inlay', label: 'Inlay hints' },
]

const caTabs = [
  { key: 'typing', label: 'Type checking' },
  { key: 'inference', label: 'Inference' },
  { key: 'linting', label: 'Linting' },
]

const fmtTabs = [
  { key: 'spacing', label: 'Spacing & operators' },
  { key: 'indent', label: 'Indentation' },
  { key: 'strings', label: 'Strings & quotes' },
]

const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Roughly — modern developer tooling for R</title>
    <meta
      name="description"
      content="Roughly is a fast, modern toolchain for R — a language server, a code analyzer, and a formatter in one tool, written in Rust. Scales past 300k lines."
    />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <canvas id="field" aria-hidden="true"></canvas>
    <div class="field-vignette" aria-hidden="true"></div>

    <header class="nav" id="nav">
      <div class="nav-inner">
        <a class="brand" href="/getting-started" aria-label="Roughly home">
          <img class="logo" src="/logo.svg" width="24" height="24" alt="" />
          <span class="wordmark">Roughly</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {
            navLinks.map((l) => (
              <a
                href={l.href}
                target={l.label === 'GitHub' ? '_blank' : undefined}
                rel={l.label === 'GitHub' ? 'noreferrer' : undefined}
              >
                {l.label}
              </a>
            ))
          }
        </nav>
        <a class="btn solid nav-pill" href="/getting-started">Get started</a>
      </div>
    </header>

    <main>
      <!-- ============================ HERO ============================ -->
      <section class="hero">
        <div class="card hero-card">
          <p class="eyebrow">Modern R tooling, written in Rust</p>
          <h1>Modern developer tooling for R.</h1>
          <p class="subhead">
            A language server, a code analyzer, and a formatter in one fast
            tool — built in Rust, scaling past 300k lines. R has world-class
            statistics and dated developer tooling. Roughly is the modern
            toolchain.
          </p>

          <div class="cta-row">
            <a class="btn solid lg" href="/getting-started">Get started</a>
            <a
              class="btn vscode lg"
              href="https://marketplace.visualstudio.com/items?itemName=felix-andreas.roughly"
              target="_blank"
              rel="noopener"
            >
              <svg class="brand-logo" width="18" height="18" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <mask id="vscHeroMask" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M70.9119 99.3171C72.4869 99.9307 74.2828 99.8914 75.8725 99.1264L96.4604 89.2197C98.6242 88.1787 100 85.9892 100 83.5872V16.4133C100 14.0113 98.6243 11.8218 96.4605 10.7808L75.8725 0.873756C73.7862 -0.130129 71.3446 0.11576 69.5135 1.44695C69.252 1.63711 69.0028 1.84943 68.769 2.08341L29.3551 38.0387L12.1872 25.0054C10.589 23.7919 8.35363 23.8919 6.86933 25.2444L1.36303 30.2592C-0.453713 31.9133 -0.455738 34.7779 1.35853 36.4347L16.2471 50.0001L1.35853 63.5655C-0.455738 65.2223 -0.453713 68.0869 1.36303 69.7411L6.86933 74.7558C8.35363 76.1084 10.589 76.2083 12.1872 74.9948L29.3551 61.9615L68.769 97.9168C69.3897 98.5345 70.1186 98.9942 70.9119 99.3171ZM75.0152 27.2989L45.1091 50.0001L75.0152 72.7012V27.2989Z" fill="white"/>
                </mask>
                <g mask="url(#vscHeroMask)"><rect width="100" height="100" fill="#0098FF"/></g>
              </svg>
              <span>Install in VS Code</span>
            </a>
            <span class="btn zed lg" aria-disabled="true">
              <span>Zed</span>
              <span class="soon-pill">soon</span>
            </span>
          </div>
        </div>
      </section>

      <!-- ====================== CAPABILITIES ======================= -->
      <section class="band">
        <div class="band-inner">
          <div class="section-head">
            <p class="eyebrow">three tools, one binary</p>
            <h2>Three tools, one binary.</h2>
            <p class="lede">
              Editor smarts, problem-catching analysis, and one consistent
              style — covered by a single tool. Each capability owns its color,
              and that color threads its whole section below.
            </p>
          </div>

          <div class="cap-grid">
            <article class="cap-card" style="--accent: var(--cap-cyan)">
              <span class="cap-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5v14"/>
                  <path d="M9.5 5h5"/>
                  <path d="M9.5 19h5"/>
                  <path class="arc arc-1" d="M15.5 7.5a4 4 0 0 1 0 5"/>
                  <path class="arc arc-2" d="M17.5 6a7 7 0 0 1 0 8"/>
                </svg>
              </span>
              <span class="cap-index">01</span>
              <h3>Language server</h3>
              <p class="cap-blurb">
                Completion, hover, go-to-definition, references, rename, and
                inlay hints — a VS Code extension that speaks LSP for any editor.
              </p>
              <a class="doclink" href="/language-server">Language server docs <span aria-hidden="true">→</span></a>
            </article>

            <article class="cap-card" style="--accent: var(--cap-violet)">
              <span class="cap-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <circle class="lens" cx="11" cy="11" r="6.5"/>
                  <path d="M16 16l4 4"/>
                  <circle cx="9" cy="11" r="1.1" fill="currentColor" stroke="none"/>
                  <circle cx="13" cy="9.5" r="1.1" fill="currentColor" stroke="none"/>
                  <path class="node-link" d="M9.9 10.4l2.2-0.8"/>
                </svg>
              </span>
              <span class="cap-index">02</span>
              <h3>Code analyzer</h3>
              <p class="cap-blurb">
                Lint diagnostics catch problems before you run — plus an opt-in
                static type checker, the first for R, with full inference.
              </p>
              <a class="doclink" href="/type-checker">Type checker docs <span aria-hidden="true">→</span></a>
            </article>

            <article class="cap-card" style="--accent: var(--cap-emerald)">
              <span class="cap-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 8h9"/>
                  <path d="M5 12h6"/>
                  <path d="M5 16h11"/>
                  <path class="guide" d="M19 6v12"/>
                  <path class="tick tick-1" d="M14 8h5"/>
                  <path class="tick tick-2" d="M11 12h8"/>
                </svg>
              </span>
              <span class="cap-index">03</span>
              <h3>Code formatter</h3>
              <p class="cap-blurb">
                <code>roughly fmt</code> formats your whole project to one
                consistent style, with a <code>--diff</code> mode for CI.
              </p>
              <a class="doclink" href="/formatter">Formatter docs <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </section>

      <!-- ====================== LANGUAGE SERVER ======================= -->
      <section class="band">
        <div class="band-inner">
          <div class="section-head">
            <p class="eyebrow">write</p>
            <h2>IDE features in your editor.</h2>
            <p class="lede">
              Completion, hover, go-to-definition, find references, rename, and
              inlay hints. Ships as a VS Code extension on the Marketplace and
              speaks LSP, so it drops into any editor that does too.
            </p>
          </div>

          <div
            class="tabs vertical card showcase"
            data-tabs
            style="--accent: var(--cap-cyan)"
          >
            <div role="tablist" aria-label="Language server features" aria-orientation="vertical">
              {
                lsTabs.map((t, i) => (
                  <button
                    role="tab"
                    id={`tab-ls-${t.key}`}
                    aria-controls={`panel-ls-${t.key}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    {t.label}
                  </button>
                ))
              }
            </div>

            <div class="tab-panels">
              <!-- Completion -->
              <div role="tabpanel" id="panel-ls-completion" aria-labelledby="tab-ls-completion" tabindex="0" class="is-active">
                <div class="frame">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name">model.R</span>
                  </div>
                  <div class="frame-body cmp-body">
                    <div class="eline"><span class="c-fn">summary</span> &lt;- <span class="c-kw">function</span>(df) <span class="cmp-anchor">df<span class="acc">$</span><span class="caret-c"></span><span class="ghost">count</span></span></div>
                    <div class="cmp-pop" role="presentation">
                      <div class="cmp-hi" aria-hidden="true"></div>
                      <div class="cmp-row"><span class="kind">col</span><span class="cmp-name">count</span></div>
                      <div class="cmp-row"><span class="kind">col</span><span class="cmp-name">category</span></div>
                      <div class="cmp-row"><span class="kind">col</span><span class="cmp-name">created_at</span></div>
                      <div class="cmp-row"><span class="kind">col</span><span class="cmp-name">is_active</span></div>
                    </div>
                  </div>
                </div>
                <p class="panel-cap">Member completion fires the moment you type <code>df$</code> — columns, not guesses.</p>
              </div>

              <!-- Hover -->
              <div role="tabpanel" id="panel-ls-hover" aria-labelledby="tab-ls-hover" tabindex="0" hidden>
                <div class="frame">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name">model.R</span>
                  </div>
                  <div class="frame-body frame-tall">
                    <div class="hov-tip" role="presentation">
                      <div class="sig"><span class="acc">add</span>: &lt;<span class="acc">T</span>: <span class="acc">numeric</span>&gt; fn(a: <span class="acc">T</span>, b: <span class="acc">T</span>) -&gt; <span class="acc">T</span></div>
                      <div class="doc">Inferred — no annotation required.</div>
                      <span class="hov-notch" aria-hidden="true"></span>
                    </div>
                    <div class="eline hov-line"><span class="hov-target">add</span> &lt;- <span class="c-kw">function</span>(a, b) a + b</div>
                  </div>
                </div>
                <p class="panel-cap">Hover any symbol to read its inferred signature.</p>
              </div>

              <!-- Go-to-definition -->
              <div role="tabpanel" id="panel-ls-gotodef" aria-labelledby="tab-ls-gotodef" tabindex="0" hidden>
                <div class="frame">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name">model.R</span>
                  </div>
                  <div class="frame-body frame-tall gotodef-body">
                    <svg class="gotodef-wire" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true">
                      <path class="wire" d="M70 26 C 30 40, 30 70, 44 92" />
                      <path class="wire-head" d="M40 86 l4 8 l6 -5" />
                    </svg>
                    <div class="eline">total &lt;- <span class="gd-link">score</span>(x)</div>
                    <div class="gd-divider" aria-hidden="true"></div>
                    <div class="eline gd-def"><span class="gd-marker" aria-hidden="true"></span><span class="gd-halo">score</span> &lt;- <span class="c-kw">function</span>(x) x * weight</div>
                  </div>
                </div>
                <p class="panel-cap">Jump from a call straight to its definition — across the project.</p>
              </div>

              <!-- Find references -->
              <div role="tabpanel" id="panel-ls-references" aria-labelledby="tab-ls-references" tabindex="0" hidden>
                <div class="refs-grid">
                  <div class="frame">
                    <div class="frame-bar">
                      <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                      <span class="frame-name">model.R</span>
                      <span class="refs-chip">3 references</span>
                    </div>
                    <div class="frame-body">
                      <div class="eline">w &lt;- <span class="ref-box ref-1">weight</span></div>
                      <div class="eline">m &lt;- mean(<span class="ref-box ref-2">weight</span>)</div>
                    </div>
                  </div>
                  <div class="frame">
                    <div class="frame-bar">
                      <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                      <span class="frame-name">score.R</span>
                    </div>
                    <div class="frame-body">
                      <div class="eline">score &lt;- <span class="c-kw">function</span>(x) x * <span class="ref-box ref-3">weight</span></div>
                    </div>
                  </div>
                </div>
                <p class="panel-cap">Every occurrence of a symbol, across files, in one query.</p>
              </div>

              <!-- Rename -->
              <div role="tabpanel" id="panel-ls-rename" aria-labelledby="tab-ls-rename" tabindex="0" hidden>
                <div class="frame">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name">score.R</span>
                  </div>
                  <div class="frame-body frame-tall">
                    <div class="eline">score &lt;- <span class="c-kw">function</span>(x) x * <span class="rename-input"><span class="rename-word">coefficient</span><span class="caret-c"></span></span></div>
                    <div class="eline rename-ghost">w &lt;- <span class="rn-old">weight</span><span class="rn-new">coefficient</span> <span class="rn-dot" aria-hidden="true"></span></div>
                    <div class="eline rename-ghost">m &lt;- mean(<span class="rn-old">weight</span><span class="rn-new">coefficient</span>) <span class="rn-dot" aria-hidden="true"></span></div>
                    <span class="rename-done" aria-hidden="true">✓ renamed</span>
                  </div>
                </div>
                <p class="panel-cap">One rename updates every use, atomically, project-wide.</p>
              </div>

              <!-- Inlay hints -->
              <div role="tabpanel" id="panel-ls-inlay" aria-labelledby="tab-ls-inlay" tabindex="0" hidden>
                <div class="frame">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name">model.R</span>
                  </div>
                  <div class="frame-body frame-tall">
                    <div class="eline"><span class="c-fn">add</span> &lt;- <span class="c-kw">function</span>(a, b) a + b <span class="inlay-pill">&lt;<span class="acc">T</span>: <span class="acc">numeric</span>&gt; fn(a: T, b: T) -&gt; T</span></div>
                    <div class="eline">score(<span class="inlay-arg">x:</span> x)</div>
                  </div>
                </div>
                <p class="panel-cap">The inferred signature shows up as an inlay hint — no annotation required.</p>
              </div>
            </div>
          </div>

          <a class="doclink section-doclink" href="/language-server">Language server docs <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <!-- ======================== CODE ANALYSIS ======================== -->
      <section class="band band-spotlight">
        <div class="band-inner">
          <div class="section-head">
            <div class="head-row">
              <p class="eyebrow">check</p>
              <span class="optin-chip" style="--accent: var(--cap-violet)">opt-in</span>
            </div>
            <h2>Code analysis.</h2>
            <p class="lede">
              Lint diagnostics flag problems before you run. Go deeper with the
              first static type checker for R — Hindley-Milner inference that
              checks most code with zero annotations, fully opt-in.
            </p>
          </div>

          <div
            class="tabs vertical card showcase"
            data-tabs
            style="--accent: var(--cap-violet)"
          >
            <div role="tablist" aria-label="Code analysis" aria-orientation="vertical">
              {
                caTabs.map((t, i) => (
                  <button
                    role="tab"
                    id={`tab-ca-${t.key}`}
                    aria-controls={`panel-ca-${t.key}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    {t.label}
                  </button>
                ))
              }
            </div>

            <div class="tab-panels">
              <!-- Type checking -->
              <div role="tabpanel" id="panel-ca-typing" aria-labelledby="tab-ca-typing" tabindex="0" class="is-active">
                <div class="frame">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name">count.R</span>
                  </div>
                  <div class="frame-body">
                    <div class="eline"><span class="c-muted">#:<span class="anno-dot" tabindex="0" role="note" aria-label="A #: comment — an ordinary comment to every other R tool." title="A #: comment — an ordinary comment to every other R tool."></span> fn(count: integer) -&gt; integer</span></div>
                    <div class="eline"><span class="c-fn">double_count</span> &lt;- <span class="c-kw">function</span>(count) count + count</div>
                    <div class="eline"><span class="c-fn">double_count</span>(<span class="c-str squiggle">"two"</span>)</div>
                    <div class="eline caret-row"><span class="caret">             ^^^^^</span></div>
                    <div class="eline diag-line"><span class="diag-err">error[type-error]</span> expected <span class="pill pill-want">integer</span>, found <span class="pill pill-got">character</span></div>
                  </div>
                </div>
                <p class="panel-cap">An annotated type error, caught statically — before the code ever runs. <a class="doclink inline" href="/type-checker">Type checker docs →</a></p>
              </div>

              <!-- Inference -->
              <div role="tabpanel" id="panel-ca-inference" aria-labelledby="tab-ca-inference" tabindex="0" hidden>
                <div class="frame">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name">infer.R</span>
                  </div>
                  <div class="frame-body frame-tall">
                    <div class="eline"><span class="c-fn">add</span> &lt;- <span class="c-kw">function</span>(<span class="param">a</span>, <span class="param">b</span>) a + b <span class="infer-inlay"># inferred: &lt;<span class="acc">T</span>: <span class="acc">numeric</span>&gt; fn(a: T, b: T) -&gt; T</span></div>
                  </div>
                </div>
                <p class="panel-cap">Most code needs no annotations at all — inference resolves the types for you. <a class="doclink inline" href="/type-checker">How inference works →</a></p>
              </div>

              <!-- Linting -->
              <div role="tabpanel" id="panel-ca-linting" aria-labelledby="tab-ca-linting" tabindex="0" hidden>
                <div class="frame term">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name term-title">zsh — roughly</span>
                  </div>
                  <div class="frame-body frame-tall">
                    <div class="eline"><span class="term-prompt">$</span> <span class="term-cmd">roughly check</span><span class="caret-c term-caret"></span></div>
                    <div class="eline term-out"><span class="diag-err">error:</span> Syntax Error: unexpected "&#123;"  <span class="c-muted">(R/main.R)</span></div>
                    <div class="eline term-out term-warn-row"><span class="diag-warn">warning:</span> unused variable `tmp`  <span class="c-muted">(R/util.R)</span></div>
                  </div>
                </div>
                <p class="panel-cap">Lint from the CLI in CI or your editor — errors in red, warnings in amber. <a class="doclink inline" href="/linter">Linter docs →</a></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================== FORMATTER ========================== -->
      <section class="band">
        <div class="band-inner">
          <div class="section-head">
            <p class="eyebrow">ship</p>
            <h2>One consistent style.</h2>
            <p class="lede">
              Badly-formatted R reflows into formatted R in place — whitespace
              collapses and grows, indentation snaps to a grid, and quotes flip.
              Run <code>roughly fmt</code>, or <code>--diff</code> to gate CI.
            </p>
          </div>

          <div
            class="tabs horizontal card showcase fmt-tabs"
            data-tabs
            data-fmt
            style="--accent: var(--cap-emerald)"
          >
            <div role="tablist" aria-label="Formatter examples" aria-orientation="horizontal">
              {
                fmtTabs.map((t, i) => (
                  <button
                    role="tab"
                    id={`tab-fmt-${t.key}`}
                    aria-controls={`panel-fmt-${t.key}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    {t.label}
                  </button>
                ))
              }
            </div>

            <div class="tab-panels">
              <!-- Spacing & operators -->
              <div role="tabpanel" id="panel-fmt-spacing" aria-labelledby="tab-fmt-spacing" tabindex="0" class="is-active">
                <div class="frame">
                  <div class="frame-bar">
                    <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="frame-name">format.R</span>
                  </div>
                  <div class="frame-body">
                    <div class="fmt-panel">
                      <div class="fmt-anim">
                        <div class="fmt-line" style="--i:0"><span class="tk"><span class="c-fn">x_option</span></span><span class="sp is-ch" style="--wb:0ch;--wf:1ch"></span><span class="tk">&lt;-</span><span class="sp is-ch" style="--wb:0ch;--wf:1ch"></span><span class="tk"><span class="c-kw">function</span></span><span class="tk">(</span><span class="sp is-ch" style="--wb:1ch;--wf:0ch"></span><span class="tk">x</span><span class="sp is-ch" style="--wb:1ch;--wf:0ch"></span><span class="tk">)</span><span class="sp" style="--wb:1ch;--wf:1ch"></span><span class="tk">&#123;</span></div>
                      </div>
