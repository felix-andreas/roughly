    <script>
      // ======================================================================
      // Hero particle field: logo -> particles one-shot intro, then ambient.
      // ======================================================================
      type Particle = {
        x: number
        y: number
        vx: number
        vy: number
        tx: number
        ty: number
        depth: number
        target: boolean
        bonded: boolean
      }
      type Target = { x: number; y: number }

      const heroCanvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null
      const heroEl = document.getElementById('hero') as HTMLElement | null

      function initHero() {
        if (!heroCanvas || !heroEl) return
        const ctx = heroCanvas.getContext('2d')
        if (!ctx) return
        const context = ctx
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        const INTRO_DELAY = 0.25
        const ASSEMBLE = 1.7
        const HOLD = 1.3
        const DISPERSE = 2.0
        const disperseStart = INTRO_DELAY + ASSEMBLE + HOLD

        let dpr = Math.min(window.devicePixelRatio || 1, 2)
        let cssW = 0
        let cssH = 0
        let particles: Particle[] = []
        let targets: Target[] = []
        let running = false
        let rafId = 0
        let lastTime = 0
        let clock = 0
        let centroidX = 0
        let centroidY = 0
        const mouse = { x: -9999, y: -9999, active: false }

        const logoImg = new Image()
        const logoReady = (async () => {
          logoImg.src = '/logo.svg'
          try {
            await logoImg.decode()
          } catch {
            await new Promise<void>((resolve) => {
              logoImg.onload = () => resolve()
              logoImg.onerror = () => resolve()
            })
          }
        })()

        function particleCount() {
          return cssW < 720 ? 2400 : cssW < 1100 ? 3800 : 5000
        }
        function sampleStride() {
          return cssW < 720 ? 4 : 3
        }
        function clamp01(t: number) {
          return t < 0 ? 0 : t > 1 ? 1 : t
        }
        function smooth01(t: number) {
          return t * t * (3 - 2 * t)
        }

        function hash(ix: number, iy: number) {
          const n = Math.sin(ix * 127.1 + iy * 311.7) * 43758.5453
          return n - Math.floor(n)
        }
        function valueNoise(x: number, y: number) {
          const ix = Math.floor(x)
          const iy = Math.floor(y)
          const fx = smooth01(x - ix)
          const fy = smooth01(y - iy)
          const a = hash(ix, iy)
          const b = hash(ix + 1, iy)
          const c = hash(ix, iy + 1)
          const d = hash(ix + 1, iy + 1)
          return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy
        }
        function flowAngle(x: number, y: number, t: number) {
          return valueNoise(x * 0.0016 + t * 0.025, y * 0.0016 - t * 0.012) * Math.PI * 4
        }

        function buildTargets() {
          const SS = 2
          const logoH = Math.min(cssH * 0.46, 360)
          const logoW = logoH * 0.75
          const left = (cssW - logoW) / 2
          const top = ((cssH - logoH) / 2) * 0.92
          centroidX = left + logoW / 2
          centroidY = top + logoH / 2
          targets = []
          if (!logoImg.width || !logoImg.height) return

          const off = document.createElement('canvas')
          off.width = Math.max(2, Math.round(logoW * SS))
          off.height = Math.max(2, Math.round(logoH * SS))
          const octx = off.getContext('2d')
          if (!octx) return
          octx.clearRect(0, 0, off.width, off.height)
          octx.drawImage(logoImg, 0, 0, off.width, off.height)
          let data: Uint8ClampedArray
          try {
            data = octx.getImageData(0, 0, off.width, off.height).data
          } catch {
            return
          }

          const want = Math.round(particleCount() * 0.8)
          const baseStride = sampleStride() * SS
          const sample = (st: number) => {
            const out: Target[] = []
            for (let sy = Math.floor(st / 2); sy < off.height; sy += st) {
              for (let sx = Math.floor(st / 2); sx < off.width; sx += st) {
                const alpha = data[(sy * off.width + sx) * 4 + 3]
                if (alpha > 128) {
                  out.push({
                    x: left + sx / SS + (Math.random() - 0.5),
                    y: top + sy / SS + (Math.random() - 0.5),
                  })
                }
              }
            }
            return out
          }
          let pts = sample(baseStride)
          if (pts.length > want * 1.15) pts = sample(baseStride + 1)
          else if (pts.length < want * 0.7 && baseStride > SS) pts = sample(baseStride - 1)
          targets = pts
        }

        function spawnParticles() {
          const count = particleCount()
          particles = []
          for (let i = 0; i < count; i++) {
            particles.push({
              x: Math.random() * cssW,
              y: Math.random() * cssH,
              vx: 0,
              vy: 0,
              tx: 0,
              ty: 0,
              depth: 0.35 + Math.random() * 0.65,
              target: false,
              bonded: false,
            })
          }
        }

        function assignTargets() {
          const n = Math.min(particles.length, targets.length)
          for (let i = 0; i < particles.length; i++) {
            const p = particles[i]
            if (i < n) {
              p.tx = targets[i].x
              p.ty = targets[i].y
              p.target = true
            } else {
              p.target = false
            }
            p.bonded = false
          }
        }

        function relayout() {
          dpr = Math.min(window.devicePixelRatio || 1, 2)
          const r = heroEl!.getBoundingClientRect()
          cssW = r.width
          cssH = r.height
          heroCanvas!.width = Math.floor(cssW * dpr)
          heroCanvas!.height = Math.floor(cssH * dpr)
          heroCanvas!.style.width = cssW + 'px'
          heroCanvas!.style.height = cssH + 'px'
          context.setTransform(dpr, 0, 0, dpr, 0, 0)
          buildTargets()
          spawnParticles()
          assignTargets()
        }

        function drawStatic() {
          context.clearRect(0, 0, cssW, cssH)
          context.fillStyle = '#fff'
          for (let i = 0; i < particles.length; i++) {
            const p = particles[i]
            if (p.target) {
              const s = p.depth > 0.66 ? 2 : 1
              context.globalAlpha = Math.min(1, 0.18 + p.depth * 0.34 + 0.22)
              context.fillRect(p.tx, p.ty, s, s)
            } else if (i % 7 === 0) {
              context.globalAlpha = 0.12
              context.fillRect(p.x, p.y, 1, 1)
            }
          }
          context.globalAlpha = 1
        }

        function step(now: number) {
          if (!running) return
          if (lastTime === 0) lastTime = now
          let dt = (now - lastTime) / 1000
          lastTime = now
          if (dt > 0.05) dt = 0.05
          const prevClock = clock
          clock += dt

          const assembleP = clamp01((clock - INTRO_DELAY) / ASSEMBLE)
          const disperseP = clamp01((clock - disperseStart) / DISPERSE)
          let focus: number
          if (clock < INTRO_DELAY) focus = 0
          else if (clock < INTRO_DELAY + ASSEMBLE) focus = smooth01(assembleP)
          else if (clock < disperseStart) focus = 1
          else focus = 1 - smooth01(disperseP)
          const assembling = clock >= INTRO_DELAY && clock < disperseStart
          const inHold = clock >= INTRO_DELAY + ASSEMBLE && clock < disperseStart
          const holdP = inHold ? (clock - (INTRO_DELAY + ASSEMBLE)) / HOLD : 0

          if (prevClock < disperseStart && clock >= disperseStart) {
            for (const p of particles) {
              if (!p.target) continue
              p.vx += (p.x - centroidX) * 0.012 + (Math.random() - 0.5) * 0.3
              p.vy += (p.y - centroidY) * 0.012 + (Math.random() - 0.5) * 0.3
            }
          }

          context.fillStyle = 'rgba(0,0,0,0.14)'
          context.fillRect(0, 0, cssW, cssH)
          context.fillStyle = '#fff'

          const k = 0.035 * (0.3 + 0.7 * focus)

          for (let i = 0; i < particles.length; i++) {
            const p = particles[i]
            if (assembling && p.target) {
              p.vx += (p.tx - p.x) * k
              p.vy += (p.ty - p.y) * k
              p.vx *= 0.88
              p.vy *= 0.88
              p.x += p.vx
              p.y += p.vy
              const dx = p.tx - p.x
              const dy = p.ty - p.y
              p.bonded = dx * dx + dy * dy < 2.25
            } else {
              const ang = flowAngle(p.x, p.y, clock)
              p.vx += Math.cos(ang) * 0.05
              p.vy += Math.sin(ang) * 0.05
              if (mouse.active) {
                const mdx = p.x - mouse.x
                const mdy = p.y - mouse.y
                const d2 = mdx * mdx + mdy * mdy
                if (d2 < 16000 && d2 > 0.01) {
                  const f = (1 - d2 / 16000) * 0.9
                  const inv = 1 / Math.sqrt(d2)
                  p.vx += mdx * inv * f
                  p.vy += mdy * inv * f
                }
              }
              p.vx *= 0.92
              p.vy *= 0.92
              p.x += p.vx
              p.y += p.vy
              if (p.x < -4) p.x += cssW + 8
              else if (p.x > cssW + 4) p.x -= cssW + 8
              if (p.y < -4) p.y += cssH + 8
              else if (p.y > cssH + 4) p.y -= cssH + 8
              p.bonded = false
            }

            const s = p.depth > 0.66 ? 2 : 1
            let a: number
            if (p.target) {
              a = (0.18 + p.depth * 0.34) * (0.45 + 0.55 * focus)
              if (p.bonded) a += 0.22 * focus
              if (p.bonded && inHold) a += 0.1 * Math.sin(holdP * Math.PI)
            } else {
              a = 0.14 + p.depth * 0.22
            }
            if (a <= 0.01) continue
            context.globalAlpha = a > 1 ? 1 : a
            context.fillRect(p.x, p.y, s, s)
          }

          context.globalAlpha = 1
          rafId = requestAnimationFrame(step)
        }

        function start() {
          if (running) return
          running = true
          lastTime = 0
          rafId = requestAnimationFrame(step)
        }
        function stop() {
          running = false
          if (rafId) cancelAnimationFrame(rafId)
          rafId = 0
        }

        let resizeTimer = 0
        window.addEventListener('resize', () => {
          window.clearTimeout(resizeTimer)
          resizeTimer = window.setTimeout(() => {
            relayout()
            if (reduceMotion) drawStatic()
          }, 150)
        })
        window.addEventListener('mousemove', (e) => {
          const r = heroCanvas!.getBoundingClientRect()
          mouse.x = e.clientX - r.left
          mouse.y = e.clientY - r.top
          mouse.active = mouse.y >= 0 && mouse.y <= cssH
        })
        window.addEventListener('mouseleave', () => (mouse.active = false))

        const begin = () => {
          relayout()
          if (reduceMotion) {
            drawStatic()
            return
          }
          if (typeof IntersectionObserver === 'undefined') {
            start()
            return
          }
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) start()
                else stop()
              }
            },
            { threshold: 0.04 }
          )
          observer.observe(heroEl!)
        }

        const fontsReady =
          document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()
        Promise.all([fontsReady, logoReady]).then(begin).catch(begin)
      }

      // ======================================================================
      // Reusable accessible tabs (roving tabindex, arrows, focus-follows).
      // ======================================================================
      function setupTabs(root: HTMLElement) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const tablist = root.querySelector('[role="tablist"]')
        const tabs = Array.from(root.querySelectorAll('[role="tab"]')) as HTMLElement[]
        const panels = tabs.map(
          (t) => root.querySelector('#' + t.getAttribute('aria-controls')) as HTMLElement | null
        )
        const isMorph = root.hasAttribute('data-morph-section')
        let visible = false
        let loopTimer = 0
        const timers = new WeakMap<HTMLElement, number[]>()
        const intervals = new WeakMap<HTMLElement, number[]>()

        if (reduce && isMorph) root.classList.add('reduced')
        if (isMorph) {
          for (const p of panels) if (p) p.classList.add('is-formatted', 'is-settled')
        }
        if (reduce) applyReducedEndStates()

        function selectedIndex() {
          return tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')
        }

        function activate(index: number, focusTab: boolean) {
          tabs.forEach((t, i) => {
            const sel = i === index
            t.setAttribute('aria-selected', sel ? 'true' : 'false')
            t.tabIndex = sel ? 0 : -1
            const panel = panels[i]
            if (panel) {
              if (sel) panel.hidden = false
              else {
                panel.hidden = true
                stopSignature(panel)
              }
            }
          })
          if (focusTab) tabs[index].focus()
          const panel = panels[index]
          if (panel && visible) triggerSignature(panel)
        }

        function triggerSignature(panel: HTMLElement) {
          if (reduce) return
          if (isMorph) {
            playMorph(panel)
            return
          }
          panel.classList.remove('play')
          void panel.offsetWidth
          panel.classList.add('play')
          runJsSignature(panel)
        }
        function stopSignature(panel: HTMLElement) {
          panel.classList.remove('play')
          if (isMorph) clearMorphTimers(panel)
          cancelJs(panel)
        }

        function clearMorphTimers(panel: HTMLElement) {
          const ts = timers.get(panel)
          if (ts) for (const id of ts) clearTimeout(id)
          timers.set(panel, [])
        }
        function playMorph(panel: HTMLElement) {
          if (reduce) return
          clearMorphTimers(panel)
          panel.classList.add('no-anim')
          panel.classList.remove('is-formatted', 'is-settled')
          void panel.offsetWidth
          panel.classList.remove('no-anim')
          const t1 = window.setTimeout(() => panel.classList.add('is-formatted'), 250)
          const t2 = window.setTimeout(() => panel.classList.add('is-settled'), 250 + 700 + 350)
          timers.set(panel, [t1, t2])
        }

        function runJsSignature(panel: HTMLElement) {
          cancelJs(panel)
          if (panel.id === 'panel-refs') {
            const el = panel.querySelector('.refs-count')
            if (!el) return
            let n = 0
            el.textContent = '0'
            const id = window.setInterval(() => {
              n++
              el.textContent = String(n)
              if (n >= 3) {
                window.clearInterval(id)
              }
            }, 130)
            intervals.set(panel, [id])
          } else if (panel.id === 'panel-rename') {
            const box = panel.querySelector('.rename-text') as HTMLElement | null
            const ghosts = Array.from(panel.querySelectorAll('.ghost-tok')) as HTMLElement[]
            if (!box) return
            box.textContent = 'weight'
            ghosts.forEach((g) => {
              g.textContent = 'weight'
              g.classList.remove('flip')
            })
            const target = 'coefficient'
            let current = 'weight'
            let phase = 0
            const id = window.setInterval(() => {
              if (phase === 0) {
                current = current.slice(0, -1)
                box.textContent = current
                if (current.length === 0) phase = 1
              } else {
                current = target.slice(0, current.length + 1)
                box.textContent = current
                if (current === target) {
                  window.clearInterval(id)
                  ghosts.forEach((g) => {
                    g.textContent = 'coefficient'
                    g.classList.add('flip')
                  })
                }
              }
            }, 42)
            intervals.set(panel, [id])
          }
        }
        function cancelJs(panel: HTMLElement) {
          const ids = intervals.get(panel)
          if (ids) for (const id of ids) clearInterval(id)
          intervals.set(panel, [])
        }

        function applyReducedEndStates() {
          const rename = root.querySelector('#panel-rename')
          if (rename) {
            const box = rename.querySelector('.rename-text')
            if (box) box.textContent = 'coefficient'
            rename.querySelectorAll('.ghost-tok').forEach((g) => (g.textContent = 'coefficient'))
            rename.classList.add('renamed')
          }
        }

        if (tablist) {
          tablist.addEventListener('keydown', (e) => {
            const ev = e as KeyboardEvent
            const cur = selectedIndex()
            const n = tabs.length
            let next = -1
            if (ev.key === 'ArrowDown' || ev.key === 'ArrowRight') next = (cur + 1) % n
            else if (ev.key === 'ArrowUp' || ev.key === 'ArrowLeft') next = (cur - 1 + n) % n
            else if (ev.key === 'Home') next = 0
            else if (ev.key === 'End') next = n - 1
            else return
            ev.preventDefault()
            activate(next, true)
          })
        }
        tabs.forEach((t, i) => t.addEventListener('click', () => activate(i, true)))

        function startLoop() {
          if (!isMorph || reduce) return
          stopLoop()
          loopTimer = window.setInterval(() => {
            if (!visible) return
            const idx = selectedIndex()
            const panel = panels[idx >= 0 ? idx : 0]
            if (panel) playMorph(panel)
          }, 4500)
        }
        function stopLoop() {
          if (loopTimer) {
            clearInterval(loopTimer)
            loopTimer = 0
          }
        }

        if (typeof IntersectionObserver !== 'undefined') {
          const io = new IntersectionObserver(
            (entries) => {
              for (const en of entries) {
                visible = en.intersectionRatio >= 0.35
                if (visible) {
                  const idx = selectedIndex()
                  const panel = panels[idx >= 0 ? idx : 0]
                  if (panel) triggerSignature(panel)
                  startLoop()
                } else {
                  stopLoop()
                  for (const p of panels) if (p) stopSignature(p)
                }
              }
            },
            { threshold: [0, 0.35, 0.6] }
          )
          io.observe(root)
        } else {
          visible = true
          const idx = selectedIndex()
          const panel = panels[idx >= 0 ? idx : 0]
          if (panel) triggerSignature(panel)
        }
      }

      // ======================================================================
      // Closer: faint static particle dusting.
      // ======================================================================
      function initCloser() {
        const c = document.getElementById('closer-canvas') as HTMLCanvasElement | null
        const section = document.getElementById('get-started') as HTMLElement | null
        if (!c || !section) return
        const ctx = c.getContext('2d')
        if (!ctx) return
        function paint() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2)
          const r = section!.getBoundingClientRect()
          const w = Math.max(2, r.width)
          const h = Math.max(2, r.height)
          c!.width = Math.floor(w * dpr)
          c!.height = Math.floor(h * dpr)
          c!.style.width = w + 'px'
          c!.style.height = h + 'px'
          ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)
          ctx!.clearRect(0, 0, w, h)
          ctx!.fillStyle = '#fff'
          const n = w < 720 ? 240 : 420
          for (let i = 0; i < n; i++) {
            const depth = Math.random()
            ctx!.globalAlpha = 0.04 + depth * 0.06
            ctx!.fillRect(Math.random() * w, Math.random() * h, depth > 0.7 ? 2 : 1, depth > 0.7 ? 2 : 1)
          }
          ctx!.globalAlpha = 1
        }
        let timer = 0
        window.addEventListener('resize', () => {
          window.clearTimeout(timer)
          timer = window.setTimeout(paint, 150)
        })
        paint()
      }

      function initNav() {
        const nav = document.getElementById('nav')
        if (!nav) return
        const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8)
        onScroll()
        window.addEventListener('scroll', onScroll, { passive: true })
      }

      initHero()
      document
        .querySelectorAll('[data-tabs]')
        .forEach((el) => setupTabs(el as HTMLElement))
      initCloser()
      initNav()
    </script>

