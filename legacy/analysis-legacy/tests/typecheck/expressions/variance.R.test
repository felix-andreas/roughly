#==== nominal_variance
#---- contravariant_arg_rejected
#: @type Handler<T> {fn(value: T) -> NULL}

#: @new Handler<integer>
handler <- function(value) NULL

#: Handler<integer | NULL>
widened <- handler
#++++
error: type mismatch

#---- contravariant_arg_widening_accepted
#: @type Handler<T> {fn(value: T) -> NULL}

#: @new Handler<integer | NULL>
handler <- function(value) NULL

#: Handler<integer>
narrowed <- handler
narrowed
#++++
Handler<integer | NULL>
Handler<integer>
Handler<integer>

#---- covariant_arg_still_accepted
#: @type Box<T> {list{value: T}}

#: @new Box<integer>
box <- list(value = 1L)

#: Box<integer | NULL>
widened <- box
widened
#++++
Box<integer>
Box<integer | NULL>
Box<integer | NULL>

#---- invariant_arg_rejects_widening
#: @type Cell<T> {list{get: T, set: fn(value: T) -> NULL}}

#: @new Cell<integer>
cell <- list(get = 1L, set = function(value) NULL)

#: Cell<integer | NULL>
widened <- cell
#++++
error: type mismatch

#---- invariant_arg_requires_exact_match
#: @type Cell<T> {list{get: T, set: fn(value: T) -> NULL}}

#: @new Cell<integer>
cell <- list(get = 1L, set = function(value) NULL)

#: Cell<integer>
same <- cell
same
#++++
Cell<integer>
Cell<integer>
Cell<integer>

#---- phantom_param_accepts_any
#: @type Tagged<T> {integer}

#: @new Tagged<integer>
tagged <- 1L

#: Tagged<logical>
relabelled <- tagged
relabelled
#++++
Tagged<integer>
Tagged<logical>
Tagged<logical>

#---- nested_nominal_arg_is_invariant
#: @type Sink<T> {fn(value: T) -> NULL}
#: @type Outer<T> {Sink<T>}

#: @new Outer<integer>
outer <- function(value) NULL

#: Outer<integer | NULL>
widened <- outer
#++++
error: type mismatch
