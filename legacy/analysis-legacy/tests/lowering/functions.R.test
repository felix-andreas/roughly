#==== functions
#---- empty_function
function() NULL
#++++
Function ()
  Null

#---- one_parameter
function(x) x
#++++
Function (x)
  Symbol(x)

#---- multiple_parameters
function(a, b, c) a
#++++
Function (a, b, c)
  Symbol(a)

#---- parameter_with_default
function(count, label = NULL) count
#++++
Function (count, label = <default>)
  Symbol(count)

#---- simple_call
f()
#++++
Call
  Symbol(f)

#---- call_with_arguments
f(1L, "a")
#++++
Call
  Symbol(f)
  Argument:
    Integer("1L")
  Argument:
    Character("\"a\"")

#---- call_with_named_arguments
f(x = 1L, y = 2L)
#++++
Call
  Symbol(f)
  Argument x:
    Integer("1L")
  Argument y:
    Integer("2L")

#---- call_with_mixed_arguments
f(1L, y = 2L)
#++++
Call
  Symbol(f)
  Argument:
    Integer("1L")
  Argument y:
    Integer("2L")

#---- library_bare_name_lowers_as_character
library(stats)
#++++
Call
  Symbol(library)
  Argument:
    Character("stats")

#---- require_bare_name_lowers_as_character
require(utils)
#++++
Call
  Symbol(require)
  Argument:
    Character("utils")

#---- help_bare_name_lowers_as_character
help(mean)
#++++
Call
  Symbol(help)
  Argument:
    Character("mean")

#---- library_string_stays_a_string
library("stats")
#++++
Call
  Symbol(library)
  Argument:
    Character("\"stats\"")

#---- library_named_first_argument_stays_a_reference
library(package = stats)
#++++
Call
  Symbol(library)
  Argument package:
    Symbol(stats)
