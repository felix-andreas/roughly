#==== function_globals
#---- top_level_binding_used_inside_function
#---- R/main.R
x <- 1L
f <- function() x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Symbol(x@b0)

#==== nested_functions
#---- nested_function_closes_over_outer_local
#---- R/main.R
f <- function() {
  x <- 1L
  g <- function() x
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(x@b1)
        Integer(1L)
      Assign(g@b2)
        Function()
          Symbol(x@b1)

#---- nested_function_closes_over_outer_parameter
#---- R/main.R
f <- function(x) {
  g <- function() x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(g@b2)
        Function()
          Symbol(x@b1)

#---- nested_function_closes_over_top_level_global
#---- R/main.R
x <- 1L
f <- function() {
  g <- function() x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Assign(g@b2)
        Function()
          Symbol(x@b0)

#---- multi_hop_nested_function_closes_over_outer_local
#---- R/main.R
f <- function() {
  x <- 1L
  g <- function() {
    h <- function() x
  }
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(x@b1)
        Integer(1L)
      Assign(g@b2)
        Function()
          Block
            Assign(h@b3)
              Function()
                Symbol(x@b1)

#---- closure_parameter_shadows_enclosing_binding
#---- R/main.R
f <- function() {
  x <- 1L
  g <- function(x) x
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(x@b1)
        Integer(1L)
      Assign(g@b2)
        Function(x@b3)
          Symbol(x@b3)

#---- closure_local_shadows_enclosing_binding
#---- R/main.R
f <- function(x) {
  g <- function() {
    x <- "ok"
    x
  }
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(g@b2)
        Function()
          Block
            Assign(x@b3)
              Character("\"ok\"")
            Symbol(x@b3)

#---- closure_uses_nearest_shadowing_binding_across_hops
#---- R/main.R
x <- 1L
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    h <- function() x
  }
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Assign(x@b2)
        Character("\"outer\"")
      Assign(g@b3)
        Function()
          Block
            Assign(x@b4)
              Logical(true)
            Assign(h@b5)
              Function()
                Symbol(x@b4)

#==== cross_file_globals
#---- nested_function_closes_over_global_from_other_file
#---- R/a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)
#---- R/b.R
f <- function() {
  g <- function() x
}
#++++
Assign(f@b1)
  Function()
    Block
      Assign(g@b2)
        Function()
          Symbol(x@b0)

#---- nested_function_local_shadow_ignores_cross_file_final_winner
#---- R/a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)

warning[naming] Top-level binding `x` is overwritten by a later top-level binding in this package.
--> 1:1-1:8
| x <- 1L
note: the later binding is here. --> R/b.R:1:1
#---- R/b.R
x <- 2L
#++++
Assign(x@b1)
  Integer(2L)

warning[naming] Top-level binding `x` overwrites an earlier top-level binding in this package.
--> 1:1-1:8
| x <- 2L
note: the earlier binding is here. --> R/a.R:1:1
#---- R/c.R
f <- function() {
  x <- 3L
  g <- function() x
}
#++++
Assign(f@b2)
  Function()
    Block
      Assign(x@b3)
        Integer(3L)
      Assign(g@b4)
        Function()
          Symbol(x@b3)
