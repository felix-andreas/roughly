#==== local_scope
#---- assignment_inside_local_does_not_leak
local({
  a <- 1L
  a
})
a
#++++
Local
  Block
    Assign(a@b0)
      Integer(1L)
    Symbol(a@b0)
Symbol(a@?)

No diagnostics.

#---- local_sees_enclosing_local_binding
x <- 1L
local({
  x
})
#++++
Assign(x@b0)
  Integer(1L)
Local
  Block
    Symbol(x@?)

No diagnostics.

#---- local_of_bare_expression
local(1L + 2L)
#++++
Local
  Call
    Symbol(+@?)
    Argument
      Integer(1L)
    Argument
      Integer(2L)

No diagnostics.

#---- local_binding_shadows_enclosing_binding
x <- 1L
local({
  x <- "inner"
  x
})
x
#++++
Assign(x@b0)
  Integer(1L)
Local
  Block
    Assign(x@b1)
      Character("\"inner\"")
    Symbol(x@b1)
Symbol(x@?)

No diagnostics.
