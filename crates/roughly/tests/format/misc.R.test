x <- 1 + 2
y <- x * 3
z <- if (y > 5) {
"greater"
} else {
"lesser"
}
result <- function(a, b = 2) {
return(a + b)
}
list <- list(a = 1, b = 2, c = 3)
for (i in 1:10) {
print(i)
}
while (x < 10) {
x <- x + 1
}
repeat {
x <- x - 1
if (x == 0) break
}
