# fmt: skip-file
#==== newlines
#---- removes_consecutive_newlines
a


b

c

#==== directives
#---- fmt_skip
# fmt: skip
x+y

#---- fmt_skip_file
# fmt: skip-file
x+y

#---- fmt_on_off
x+y

# fmt: off
x+y

# fmt: on
x+y

#==== comments
#---- comment_formatting
#foo
##foo
## foo
### foo
# # foo
#    foo
#'foo
#
# #
#'@param
#' @param
#"foo"
#'foo'
#'foo

#---- all_positions_function
( # hack: only parses correctly with surrounding parentheses
    function # function
    # 1
    ( # (
        # 2
        param # param
        # 3
    ) # )
    # 4
    {} # body
)

#---- all_positions_if
(
    # before
    if # if
    # 1
    ( # open
        # 2
        a && b # condition
        # 3
    ) # close
    # 4
    {
        y
    }
    # 5
    else # else
    # 6
    {
        z
    }
    # after
)

#---- all_positions_binary
lhs + # 1
    rhs # 2

(
    lhs # lhs
    # 1
    + # operator
    # 2
    rhs # rhs
)

#---- all_positions_call
fn( # (
    # 1
    arg1 # arg1
    , # ,
    arg2 # arg2
    # 2
) # )

#---- all_positions_braced
{ # {
    # 1
    body # body
    # 2
} # }

#---- all_positions_parenthesized
( # open
    # 1
    body # body
    # 2
) # close

#==== complex_expressions
#---- chained_extract
foo$
    bar(a)$
    baz(a, b)

(foo
)$
    bar(a
    )$
    baz(a, b)$

#---- hugging_comments
fn(arg1, fn(
    arg
) # comment
)

fn(arg1, {
    body
})

fn(arg1, arg2 = value, function() {
    body
})

#---- multiline_conditions
if (any(
sapply(foo)
)) stop("")

if ( !foo ||
!bar ||
    !baz()
) stop("")

while(foo(
bar)) baz

while ({ foo; bar }) { baz }
while ({ foo;
bar }) { baz }

for (x in foo(
bar)) baz

for (
    variable
    in {
        sequence
    }) {}

#---- complex_nesting
fn(fn(arg
))

fn(fn(
arg))

fn(fn(
arg
))

fn(fn(fn(
    arg
)))

fn(arg = fn(arg = fn(
    arg
)))

#---- operator_precedence
x + y * z
(x + y) * z
x + (y * z)
!x && y
!(x && y)

#---- pipeline_operators
foo |>
    bar

foo %>% bar %>%
        baz

foo |> # foo
#bar
bar |># bar
baz |>
    qux

foo |>
    # something about bar
    bar |>
    # something about baz
    baz

#---- multiline_mixed
foo(
    1
) + 2

(
    1
) +
2

1 + foo(
2)

1 +
foo(
2)

#---- assignment_chains
x <- y <- z
x <<- y <<- z

#---- semicolon_separated
{ x; y }
{ x; y
}
{
x; y }
{
x; y
}

#---- empty_arguments
foo[ ]
foo[, ]
foo[, ,]
foo[ x, ]
foo[x,,]
foo[,x ]
foo[,,x]
foo[x, ,y]
foo[,,x,,y,,]

foo[[ ]]
foo[[, ]]
foo[[, ,]]
foo[[ x, ]]
foo[[x,,]]
foo[[,x ]]
foo[[,,x]]
foo[[x, ,y]]
foo[[,,x,,y,,]]

#==== error_handling
#---- missing_delimiter
# These cases result in parse errors that the formatter should handle gracefully

#---- multiline_strings
"foo
    bar"

foo("foo
    bar")

#==== libraries
#---- r6_classes
Person <- R6Class(
    "Person",
    public = list(
        initialize = function(name, age = NA) {
            private$name <- name
            private$age <- age
        },

        print = function(...) {
            cat("Person: \n")
            cat("  Name: ", private$name, "\n", sep = "")
            cat("  Age:  ", private$age, "\n", sep = "")
        }
    ),

    private = list(
        age = NA,
        name = NULL
    )
)

#---- switch_fallthrough  
switch(foo,
    x = 1,
    "y" = 2,
    z = ,
    3
)

#---- semicolons_in_function
function(x) {
    names(foo[[x]]) <- bar; foo[x]
}

#---- data_table
ans <- flights[, .(arr_delay, dep_delay)]
DT[,.(V4.Sum=sum(V4)), by=V1][order(-V1)]
DT[,':='(V1=round(exp(V1),2), V2=LETTERS[4:6])][]
DT[,lapply(.SD,sum),by=V2, # comment
    .SDcols=c("V3","V4")]

#---- dplyr
starwars %>% #foo
group_by(species)   %>% #bar
select(height, mass)%>% ###   baz
summarise(
        height = mean(height, na.rm = TRUE),
    mass = mean(mass, na.rm = TRUE)
)

#---- purrr
library(purrr)

        mtcars |>
    split(mtcars$cyl) |>  # from base R
map(\(df) lm(mpg~wt, data    = df)) |>
map(summary  ) |>
map_dbl("r.squared"  )
