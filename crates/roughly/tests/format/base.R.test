#---- immediately_invocated
(\(a, b) a * b)(x, y)

(\(a, b) a * b
)(x,y)

(\(a, b)
a * b)(x,y)

#---- body_no_braces
function() body

function()
    body

#---- body_is_call
function() call(a = 1, b = 1)

function()
    call(a = 1, b = 1)

function() call(
    a = 1,
    b = 1
)

function()
call(
    a = 1,
    b = 1
)

#---- all_comment_positions
( # hack: only parses correctly with surrounding parentheses
    function # function
    # 1
    ( # (
        # 2
        param # param
        # 3
    ) # )
    # 4
    {} # body
)
