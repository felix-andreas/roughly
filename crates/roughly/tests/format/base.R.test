x %>% y
x |> y

#---- unary_basic
!x
+x
-x
~x

#==== expressions
#---- braced_basic
{}
{ x }
{ x; y }

#---- braced_multiline
{
    x
}

{
    x
    y
}

#---- parenthesized_basic
(x)
(x + y)

#---- parenthesized_multiline
(
    x
)

(
