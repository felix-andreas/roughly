#==== calls
#---- call_basic
f()
f(x)
f(x, y)
f(a = x, b = y)

#---- call_multiline
f(
    x
)

f(
    x,
    y
)

f(
    a = x,
    b = y
)

#---- subset_basic
x[]
x[y]
x[y, z]
x[a = y, b = z]

#---- subset2_basic
x[[]]
x[[y]]
x[[y, z]]
x[[a = y, b = z]]

#---- extract_basic
x$y
x@y

#---- namespace_basic
x::y
x:::y

#==== function_definition
#---- simple
function(a, b) {}

function(a, b = c) {}

function(a, b = c) { body }

function(a, b = c) {
    body
}

#---- empty
function() {}

function() {
}

function()
{}

function(
) {}

#---- no_spaces
function(a,b=c){body}

function(a,b=c){
body
}

#---- hugging_params
function(a, b = c) { body }

#---- hugging_body
function() { body }

function() {
body }

function() {
    body
}

#---- immediately_invocated
(\(a, b) a * b)(x, y)

(\(a, b) a * b
)(x, y)

(\(a, b)
a * b)(x, y)

#---- body_no_braces
function() body

function()
    body

#---- body_is_call
function() call(a = 1, b = 1)

function()
    call(a = 1, b = 1)

function() call(
    a = 1,
    b = 1
)

function()
call(
    a = 1,
    b = 1
)

#==== control_flow
#---- if_basic
if (condition) body

if (condition) {
    body
}

if (condition) {
    body
} else {
    body
}

if (condition) {
    body
} else if (condition) {
    body
} else {
    body
}

#---- for_basic
for (x in y) body

for (x in y) {
    body
}

#---- while_basic
while (condition) body

while (condition) {
    body
}

#---- repeat_basic
repeat body

repeat {
    body
}

#==== program_structure
#---- simple_program
x <- 1 + 2
y <- x * 3

#---- program_with_functions
f <- function(x) x^2
result <- f(3)

#---- program_with_control_flow
for (i in 1:3) {
    print(i)
}

while (x < 10) {
    x <- x + 1
}
