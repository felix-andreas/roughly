#---- comments
#!/usr/bin/env Rscript
#comment
# comment
#  comment
#   comment
##comment
## comment
##  comment
##   comment
#'@param
#' @param
#'comment'
#"comment"

#---- comment_formatting_edge_cases
# basic comments should get space after #
#comment
#foo
# special comments should preserve format
#' roxygen comment
#* special comment
#: special comment
## double hash comment
#! shebang-style comment
# empty comment just becomes #
#
# comments with quotes should be preserved
#'comment with 'quotes''

#---- comments_all_positions
# 1
program # program
# 2

