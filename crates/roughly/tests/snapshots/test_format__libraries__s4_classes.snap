---
source: crates/roughly/tests/test_format.rs
expression: code
---
setClass(
  "Person",
  slots = list(
    name = "character",
    age = "numeric"
  ),
  prototype = list(
    name = character(0),
    age = numeric(0)
  )
)

setClass(
  "Employee",
  contains = "Person",
  slots = list(
    department = "character",
    salary = "numeric"
  ),
  validity = function(object) {
    if (object@salary < 0) {
      "Salary must be non-negative"
    } else {
      TRUE
    }
  }
)
