# Complex data manipulation with nested function calls and pipeline operators
library(dplyr)
library(tidyr)

result <- raw_data %>%
  filter(
    !is.na(value) &
      year >= 2020 &
      category %in% c("A", "B", "C")
  ) %>%
  group_by(
    region,
    category,
    quarter = paste0("Q", ceiling(month(date) / 3))
  ) %>%
  summarise(
    mean_value = mean(value, na.rm = TRUE),
    median_value = median(value, na.rm = TRUE),
    count = n(),
    .groups = "drop"
  ) %>%
  pivot_wider(
    names_from = quarter,
    values_from = c(mean_value, median_value, count),
    names_sep = "_"
  ) %>%
  mutate(
    total_mean = rowMeans(
      select(., starts_with("mean_value")),
      na.rm = TRUE
    ),
    variance_ratio = case_when(
      total_mean > 100 ~ "high",
      total_mean > 50 ~ "medium",
      TRUE ~ "low"
    )
  ) %>%
  arrange(desc(total_mean))
