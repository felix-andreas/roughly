#==== libraries
#---- r6_classes
Person <- R6Class(
    "Person",
    public = list(
        initialize = function(name, age = NA) {
            private$name <- name
            private$age <- age
        },

        print = function(...) {
            cat("Person: \n")
            cat("  Name: ", private$name, "\n", sep = "")
            cat("  Age:  ", private$age, "\n", sep = "")
        }
    ),

    private = list(
        age = NA,
        name = NULL
    )
)
#++++
Person <- R6Class(
  "Person",
  public = list(
    initialize = function(name, age = NA) {
      private$name <- name
      private$age <- age
    },

    print = function(...) {
      cat("Person: \n")
      cat("  Name: ", private$name, "\n", sep = "")
      cat("  Age:  ", private$age, "\n", sep = "")
    }
  ),

  private = list(
    age = NA,
    name = NULL
  )
)

#---- switch_fallthrough
switch(foo,
    x = 1,
    "y" = 2,
    z = ,
    3
)
#++++
switch(
  foo,
  x = 1,
  "y" = 2,
  z = ,
  3
)

#---- semicolons_in_function
function(x) {
    names(foo[[x]]) <- bar; foo[x]
}
#++++
function(x) {
  names(foo[[x]]) <- bar
  foo[x]
}

#---- data_table
ans <- flights[, .(arr_delay, dep_delay)]
DT[,.(V4.Sum=sum(V4)), by=V1][order(-V1)]
DT[,':='(V1=round(exp(V1),2), V2=LETTERS[4:6])][]
DT[,lapply(.SD,sum),by=V2, # comment
    .SDcols=c("V3","V4")]
#++++
ans <- flights[, .(arr_delay, dep_delay)]
DT[, .(V4.Sum = sum(V4)), by = V1][order(-V1)]
DT[, ":="(V1 = round(exp(V1), 2), V2 = LETTERS[4:6])][]
DT[
  ,
  lapply(.SD, sum),
  by = V2, # comment
  .SDcols = c("V3", "V4")
]

#---- dplyr
starwars %>% #foo
group_by(species)   %>% #bar
select(height, mass)%>% ###   baz
summarise(
        height = mean(height, na.rm = TRUE),
    mass = mean(mass, na.rm = TRUE)
)
#++++
starwars %>% # foo
  group_by(species) %>% # bar
  select(height, mass) %>% ###   baz
  summarise(
    height = mean(height, na.rm = TRUE),
    mass = mean(mass, na.rm = TRUE)
  )

#---- purrr
library(purrr)

        mtcars |>
    split(mtcars$cyl) |>  # from base R
map(\(df) lm(mpg~wt, data    = df)) |>
map(summary  ) |>
map_dbl("r.squared"  )
#++++
library(purrr)

mtcars |>
  split(mtcars$cyl) |> # from base R
  map(\(df) lm(mpg ~ wt, data = df)) |>
  map(summary) |>
  map_dbl("r.squared")

#---- s4_classes
setClass("Person",
    slots = list(
        name = "character",
        age = "numeric"
    ),
    prototype = list(
        name = character(0),
        age = numeric(0)
    )
)

setClass("Employee",
    contains = "Person",
    slots = list(
        department = "character",
        salary = "numeric"
    ),
    validity = function(object) {
        if (object@salary < 0) "Salary must be non-negative"
        else TRUE
    }
)
#++++
setClass(
  "Person",
  slots = list(
    name = "character",
    age = "numeric"
  ),
  prototype = list(
    name = character(0),
    age = numeric(0)
  )
)

setClass(
  "Employee",
  contains = "Person",
  slots = list(
    department = "character",
    salary = "numeric"
  ),
  validity = function(object) {
    if (object@salary < 0) {
      "Salary must be non-negative"
    } else {
      TRUE
    }
  }
)

#---- s4_generics
setGeneric("show", function(object) standardGeneric("show"))

setGeneric("getName", function(x) {
    standardGeneric("getName")
})

setGeneric("setName<-",
    function(x, value) standardGeneric("setName<-")
)
#++++
setGeneric("show", function(object) standardGeneric("show"))

setGeneric("getName", function(x) {
  standardGeneric("getName")
})

setGeneric(
  "setName<-",
  function(x, value) standardGeneric("setName<-")
)

#---- s4_methods
setMethod("show", "Person", function(object) {
    cat("Person object:\n")
    cat("  Name:", object@name, "\n")
    cat("  Age:", object@age, "\n")
})

setMethod("getName", "Person", function(x) x@name)

setMethod("setName<-", "Person",
    function(x, value) {
        x@name <- value
        x
    }
)
#++++
setMethod("show", "Person", function(object) {
  cat("Person object:\n")
  cat("  Name:", object@name, "\n")
  cat("  Age:", object@age, "\n")
})

setMethod("getName", "Person", function(x) x@name)

setMethod(
  "setName<-",
  "Person",
  function(x, value) {
    x@name <- value
    x
  }
)

#==== annotation_trailing_head
#---- trailing_head_renders_alone_continuations_keep_indent
f <- function() {
  x <- 1 #: list{
  #: a: integer
  #: }
  x
}
#++++
f <- function() {
  x <- 1 #: list{
  #: a: integer
  #: }
  x
}
