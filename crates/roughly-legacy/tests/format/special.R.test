#==== complex_expressions
#---- mixed_unary_binary
1 + +1 - -1 * -1 / -2
1++1--1*-1/-2
#++++
1 + +1 - -1 * -1 / -2
1 + +1 - -1 * -1 / -2

#---- chained_extract
foo$
    bar(a)$
    baz(a, b)

(foo
)$
    bar(a
    )$
    baz(a, b)$
#++++
foo$
  bar(a)$
  baz(a, b)

(foo)$
  bar(a)$
  baz(a, b)$

#---- multiline_conditions
if (any(
sapply(foo)
)) stop("")

if ( !foo ||
!bar ||
    !baz()
) stop("")

while(foo(
bar)) baz

while ({ foo; bar }) { baz }
while ({ foo;
bar }) { baz }

for (x in foo(
bar)) baz

for (
    variable
    in {
        sequence
    }) {}
#++++
if (any(
  sapply(foo)
)) {
  stop("")
}

if (!foo ||
  !bar ||
  !baz()) {
  stop("")
}

while (foo(
  bar
)) {
  baz
}

while ({ foo; bar }) {
  baz
}
while ({
  foo
  bar
}) {
  baz
}

for (x in foo(
  bar
)) {
  baz
}

for (
  variable
  in {
    sequence
  }
) {}

#---- complex_nesting
fn(fn(arg
))

fn(fn(
arg))

fn(fn(
arg
))

fn(fn(fn(
    arg
)))

fn(arg = fn(arg = fn(
    arg
)))
#++++
fn(fn(arg))

fn(fn(
  arg
))

fn(fn(
  arg
))

fn(fn(fn(
  arg
)))

fn(arg = fn(arg = fn(
  arg
)))

#---- operator_precedence
x + y * z
(x + y) * z
x + (y * z)
!x && y
!(x && y)
#++++
x + y * z
(x + y) * z
x + (y * z)
!x && y
!(x && y)

#---- pipeline_operators
foo |>
    bar

foo %>% bar %>%
        baz

foo |> # foo
#bar
bar |># bar
baz |>
    qux

foo |>
    # something about bar
    bar |>
    # something about baz
    baz
#++++
foo |>
  bar

foo %>% bar %>%
  baz

foo |> # foo
  # bar
  bar |> # bar
  baz |>
  qux

foo |>
  # something about bar
  bar |>
  # something about baz
  baz

