#==== newlines
#---- removes_consecutive_newlines
a


b

c
#++++
a

b

c

#==== directives
#---- fmt_skip
# fmt: skip
x+y
#++++
# fmt: skip
x+y

#---- fmt_skip_end_expression
c(
    1, 2,
    3, 4
) # fmt: skip
#++++
c(
    1, 2,
    3, 4
) # fmt: skip

#---- fmt_only_sub_expression
call(
    # fmt: skip
    a = c(
        1, 2,
        3, 4
    ),
    b=0
)
#++++
call(
  # fmt: skip
    a = c(
        1, 2,
        3, 4
    ),
  b = 0
)

#---- fmt_skip_keeps_first_line_column
f <- function() {
    m <- rbind(c(1,  2),
               c(30, 4)) # fmt: skip
}
#++++
f <- function() {
    m <- rbind(c(1,  2),
               c(30, 4)) # fmt: skip
}

#---- fmt_skip_file
# fmt: skip-file
x+y
#++++
# fmt: skip-file
x+y

#---- fmt_on_off
x+y

# fmt: off
x+y

# fmt: on
x+y
#++++
x + y

# fmt: off
x+y

# fmt: on
x + y

#---- fmt_off_preserves_columns
# fmt: off
x  <-  c(1,   2,
         30,  4)
# fmt: on
y<-1
#++++
# fmt: off
x  <-  c(1,   2,
         30,  4)
# fmt: on
y <- 1

#---- fmt_off_in_function
f <- function() {
  # fmt: off
    x+y
  # fmt: on
  z+1
}
#++++
f <- function() {
  # fmt: off
    x+y
  # fmt: on
  z + 1
}

