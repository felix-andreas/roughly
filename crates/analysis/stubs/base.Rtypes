# Standard-library stubs: base package.
#
# Declaration-only stub file (`.Rtypes`): each line is `name : <type-expr>`, reusing the `#:` annotation
# type grammar. There is no function body to write, so these files are declarations only.
#
# A "widened to Any" note marks a binding whose precise type the annotation grammar cannot yet express.
# Such a binding is deliberately given `Any` rather than a falsely-precise signature: a call then yields
# `Any`, which never produces a spurious type or arity error. The name still resolves, so it is never
# reported as undefined and never flagged by strict mode. Variadic functions and optional (dotted)
# arguments CAN now be expressed, so many former `Any` widenings carry real signatures.
#
# The arithmetic and comparison operators and the `c` / `list` constructors are NOT stubbed here: their
# result type is an algorithm over the argument types (numeric promotion, `NULL`-dropping combination,
# record synthesis) that a single declaration cannot describe, so they are modeled directly in the
# checker instead.

# Reserved value constants.
T : logical
F : logical
pi : double

# Length and sequence helpers: the result type is fixed by the function, independent of the argument's
# element type or shape.
length : fn(x: Any) -> integer
seq_len : fn(length.out: integer) -> integer[]
seq_along : fn(along_with: Any) -> integer[]

# Type predicates: always return a single logical.
is.null : fn(x: Any) -> logical
is.na : fn(x: Any) -> logical
is.numeric : fn(x: Any) -> logical
is.character : fn(x: Any) -> logical
is.logical : fn(x: Any) -> logical
is.function : fn(x: Any) -> logical
is.list : fn(x: Any) -> logical

# Coercions: the target atomic type is fixed by the function, not by the argument.
as.integer : fn(x: Any) -> integer
as.numeric : fn(x: Any) -> double
as.character : fn(x: Any) -> character
as.logical : fn(x: Any) -> logical

# Character scalars: the result atomic type is character (real R vectorizes over the input, but the
# element type is still fixed).
nchar : fn(x: character) -> integer
toupper : fn(x: character) -> character
tolower : fn(x: character) -> character
substr : fn(x: character, start: integer, stop: integer) -> character
startsWith : fn(x: character, prefix: character) -> logical
endsWith : fn(x: character, suffix: character) -> logical

# widened to Any: the result shape mirrors the argument shape. Expressing it needs a shape-preserving
# generic over vector element types, which is deferred pending the generic-vector design (see
# `.agents/memory/typing-design.md`); until then a concrete return type would be falsely precise.
rev : fn(x: Any) -> Any
abs : fn(x: Any) -> Any
sqrt : fn(x: Any) -> Any
sort : fn(x: Any) -> Any
unique : fn(x: Any) -> Any

# Variadic string joins: any number of arguments, coerced and concatenated to a character result.
# (R's `sep`/`collapse` controls are not modeled: mixing an optional named parameter with `...` would
# capture a leading positional argument by position, so they are omitted rather than risk a false
# error; a call still type-checks and yields `character`.)
paste : fn(...: Any) -> character
paste0 : fn(...: Any) -> character
cat : fn(...: Any) -> NULL

# Variadic numeric reductions: any number of numeric arguments reduce to a numeric result, with an
# optional `na.rm` matched by name. `range` returns the two-element min/max vector. The rest element is
# `Any` rather than `double` because the checker does not widen an `integer` argument to `double` at a
# parameter position (numeric promotion lives only in the operator kernel), so a `double` element would
# falsely reject `sum(1L, 2L)`; the precise result type is still declared.
sum : fn([na.rm]: logical, ...: Any) -> double
prod : fn([na.rm]: logical, ...: Any) -> double
min : fn([na.rm]: logical, ...: Any) -> double
max : fn([na.rm]: logical, ...: Any) -> double
range : fn([na.rm]: logical, ...: Any) -> double[]

# A required numeric argument with an optional `na.rm`. The argument is `Any` for the same reason the
# reductions above use `Any`: the checker does not widen `integer` to `double` at a parameter position.
mean : fn(x: Any, [na.rm]: logical) -> double

# String helpers with a character result. Vectorization over the input is not modeled (the element type
# is what matters), and the many optional arguments (`fixed`, `ignore.case`, `perl`, ...) are omitted.
trimws : fn(x: character) -> character
substring : fn(text: character, first: integer) -> character
# `sprintf`/`format` take a leading required argument then variadic extras. That leading argument is
# left unnamed (a plain positional) rather than named: the checker fills a variadic function's named
# parameters by name only, so a named leading parameter plus `...` would reject the positional call
# `sprintf("%d", 1L)`. A bare positional is matched first, and the rest flow into `...`.
sprintf : fn(character, ...: Any) -> character
format : fn(Any, ...: Any) -> character
gsub : fn(pattern: character, replacement: character, x: character) -> character
sub : fn(pattern: character, replacement: character, x: character) -> character
grepl : fn(pattern: character, x: character) -> logical

# `strsplit` splits each input string, returning one character vector per input, so a list of them.
strsplit : fn(x: character, split: character) -> list[character[]]

# Rounding: the result is a double regardless of the (numeric) input, with an optional digit count. The
# argument stays `Any` for the numeric-widening reason noted above (an `integer` argument at a `double`
# parameter would be falsely rejected).
round : fn(x: Any, [digits]: integer) -> double
signif : fn(x: Any, [digits]: integer) -> double
floor : fn(x: Any) -> double
ceiling : fn(x: Any) -> double
trunc : fn(x: Any) -> double

# Genuinely parametric list transforms. `lapply` maps each element through `f`, so the result is a list
# of `f`'s results. `Filter` keeps elements, preserving the element type. `Find` returns a matching
# element or `NULL`; `Position` returns its index or `NULL`. `Reduce` folds a list to a single value.
# These are the type system's payoff: a call over a typed list preserves or transforms the element type.
lapply : <T, U> fn(x: list[T], f: fn(T) -> U) -> list[U]
Filter : <T> fn(f: fn(T) -> logical, x: list[T]) -> list[T]
Find : <T> fn(f: fn(T) -> logical, x: list[T]) -> T | NULL
Position : <T> fn(f: fn(T) -> logical, x: list[T]) -> integer | NULL
Reduce : <T> fn(f: fn(T, T) -> T, x: list[T]) -> T

# `local(expr)` is recognized syntactically during lowering as a scope-introducing form (a fresh child
# environment; its type is the body's value), so a call in that shape never reaches this scheme. This
# binding only makes the bare name `local` resolve in other shapes (e.g. `local(expr, envir)` or an
# unapplied reference); its return is value-dependent, hence `Any`. Caveat: a user who rebinds `local`
# to their own function still gets the syntactic scoping treatment in v1.
local : Any

# widened to Any: a result whose shape or type varies by argument value, or optional arguments beyond
# what is modeled, which the grammar cannot yet express.
# - `grep` returns indices or matched values depending on `value=`.
# - `regmatches` returns a nested, extraction-mode-dependent structure.
# - `seq`/`rep` return types vary by which arguments are supplied.
# - `sapply` simplifies (or not) to a vector, matrix, or list depending on `f`'s results.
# - `vapply`/`mapply` need multi-argument or template-driven shapes not yet expressible.
# - `Map` applies over several lists in parallel (variadic list arguments).
grep : Any
regmatches : Any
seq : Any
rep : Any
sapply : Any
vapply : Any
mapply : Any
Map : Any

