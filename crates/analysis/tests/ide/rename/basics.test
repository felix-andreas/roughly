#==== global
#---- top_level_across_files
#---- R/a.R
value <- 1L
#++++ any
#---- R/b.R
result <- value
#++++ any
#!!!! rename global.rename
R/a.R:1:1 -> renamed
#++++
before:
R/a.R:
value <- 1L
R/b.R:
result <- value

after:
R/a.R:
renamed <- 1L
R/b.R:
result <- renamed

#==== params
#---- simple_parameter
#---- R/main.R
wrapper <- function(parameter) parameter
#++++ any
#!!!! rename parameter.rename
R/main.R:1:33 -> renamed
#++++
before:
R/main.R:
wrapper <- function(parameter) parameter

after:
R/main.R:
wrapper <- function(renamed) renamed

#---- outer_parameter_used_in_nested_function
#---- R/main.R
wrapper <- function(value) {
  inner <- function() value
  value
}
#++++ any
#!!!! rename nested_parameter.rename
R/main.R:2:23 -> renamed
#++++
before:
R/main.R:
wrapper <- function(value) {
  inner <- function() value
  value
}

after:
R/main.R:
wrapper <- function(renamed) {
  inner <- function() renamed
  renamed
}

#---- outer_parameter_shadowed_by_inner_parameter
#---- R/main.R
wrapper <- function(value) {
  inner <- function(value) value
  value
}
#++++ any
#!!!! rename shadowed_parameter.rename
R/main.R:1:21 -> renamed
#++++
before:
R/main.R:
wrapper <- function(value) {
  inner <- function(value) value
  value
}

after:
R/main.R:
wrapper <- function(renamed) {
  inner <- function(value) value
  renamed
}

