#==== loops
#---- simple_for_loop_variable
#---- R/main.R
wrapper <- function(values) {
  for (item in values) item
}
#++++ any
#!!!! rename for.rename
R/main.R:2:24 -> renamed
#++++
before:
R/main.R:
wrapper <- function(values) {
  for (item in values) item
}

after:
R/main.R:
wrapper <- function(values) {
  for (renamed in values) renamed
}

#---- for_loop_variable_shadowed_by_nested_parameter
#---- R/main.R
wrapper <- function(values) {
  for (item in values) {
    inner <- function(item) item
    item
  }
}
#++++ any
#!!!! rename shadowed_for.rename
R/main.R:4:5 -> renamed
#++++
before:
R/main.R:
wrapper <- function(values) {
  for (item in values) {
    inner <- function(item) item
    item
  }
}

after:
R/main.R:
wrapper <- function(values) {
  for (renamed in values) {
    inner <- function(item) item
    renamed
  }
}

