#==== control_flow
#---- block_if_while_repeat_switch
#---- R/main.R
wrapper <- function(x) {
  {
    block_value <- 1L
    block_v
  }
  if (TRUE) {
    if_value <- 1L
    if_v
  }
  while (TRUE) {
    while_value <- 1L
    while_v
  }
  repeat {
    repeat_value <- 1L
    repeat_v
  }
  switch(
    x,
    a = {
      switch_value <- 1L
      switch_v
    }
  )
}
