param 1: f: fn(T) -> U
active parameter: 0

#---- lapply_resolved_call_shows_instantiation
#---- R/main.R
result <- lapply(list(1L, 2L), function(item) item)
#++++ any
#!!!! signature_help lapply.sig
R/main.R:1:31
#++++
fn(x: list[integer], f: fn(integer) -> integer) -> list[integer]
param 0: x: list[integer]
param 1: f: fn(integer) -> integer
active parameter: 1

