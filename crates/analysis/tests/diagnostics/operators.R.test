#==== comparisons
#---- numeric_compared_to_character
1L < "a"
#++++
error[type-error] expected `integer`, found `character`
--> 1:1-1:9
| 1L < "a"

#---- logical_compared_to_numeric
TRUE > 1L
#++++
error[type-error] expected `logical`, found `integer`
--> 1:1-1:10
| TRUE > 1L

#---- list_comparison
list(1L) == list(1L)
#++++
error[type-error] expected a comparable value (numeric, `character`, or `logical`), found `list{integer}`
--> 1:1-1:9
| list(1L) == list(1L)

#==== negation
#---- not_on_integer
!1L
#++++
error[type-error] expected a `logical` value, found `integer`
--> 1:2-1:4
| !1L

#---- not_on_character
!"foo"
#++++
error[type-error] expected a `logical` value, found `character`
--> 1:2-1:7
| !"foo"

#==== ranges
#---- range_with_vector_operand
c(1L, 2L):3L
#++++
error[type-error] expected a scalar numeric value (`integer` or `double`), found `integer[]`
--> 1:1-1:10
| c(1L, 2L):3L

#---- range_with_character_operand
"a":2L
#++++
error[type-error] expected a scalar numeric value (`integer` or `double`), found `character`
--> 1:1-1:4
| "a":2L

#==== modulo
#---- modulo_with_character_operand
"a" %% 2L
#++++
error[type-error] expected a numeric value (`integer` or `double`), found `character`
--> 1:1-1:4
| "a" %% 2L
