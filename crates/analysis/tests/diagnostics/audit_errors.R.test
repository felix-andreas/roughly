#---- call_too_many_positional
identity <- function(x) x
identity(1L, 2L, 3L)
#++++
error[type-error] This call passes 3 positional argument(s), but the function accepts 1.
--> 2:1-2:9
| identity(1L, 2L, 3L)

#---- call_too_few_required
#: fn(a: integer, b: integer) -> integer
add <- function(a, b) a + b
add(1L)
#++++
error[type-error] This call passes 1 positional argument(s), but the function accepts 2.
--> 3:1-3:4
| add(1L)

