#==== special_types
#---- if_else_different_branches_accepted
if (TRUE) 1L else "foo"
#++++
No diagnostics.

#---- nullable_if_condition_must_be_scalar_logical
if (c(TRUE, FALSE)) 1L
#++++
error[type-error] expected `logical`, found `logical[]`
--> 1:5-1:19
| if (c(TRUE, FALSE)) 1L

#---- nullable_union_not_assignable_to_plain_type
#: integer
value <- if (TRUE) 1L
#++++
error[type-error] expected `integer`, found `integer | NULL`
--> 2:1-2:22
| value <- if (TRUE) 1L

#---- nullable_union_allows_null_branch
#: integer | NULL
value <- if (TRUE) 1L else NULL
#++++
No diagnostics.

#---- nullable_union_allows_null_literal
#: integer | NULL
value <- NULL
#++++
No diagnostics.

