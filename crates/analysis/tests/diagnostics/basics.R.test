#==== general
#---- empty_input
#++++
No diagnostics.

#---- valid_assignment
value <- 1L
#++++
No diagnostics.

#---- invalid_syntax
value <-
#++++
error[syntax-error] Syntax Error: missing rhs for operator <-
--> 1:7-1:9
| value <-

#==== names
#---- unknown_name
value
#++++
warning[naming] I could not resolve `value` in this package, its imports, or builtins.
--> 1:1-1:6
| value

#---- loop_body_binding_does_not_escape_loop_scope
for (item in list(1L)) {
  value <- "hello"
}
#: integer
other <- value
#++++
warning[naming] `value` might be undefined here because it is introduced only in conditionally executed code.
--> 5:10-5:15
| other <- value

error[type-error] expected `integer`, found `character`
--> 5:1-5:15
| other <- value

#---- duplicate_top_level_binding
x <- 1L
x <- 2L
#++++
warning[naming] Top-level binding `x` is overwritten by a later top-level binding in this package.
--> 1:1-1:8
| x <- 1L

warning[naming] Top-level binding `x` overwrites an earlier top-level binding in this package.
--> 2:1-2:8
| x <- 2L
