#: Person
value <- list(name = "bob")
#++++
error[type-error] expected `Person`, found `list{name: character}`
--> 4:1-4:28
| value <- list(name = "bob")

#---- distinct_nominal_mismatch_annotation
#: @type Cat {list{name: character}}
#: @type Dog {list{name: character}}

#: @new Cat
kit <- list(name = "felix")

#: Dog
d <- kit
#++++
error[type-error] expected `Dog`, found `Cat`
