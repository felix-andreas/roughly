#==== audit_nominal_new
#---- new_infers_atomic_parameter
#: @type Meters {double}

asMeters <- function(value) {
  #: @new Meters
  value
}
#++++
No diagnostics.

#---- new_with_incompatible_concrete_value
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = 1L)
#++++
error[type-error] expected `list{name: character}`, found `list{name: integer}`
--> 4:1-4:26
| person <- list(name = 1L)

#---- alias_after_new_is_error_not_nominal
#: @type Cat {list{name: character}}
#: @type Dog {list{name: character}}

#: fn(value: Cat) -> character
pet_cat <- function(value) value$name

#: @new Dog
dog <- list(name = "rex")
pet_cat(dog)
#++++
error[type-error] expected `Cat`, found `Dog`
--> 9:9-9:12
| pet_cat(dog)

#---- new_generic_missing_args
#: @type Box<T> {list{value: T}}

#: @new Box
b <- list(value = 1L)
#++++
error[syntax-error] Syntax Error: generic type `Box` expects 1 type argument(s), but found 0.
--> 3:1-3:12
| #: @new Box

#---- new_on_alias_is_error
#: @alias Shape {list{name: character}}

#: @new Shape
v <- list(name = "bob")
#++++
error[syntax-error] Syntax Error: invalid semantics: `@new` requires a nominal type declared with `@type`, but `Shape` is an alias.
--> 3:1-3:14
| #: @new Shape

#---- structural_value_to_nominal_param
#: @type Person {list{name: character}}

#: fn(value: Person) -> character
get_name <- function(value) value$name

get_name(list(name = "bob"))
#++++
error[type-error] expected `Person`, found `list{name: character}`
--> 6:10-6:28
| get_name(list(name = "bob"))

#---- nominal_checked_annotation_without_new
