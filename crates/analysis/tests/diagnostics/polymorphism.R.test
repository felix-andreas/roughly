#==== calls
#---- polymorphic_identity_multiple_types
mirror <- function(x) x
mirror(1L)
mirror("oops")
#++++
No diagnostics.

#---- polymorphic_assignment_multiple_types
mirror <- function(x) x
first <- mirror(1L)
second <- mirror("ok")
#++++
No diagnostics.

#---- polymorphic_repeated_independent_uses
mirror <- function(x) x
first <- mirror(1L)
second <- mirror("ok")
third <- mirror(2L)
#++++
No diagnostics.

#---- polymorphic_arity_after_valid_use
mirror <- function(x) x
mirror(1L)
mirror(1L, 2L)
#++++
error[type-error] This call passes 2 positional argument(s), but the function accepts 1.
--> 3:1-3:7
| mirror(1L, 2L)

#---- call_arity_after_polymorphic_assignment
mirror <- function(x) x
first <- mirror(1L)
mirror("ok", "extra")
#++++
error[type-error] This call passes 2 positional argument(s), but the function accepts 1.
--> 3:1-3:7
| mirror("ok", "extra")

#---- polymorphic_higher_order_apply
apply <- function(f) function(x) f(x)
mirror <- function(x) x
int_apply <- apply(mirror)
first <- int_apply(1L)
second <- int_apply("ok")
#++++
No diagnostics.

#---- polymorphic_higher_order_conflict
apply <- function(f) function(x) f(x + 1L)
mirror <- function(x) x
mixed_apply <- apply(mirror)
mixed_apply("ok")
#++++
error[type-error] expected a numeric value (`integer` or `double`), found `character`
--> 4:13-4:17
| mixed_apply("ok")

#---- numeric_polymorphic_accepts_integer_and_double
increment <- function(x) x + 1L
a <- increment(2L)
b <- increment(2.5)
#++++
No diagnostics.

#---- numeric_polymorphic_rejects_character
increment <- function(x) x + 1L
bad <- increment("oops")
#++++
error[type-error] expected a numeric value (`integer` or `double`), found `character`
--> 2:18-2:24
| bad <- increment("oops")
