#==== calls
#---- calling_non_function
value <- 1L
value(2L)
#++++
error[type-error] expected function, found `integer`
--> 2:1-2:6
| value(2L)

#---- call_arity_mismatch
identity <- function(x) x
identity(1L, 2L)
#++++
error[type-error] This call passes 2 positional argument(s), but the function accepts 1.
--> 2:1-2:9
| identity(1L, 2L)

#---- unknown_callee_in_call
missing(1L)
#++++
warning[unresolved] I could not resolve `missing` in this package, its imports, or builtins.
--> 1:1-1:8
| missing(1L)

#---- unknown_callee_after_valid_polymorphic_use
identity <- function(x) x
identity(1L)
missing(identity("ok"))
#++++
warning[unresolved] I could not resolve `missing` in this package, its imports, or builtins.
--> 3:1-3:8
| missing(identity("ok"))

#---- named_argument_not_in_interface
identity <- function(x) x
identity(y = 1L)
#++++
error[type-error] This call uses named argument(s) `y`, but the function accepts named parameter(s) `x`.
--> 2:1-2:17
| identity(y = 1L)

#---- missing_required_argument
#: fn(count: integer, label: character) -> character
describe <- function(count, label) label
describe(1L)
#++++
error[type-error] This call passes 1 positional argument(s), but the function accepts 2.
--> 3:1-3:9
| describe(1L)

#---- argument_type_mismatch_points_at_argument
#: fn(count: integer) -> integer
double_count <- function(count) count + count
double_count("two")
#++++
error[type-error] expected `integer`, found `character`
--> 3:14-3:19
| double_count("two")

#---- function_argument_contravariant_parameter_accepted
#: fn(callback: fn(integer) -> integer) -> integer
run <- function(callback) callback(1L)
#: fn(value: integer | NULL) -> integer
wider <- function(value) 1L
run(wider)
#++++
No diagnostics.

#---- function_argument_contravariant_parameter_rejected
#: fn(callback: fn(integer | NULL) -> integer) -> integer
run <- function(callback) 1L
#: fn(value: integer) -> integer
narrower <- function(value) value
run(narrower)
#++++
error[type-error] expected `fn(integer | NULL) -> integer`, found `fn(value: integer) -> integer`
--> 5:5-5:13
| run(narrower)

#==== defaults
#---- default_expression_internal_error
make <- function(value = "a" + 1L) value
#++++
error[type-error] expected a numeric value (`integer` or `double`), found `character`
--> 1:26-1:29
| make <- function(value = "a" + 1L) value

#---- annotated_non_null_default_incompatible
#: @param count {integer}
#: @return {integer}
describe <- function(count = "x") count
#++++
error[type-error] expected `integer`, found `character`
--> 3:30-3:33
| describe <- function(count = "x") count

#---- null_default_allowed_for_annotated_parameter
#: @param count {integer}
#: @param [label] {character}
#: @return {integer}
double_count <- function(count, label = NULL) count + count
#++++
No diagnostics.
