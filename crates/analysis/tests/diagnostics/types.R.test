#==== typing_comments
#---- missing_type_expression
#:
value <- 1L
#++++
error[syntax-error] A `#:` typing comment must include a type expression.
--> 1:1-1:3
| #:

#---- missing_following_expression
#: integer
#++++
error[syntax-error] A `#:` typing comment must be followed immediately by an expression.
--> 1:1-1:11
| #: integer

#---- empty_line_after_typing_comment
#: integer

value <- 1L
#++++
error[syntax-error] A `#:` typing comment cannot be separated from its expression by an empty line.
--> 1:1-1:11
| #: integer

#---- consecutive_typing_comments
#: integer
#: character
value <- 1L
#++++
error[syntax-error] invalid semantics: cannot use multiple compact annotations in the same `#:` block.
--> 1:1-2:13
| #: integer

#---- invalid_type_syntax
#: list{length:
value <- list(length = 1L)
#++++
error[syntax-error] type syntax error: expected a type. (while parsing field `length`)
--> 1:1-1:16
| #: list{length:

#---- missing_closing_paren
#: fn(integer
value <- function(x) x
#++++
error[syntax-error] type syntax error: expected `)` to close `fn(...)`.
--> 1:1-1:14
| #: fn(integer

#---- missing_closing_bracket
#: list[integer
value <- list(1L)
#++++
error[syntax-error] type syntax error: missing closing delimiter ]
--> 1:1-1:16
| #: list[integer

#---- missing_closing_brace
#: list{value: integer
value <- list(value = 1L)
#++++
error[syntax-error] type syntax error: expected `}` to close `list{...}`.
--> 1:1-1:23
| #: list{value: integer

#---- unknown_type
#: user_id
value <- 1L
#++++
error[syntax-error] type syntax error: unknown type `user_id`
--> 1:1-1:11
| #: user_id

#==== expanded_typing_comments
#---- expanded_missing_following_expression
#: @param {integer} count
#++++
error[syntax-error] A `#:` typing comment must be followed immediately by an expression.
--> 1:1-1:26
| #: @param {integer} count

#---- expanded_empty_line_after_typing_comment
#: @param {integer} count

render <- function(count) count
#++++
error[syntax-error] A `#:` typing comment cannot be separated from its expression by an empty line.
--> 1:1-1:26
| #: @param {integer} count

#---- expanded_invalid_type_syntax
#: @param {list{length:} count
render <- function(count) count
#++++
error[syntax-error] type syntax error: missing closing delimiter }
--> 1:1-1:31
| #: @param {list{length:} count

#---- expanded_missing_closing_brace
#: @param {list{length: integer} count
render <- function(count) count
#++++
error[syntax-error] type syntax error: missing closing delimiter }
--> 1:1-1:39
| #: @param {list{length: integer} count

#---- expanded_unknown_type
#: @param {user_id} count
render <- function(count) count
#++++
error[syntax-error] type syntax error: unknown type `user_id`
--> 1:1-1:26
| #: @param {user_id} count

#---- expanded_multiple_returns
#: @param {integer} count
#: @return {integer}
#: @returns {character}
render <- function(count) count
#++++
error[syntax-error] invalid semantics: cannot use more than one `@return` or `@returns` directive in the same `#:` block.
--> 1:1-3:24
| #: @param {integer} count

#---- expanded_param_after_return
#: @return {integer}
#: @param {integer} count
render <- function(count) count
#++++
error[syntax-error] invalid semantics: `@param` directives must appear before `@return` or `@returns` in the same `#:` block.
--> 1:1-2:26
| #: @return {integer}

#==== mixed_typing_comments
#---- compact_followed_by_expanded
#: integer
#: @param {integer} count
render <- function(count) count
#++++
error[syntax-error] invalid semantics: cannot mix compact and expanded annotations in the same `#:` block.
--> 1:1-2:26
| #: integer

#---- expanded_followed_by_compact
#: @param {integer} count
#: integer
render <- function(count) count
#++++
error[syntax-error] invalid semantics: cannot mix compact and expanded annotations in the same `#:` block.
--> 1:1-2:11
| #: @param {integer} count

#==== type_definitions
#---- definition_can_reference_previous_definition
#: @type Person {list{name: character}}
#: @type Team {list{owner: Person}}
value <- 1L
#++++
No diagnostics.

#---- definition_unknown_type
#: @type Team {list{owner: Person}}
value <- 1L
#++++
error[syntax-error] type syntax error: unknown type `Person`
--> 1:1-1:36
| #: @type Team {list{owner: Person}}

#---- nominal_introduction_rejects_alias
#: @alias Person {list{name: character}}
value <- 1L
#: @new Person
other <- list(name = "bob")
#++++
error[syntax-error] invalid semantics: `@new` requires a nominal type declared with `@type`, but `Person` is an alias.
--> 3:1-3:15
| #: @new Person

#---- type_definition_must_be_top_level
value <- {
  #: @type Person {list{name: character}}
  1L
}
#++++
error[syntax-error] Type definition blocks are only allowed at the top level of a file.
--> 2:3-2:42
|   #: @type Person {list{name: character}}
