#==== typing_comments
#---- missing_type_expression_with_following_expression
#:
value <- 1L
#++++
error[syntax-error] Syntax Error: A `#:` typing comment must include a type expression.
--> 1:1-1:3
| #:

#---- missing_following_expression
#: integer
#++++
error[syntax-error] Syntax Error: A `#:` typing comment must be followed immediately by an expression.
--> 1:1-1:11
| #: integer

#---- missing_following_expression_at_end_of_block
{
  #: integer
}
#++++
error[syntax-error] Syntax Error: A `#:` typing comment must be followed immediately by an expression.
--> 2:3-2:13
|   #: integer

#---- comment_after_typing_comment
#: integer
# regular comment
value <- 1L
#++++
error[syntax-error] Syntax Error: A `#:` typing comment must be followed immediately by an expression.
--> 1:1-1:11
| #: integer

#---- empty_line_after_typing_comment
#: integer

value <- 1L
#++++
error[syntax-error] Syntax Error: A `#:` typing comment cannot be separated from its expression by an empty line.
--> 1:1-1:11
| #: integer

#---- empty_line_before_normal_comment
