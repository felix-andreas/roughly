#==== control_flow
#---- block_simple
{
  1L
  2L
}
#++++
Block (trailing_semi: false)
  Integer("1L")
  Integer("2L")

#---- block_trailing_semicolon
{
  1L;
}
#++++
Block (trailing_semi: true)
  Integer("1L")

#---- if_statement
if (TRUE) 1L else 2L
#++++
If
  Logical(true)
  Integer("1L")
  Integer("2L")

#---- if_statement_no_else
if (FALSE) "no"
#++++
If
  Logical(false)
  Character("\"no\"")

#---- for_loop
for (i in 1:10) print(i)
#++++
For i
  Call
    Symbol(:)
    Argument:
      Double("1")
    Argument:
      Double("10")
  Call
    Symbol(print)
    Argument:
      Symbol(i)

#---- while_loop
while (TRUE) {
  break
}
#++++
While
  Logical(true)
  Block (trailing_semi: false)
    Unsupported

#---- repeat_loop
repeat {
  next
}
#++++
Repeat
  Block (trailing_semi: false)
    Unsupported
