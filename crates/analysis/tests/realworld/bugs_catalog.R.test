#==== true_positives
#---- union_arithmetic_without_a_guard
# The variable is integer | character at the use: real bug, must error.
parse_count <- function(raw) {
  count <- 0L
  if (raw == "unknown") {
    count <- "?"
  }
  count + 1L
}
#++++
error[type-error] expected a numeric value (`integer` or `double`), found `integer | character`
--> 7:3-7:8
|   count + 1L

#---- wrong_argument_type
#: fn(count: integer, label: character) -> character
render_row <- function(count, label) {
  paste0(label, ": ", count)
}
broken <- function() {
  render_row("three", 3L)
}
#++++
error[type-error] expected `integer`, found `character`
--> 6:14-6:21
|   render_row("three", 3L)

#---- missing_required_argument
#: fn(numerator: double, denominator: double) -> double
ratio <- function(numerator, denominator) {
  numerator / denominator
}
broken <- function() {
  ratio(1.0)
}
#++++
error[type-error] This call passes 1 positional argument(s), but the function accepts 2.
--> 6:3-6:8
|   ratio(1.0)

#---- unguarded_nullable_use
#: fn(x: integer | NULL) -> integer
increment <- function(x) {
  x + 1L
}
#++++
error[type-error] expected a numeric value (`integer` or `double`), found `integer | NULL`
--> 3:3-3:4
|   x + 1L

#---- calling_a_non_function
broken <- function() {
  total <- 10L
  total(2L)
}
#++++
error[type-error] expected function, found `integer`
--> 3:3-3:8
|   total(2L)

#---- post_dots_option_cannot_be_filled_positionally
# R runtime: "argument \"strict\" is missing, with no default" — formals after
# `...` are name-only, so the trailing TRUE lands in the dots.
join_fields <- function(..., strict) {
  if (strict) {
    paste(..., sep = ",")
  } else {
    paste(...)
  }
}
broken <- function() {
  join_fields("a", "b", TRUE)
}
#++++
error[type-error] This call passes 3 positional argument(s), but the function accepts 1.
--> 11:3-11:14
|   join_fields("a", "b", TRUE)

#---- typed_rest_parameter_rejects_a_wrong_element
#: fn(...: double) -> double
total_of <- function(...) {
  sum(...)
}
broken <- function() {
  total_of(1.5, "two")
}
#++++
error[type-error] expected `double`, found `character`
--> 6:17-6:22
|   total_of(1.5, "two")
