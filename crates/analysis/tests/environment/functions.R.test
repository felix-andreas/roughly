#==== scope
#---- rebinding_updates_environment
value <- 1L
value <- "ok"
value
#++++
value: integer
value: character
character

#---- alias_copies_generalized_scheme
identity <- function(x) x
alias <- identity
alias("ok")
#++++
identity: <T> fn(T) -> T
alias: <T> fn(T) -> T
character

#---- function_parameter_shadows_outer_binding
x <- 1L
f <- function(x) x
f("ok")
#++++
x: integer
f: <T> fn(T) -> T
character

#---- nested_function_uses_enclosing_binding
x <- 1L
f <- function() {
  g <- function() x
  g()
}
f()
#++++
x: integer
f: fn() -> integer
integer

#---- polymorphic_binding_reused_across_calls
identity <- function(x) x
first <- identity(1L)
second <- identity("ok")
#++++
identity: <T> fn(T) -> T
first: integer
second: character
