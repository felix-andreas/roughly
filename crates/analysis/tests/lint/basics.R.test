#==== general
#---- empty_input
#++++
No diagnostics.

#---- clean_input
snake_name <- function(value_name) {
  helper_name(value_name)
  TRUE
}
#++++
No diagnostics.

#---- short_true
snake_name <- T
#++++
warning[boolean-shorthand] Use TRUE, not T, for Boolean values
--> 1:15-1:16
| snake_name <- T

#---- assignment_equals
snake_name = 1L
#++++
warning[assignment-operator] Use <-, not =, for assignment
--> 1:1-1:16
| snake_name = 1L

#---- trailing_comma
snake_name(
  value_name,
)
#++++
error[trailing-comma] Unexpected comma after last argument
--> 2:13-2:14
|   value_name,

#==== naming_style
#---- snake_case_required_in_function
snake_name <- function(badParam) {
  badName <- 1L
}
#++++
warning[naming-style] Parameter `badParam` should have snake_case name, e.g. bad_param
--> 1:24-1:32
| snake_name <- function(badParam) {

warning[naming-style] Variable `badName` should have snake_case name, e.g. bad_name
--> 2:3-2:16
|   badName <- 1L

#==== suppression_comments
#---- allow_suppresses_a_lint_on_the_next_line
# roughly: allow(boolean-shorthand)
flag <- T
#++++
No diagnostics.

#---- allow_suppresses_a_trailing_lint_on_the_same_line
flag <- T # roughly: allow(boolean-shorthand)
#++++
No diagnostics.

#---- allow_with_a_different_code_does_not_suppress
# roughly: allow(naming-style)
flag <- T
#++++
warning[boolean-shorthand] Use TRUE, not T, for Boolean values
--> 2:9-2:10
| flag <- T

#---- allow_all_suppresses_everything_on_the_line
flag <- T # roughly: allow(all)
#++++
No diagnostics.
