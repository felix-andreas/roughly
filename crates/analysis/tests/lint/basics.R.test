#==== general
#---- empty_input
#++++
No diagnostics.

#---- clean_input
snake_name <- function(value_name) {
  helper_name(value_name)
  TRUE
}
#++++
No diagnostics.

#---- short_true
snake_name <- T
#++++
warning[lint] Use TRUE, not T, for Boolean values
--> 1:15-1:16
| snake_name <- T

#---- assignment_equals
snake_name = 1L
#++++
warning[lint] Use <-, not =, for assignment
--> 1:1-1:16
| snake_name = 1L

#---- trailing_comma
snake_name(
  value_name,
)
#++++
error[lint] Unexpected comma after last argument
--> 2:13-2:14
|   value_name,

#==== naming_style
#---- snake_case_required_in_function
snake_name <- function(badParam) {
  badName <- 1L
}
#++++
warning[lint] Parameter `badParam` should have snake_case name, e.g. bad_param
--> 1:24-1:32
| snake_name <- function(badParam) {

warning[lint] Variable `badName` should have snake_case name, e.g. bad_name
--> 2:3-2:16
|   badName <- 1L
