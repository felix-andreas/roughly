#==== s4_predicates
#---- extends_is_logical
extends("Speaker", "Person")
#++++
logical

#---- isVirtualClass_is_logical
isVirtualClass("Person")
#++++
logical

#---- isGeneric_is_logical
isGeneric("show")
#++++
logical

#---- existsMethod_and_hasMethod_are_logical
existsMethod("show", "Person")
hasMethod("show")
#++++
logical
logical

#==== s4_dynamic
#---- is_stays_any
is(1L, "integer")
#++++
Any

#---- new_with_arbitrary_slot_names_stays_any
new("Person", name = "bob")
#++++
Any

#---- setClass_machinery_stays_any
setClass("Person", representation(name = "character"))
#++++
Any

#---- validObject_mirrors_input_as_any
validObject(1L)
#++++
Any

#---- callNextMethod_stays_any
callNextMethod()
#++++
Any

#==== s4_slots
#---- slotNames_is_character_vector
slotNames("Person")
#++++
character[]

#---- standardGeneric_dispatches_as_any
standardGeneric("show")
#++++
Any
