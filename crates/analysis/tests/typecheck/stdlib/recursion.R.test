#==== monomorphic_recursion
#---- top_level_factorial_types
fact <- function(k) {
  if (k <= 1L) 1L else k * fact(k - 1L)
}
fact(5L)
#++++
fn(integer) -> integer
integer

#---- recursive_scheme_rejects_a_bad_argument
countdown <- function(x) if (x > 0L) countdown(x - 1L) else "done"
countdown("not an integer")
#++++
error: constraint violation

#---- local_recursive_helper_inside_a_function
driver <- function(n) {
  fact <- function(k) {
    if (k <= 1L) 1L else k * fact(k - 1L)
  }
  fact(n)
}
#++++
fn(n: integer) -> integer

#---- mutual_local_recursion_stays_refused
# Letrec visibility is per binding: `is_even`'s body references `is_odd` before any binding for
# it exists, which stays a loud refusal rather than a silent mistype. Top-level mutual recursion
# resolves through the package interface instead.
pair <- function() {
  is_even <- function(n) if (n == 0L) TRUE else is_odd(n - 1L)
  is_odd <- function(n) if (n == 0L) FALSE else is_even(n - 1L)
  is_even(4L)
}
#++++
error: unknown name
