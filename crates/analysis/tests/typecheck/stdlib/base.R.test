#==== values
#---- T_is_logical
T
#++++
logical

#---- F_is_logical
F
#++++
logical

#---- pi_is_double
pi
#++++
double

#---- pi_arithmetic_promotes_through_operator_kernel
pi / 2
#++++
double

#==== precise_base_calls
#---- length_of_vector_is_integer
length(c(1L, 2L, 3L))
#++++
integer

#---- nchar_is_integer
nchar("hello")
#++++
integer

#---- is_null_is_logical
is.null(NULL)
#++++
logical

#---- seq_len_is_integer_vector
seq_len(3L)
#++++
integer[]

#---- seq_along_is_integer_vector
seq_along(c(1L, 2L))
#++++
integer[]

#---- toupper_is_character
toupper("x")
#++++
character

#---- tolower_is_character
tolower("HELLO")
#++++
character

#---- is_na_is_logical
is.na(1L)
#++++
logical

#---- as_integer_is_integer
as.integer("3")
#++++
integer

#---- as_character_is_character
as.character(3L)
#++++
character

#---- as_numeric_is_double
as.numeric("3.5")
#++++
double

#---- substr_is_character
substr("hello", 1L, 3L)
#++++
character

#==== composition_with_kernel
#---- stub_result_feeds_operator_kernel
length(c(1L, 2L)) + 1L
#++++
integer

#---- value_binding_threads_through_assignment
flag <- T
flag
#++++
logical
logical

#==== precise_variadic_calls
#---- paste_of_many_arguments_is_character
paste("a", "b", "c")
#++++
character

#---- paste_of_zero_arguments_is_character
paste()
#++++
character

#---- cat_is_null
cat("a", "b")
#++++
NULL

#---- sum_of_many_arguments_is_double
sum(1L, 2L, 3L)
#++++
double

#---- min_of_many_arguments_is_double
min(1L, 2L, 3L)
#++++
double

#---- range_is_double_vector
range(1L, 2L, 3L)
#++++
double[]

#---- sum_accepts_named_na_rm_with_rest_arguments
sum(1, 2, na.rm = TRUE)
#++++
double

#---- mean_of_vector_is_double
mean(c(1L, 2L))
#++++
double

#---- mean_accepts_named_na_rm
mean(c(1, 2), na.rm = TRUE)
#++++
double

#==== degradation
#---- shape_polymorphic_rev_degrades_to_any
rev(c(1L, 2L, 3L))
#++++
Any

#---- shape_polymorphic_abs_degrades_to_any
abs(1L)
#++++
Any

#==== precise_strings
#---- trimws_is_character
trimws("  hi  ")
#++++
character

#---- substring_is_character
substring("hello", 1L)
#++++
character

#---- sprintf_variadic_is_character
sprintf("%d-%s", 1L, "a")
#++++
character

#---- gsub_is_character
gsub("a", "b", "banana")
#++++
character

#---- grepl_is_logical
grepl("a", "banana")
#++++
logical

#---- strsplit_is_list_of_character_vectors
strsplit("a,b", ",")
#++++
list[character[]]

#==== precise_math
#---- round_is_double
round(3.14159, 2L)
#++++
double

#---- floor_is_double
floor(3.7)
#++++
double

#---- signif_is_double
signif(3.14159, 3L)
#++++
double

#==== generic_apply
#---- lapply_preserves_element_type_via_mapper
#: list[character]
xs <- list("a", "b")
lapply(xs, toupper)
#++++
list[character]
list[character]

#---- lapply_maps_element_type_through_predicate
#: list[character]
words <- list("a", "b")
lapply(words, nchar)
#++++
list[character]
list[integer]

#---- filter_preserves_list_type
#: list[integer]
ns <- list(1L, 2L)
Filter(is.numeric, ns)
#++++
list[integer]
list[integer]

#---- find_returns_nullable_element
#: list[integer]
ns <- list(1L, 2L)
Find(is.numeric, ns)
#++++
list[integer]
integer | NULL

#---- position_returns_nullable_index
#: list[integer]
ns <- list(1L, 2L)
Position(is.numeric, ns)
#++++
list[integer]
integer | NULL

#==== still_any
#---- grep_stays_any
grep("a", "banana")
#++++
Any

#---- sapply_stays_any
sapply(list(1L), is.numeric)
#++++
Any

#==== precise_stats
#---- sd_is_double
sd(c(1, 2, 3))
#++++
double

#---- median_accepts_na_rm
median(c(1, 2), na.rm = TRUE)
#++++
double

#---- quantile_is_double_vector
quantile(c(1, 2, 3))
#++++
double[]

#---- rnorm_is_double_vector
rnorm(5L)
#++++
double[]

