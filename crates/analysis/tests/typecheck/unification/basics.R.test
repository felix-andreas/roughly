#==== basics
#---- scalar_literal
1L
#++++
integer

#---- assignment_then_call
identity <- function(x) x
identity(1L)
#++++
fn(x: ?1) -> ?1
integer

#==== mismatch_errors
#---- tuple_length_mismatch
#: list{integer}
value <- list(1L, 2L)
#++++
error: tuple length mismatch

#---- record_field_mismatch
#: list{left: integer}
value <- list(right = 1L)
#++++
error: record field mismatch

#==== unions
#---- null_join_keeps_variable_in_union
maybe <- function(flag, value) if (flag) value
#++++
fn(flag: logical, value: ?1) -> ?1 | NULL

#---- union_typed_argument_instantiates_scheme
maybe <- function(flag, value) if (flag) value
maybe(TRUE, 1L)
#++++
fn(flag: logical, value: ?1) -> ?1 | NULL
integer | NULL

#---- branch_join_falls_back_to_union
pick_label <- function(flag) if (flag) 1L else "one"
pick_label(TRUE)
#++++
fn(flag: logical) -> integer | character
integer | character
