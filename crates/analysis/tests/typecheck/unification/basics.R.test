#==== basics
#---- scalar_literal
1L
#++++
integer

#---- assignment_then_call
identity <- function(x) x
identity(1L)
#++++
fn(x: ?1) -> ?1
integer

#==== mismatch_errors
#---- tuple_length_mismatch
#: list{integer}
value <- list(1L, 2L)
#++++
error: tuple length mismatch

#---- record_field_mismatch
#: list{left: integer}
value <- list(right = 1L)
#++++
error: record field mismatch
