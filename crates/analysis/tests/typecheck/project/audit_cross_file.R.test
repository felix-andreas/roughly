#==== audit_cross_file
#---- polymorphic_identity_two_instantiations
#---- R/a.R
mirror <- function(value) value
#++++
No diagnostics.
#---- R/b.R
#: integer
a <- mirror(1L)

#: character
b <- mirror("x")
#++++
No diagnostics.

#---- partial_annotation_return_is_inferred_across_files
#---- R/a.R
#: @param count {integer}
add_one <- function(count) count + 1L
#++++
No diagnostics.
#---- R/b.R
#: integer
total <- add_one(2L) + 10L
#++++
No diagnostics.

#---- numeric_scheme_accepts_numeric
#---- R/a.R
add_one <- function(x) x + 1L
#++++
No diagnostics.
#---- R/b.R
#: integer
r <- add_one(2L)
#++++
No diagnostics.

#---- numeric_scheme_rejects_non_numeric
#---- R/a.R
add_one <- function(x) x + 1L
#++++
No diagnostics.
#---- R/b.R
r <- add_one("x")
#++++
error[type-error] expected a numeric value (`integer` or `double`), found `character`
--> 1:14-1:17
| r <- add_one("x")

