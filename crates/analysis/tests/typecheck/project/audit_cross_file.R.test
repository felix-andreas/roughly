No diagnostics.

#---- cross_file_positional_only_rejects_named
#---- R/a.R
#: fn(integer) -> integer
inc <- function(n) n + 1L
#++++
No diagnostics.
#---- R/b.R
r <- inc(n = 2L)
#++++
error[type-error] This call uses named argument(s) `n`, but the function accepts named parameter(s) <none>.
--> 1:6-1:17
| r <- inc(n = 2L)

#---- cross_file_optional_argument
