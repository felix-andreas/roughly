#---- cross_file_nominal_new_and_use
#---- R/a.R
#: @type Person {list{name: character}}

#: fn(value: Person) -> character
get_name <- function(value) value$name
#++++
No diagnostics.
#---- R/b.R
#: @new Person
person <- list(name = "bob")
result <- get_name(person)
#++++
No diagnostics.

#---- cross_file_nominal_rejects_structural_value
#---- R/a.R
#: @type Person {list{name: character}}

#: fn(value: Person) -> character
get_name <- function(value) value$name
#++++
No diagnostics.
#---- R/b.R
result <- get_name(list(name = "bob"))
#++++
error[type-error] expected `Person`, found `list{name: character}`
--> 1:20-1:38
| result <- get_name(list(name = "bob"))

