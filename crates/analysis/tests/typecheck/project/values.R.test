first <- 1L
#++++
No diagnostics.
#---- R/b.R
second <- first
#++++
No diagnostics.
#---- R/c.R
#: integer
check <- second
#++++
No diagnostics.

#---- function_wrapper_reexports_return_type
#---- R/a.R
base <- 10L
#++++
No diagnostics.
#---- R/b.R
get_base <- function() base
#++++
No diagnostics.
#---- R/c.R
#: integer
value <- get_base()
#++++
No diagnostics.

