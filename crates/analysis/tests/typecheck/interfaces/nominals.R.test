#==== nominal_exports
#---- nominal_type_and_introduced_value_export
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")
#++++
type Person = list{name: character}
person: Person

#---- generic_nominal_and_value_export
#: @type Box<T> {list{value: T}}

#: @new Box<integer>
box <- list(value = 1L)
#++++
type Box<T> = list{value: T}
box: Box<integer>

#---- nominal_constructor_export
#: @type Person {list{name: character}}

#: fn(name: character) -> Person
make_person <- function(name) {
  #: @new Person
  person <- list(name = name)
  person
}
#++++
type Person = list{name: character}
make_person: fn(name: character) -> Person
