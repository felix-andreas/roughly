#==== strict_composition_with_library_typing
#---- base_values_and_calls_are_strict_clean
#---- R/main.R
flag <- T
no_flag <- F
half <- pi / 2
count <- length(c(1L, 2L, 3L))
width <- nchar("hello")
ids <- seq_len(count)
#++++
warning[boolean-shorthand] Use TRUE, not T, for Boolean values
--> 1:9-1:10
| flag <- T

warning[boolean-shorthand] Use FALSE, not F, for Boolean values
--> 2:12-2:13
| no_flag <- F

#---- degraded_stub_yields_any_which_strict_tolerates
#---- R/main.R
joined <- paste("a", "b", "c")
reversed <- rev(c(1L, 2L, 3L))
#++++
No diagnostics.

#---- stub_call_is_clean_but_unsupported_construct_still_originates
#---- R/main.R
ok <- length(c(1L, 2L))
bad <- 1L %then% 2L
#++++
warning[strict] strict mode: could not determine the type of `bad`; add a type annotation
--> 2:8-2:20
| bad <- 1L %then% 2L

#---- shadowing_a_base_stub_reports_the_builtin_shadow_warning
#---- R/main.R
length <- function(x) 0L
#++++
warning[naming] Top-level binding `length` shadows a builtin.
--> 1:1-1:25
| length <- function(x) 0L
