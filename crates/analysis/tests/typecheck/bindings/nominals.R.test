#==== aliases
#---- alias_annotation_binding
#: @alias Count {integer}

#: Count
value <- 1L
#++++
value: integer

#---- generic_alias_annotation_binding
#: @alias Box<T> {list{value: T}}

#: Box<integer>
value <- list(value = 1L)
#++++
value: list{value: integer}

#==== nominals
#---- nominal_introduction_binding
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")
#++++
person: Person

#---- generic_nominal_introduction_binding
#: @type Person<T> {list{value: T}}

#: @new Person<integer>
person <- list(value = 1L)
#++++
person: Person<integer>

#---- nominal_value_rebound_as_underlying_shape
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")

#: list{name: character}
shape <- person
#++++
person: Person
shape: list{name: character}
