#==== aliases
#---- alias_annotation_binding
#: @alias Count {integer}

#: Count
value <- 1L
#++++
value: integer

#---- generic_alias_annotation_binding
#: @alias Box<T> {list{value: T}}

#: Box<integer>
value <- list(value = 1L)
#++++
value: list{value: integer}

#==== nominals
#---- nominal_introduction_binding
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")
#++++
person: Person

#---- generic_nominal_introduction_binding
#: @type Person<T> {list{value: T}}

#: @new Person<integer>
person <- list(value = 1L)
#++++
person: Person<integer>

#---- nominal_value_rebound_as_underlying_shape
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")

#: list{name: character}
shape <- person
#++++
person: Person
shape: list{name: character}

#---- nominal_checked_annotation_after_new
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")

#: Person
same <- person
#++++
person: Person
same: Person

#---- alias_of_nominal_value
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")
copy <- person
#++++
person: Person
copy: Person

#---- nominal_in_function_return_binding
#: @type Person {list{name: character}}

#: fn(name: character) -> Person
make_person <- function(name) {
  #: @new Person
  person <- list(name = name)
  person
}
#++++
make_person: fn(name: character) -> Person

#---- generic_nominal_nested_argument
#: @type Box<T> {list{value: T}}

#: @new Box<list{name: character}>
box <- list(value = list(name = "bob"))
#++++
box: Box<list{name: character}>

#---- new_annotation_on_block_final_expression
#: @type User {list{name: character, age: integer}}

#: fn(name: character, age: integer) -> User
createUser <- function(name, age) {
  #: @new User
  list(name = name, age = age)
}
#++++
createUser: fn(name: character, age: integer) -> User
