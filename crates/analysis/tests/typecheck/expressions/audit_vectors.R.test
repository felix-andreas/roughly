#==== audit_vectors
#---- c_single_integer
c(1L)
#++++
integer[]

#---- c_single_logical
c(TRUE)
#++++
logical[]

#---- c_single_character
c("a")
#++++
character[]

#---- c_single_double
c(1.5)
#++++
double[]

#---- c_partial_named_is_array
c(foo = 1L, 2L)
#++++
integer[]

#---- c_partial_named_promotes_double
c(foo = 1L, 2.5)
#++++
double[]

#---- c_all_named_promotes_double
c(a = 1L, b = 2.5)
#++++
double[named]

#---- c_nested_array_arg
c(c(1L, 2L))
#++++
integer[]

#---- c_nested_named_flatten
c(c(foo = 1L), c(bar = 2L))
#++++
integer[]

#---- c_array_plus_named_arg
c(c(1L, 2L), foo = 3L)
#++++
integer[]

#---- c_three_types_mismatch
c(1L, "a", TRUE)
#++++
character[]

#---- c_double_and_character
c(1.5, "a")
#++++
character[]

#---- c_logical_and_double
c(TRUE, 1.5)
#++++
double[]

#---- c_logical_named
c(yes = TRUE, no = FALSE)
#++++
logical[named]

#---- compare_named_map_loses_map
c(foo = 1L) == 1L
#++++
logical[]

#---- range_integer
1L:5L
#++++
integer[]

#---- range_whole_double_literals
1:5
#++++
integer[]

#---- range_double
1.5:3
#++++
double[]

#---- negate_logical_vector
!c(TRUE, FALSE)
#++++
logical[]

#---- negate_logical_named_loses_map
!c(yes = TRUE)
#++++
logical[]

#---- arith_named_plus_named
c(foo = 1L) + c(bar = 2L)
#++++
integer[]

#---- div_vector_scalar
c(1L, 2L) / 2L
#++++
double[]

#---- mult_double_by_array
2.5 * c(1L, 2L)
#++++
double[]

#---- scalar_to_named_map_rejected
#: integer[named]
value <- 1L
#++++
error: type mismatch

#---- array_to_named_map_rejected
#: integer[named]
value <- c(1L, 2L)
#++++
error: type mismatch

#---- named_map_to_named_map_ok
#: integer[named]
value <- c(foo = 1L)
value
#++++
integer[named]
integer[named]

#---- record_to_named_map_rejected_for_vectors
#: character[]
value <- c("a", "b")
value
#++++
character[]
character[]

#---- index_array_element
x <- c(1L, 2L)
x[[1]]
#++++
integer[]
integer

#---- index_scalar_element
x <- 1L
x[[1]]
#++++
integer
integer

#---- index_named_map_element
x <- c(foo = 1L, bar = 2L)
x[["foo"]]
#++++
integer[named]
integer | NULL

#---- and_logical_vector_rejected
c(TRUE, FALSE) && TRUE
#++++
error: type mismatch

#---- range_array_operand_rejected
c(1L, 2L):3L
#++++
error: invalid operand

#---- unary_minus_array
-c(1L, 2L)
#++++
integer[]

#---- c_single_named_is_map
c(foo = 1L)
#++++
integer[named]

#---- c_nested_single_named
c(c(foo = 1L))
#++++
integer[]

#---- compare_array_array
c(1L, 2L) == c(3L, 4L)
#++++
logical[]

#---- range_double_nonwhole
1.5:3.5
#++++
double[]

#---- power_scalar_by_array
2L ^ c(1L, 2L)
#++++
double[]

#---- c_scalar_and_array_mix
c(1L, c(2L, 3L))
#++++
integer[]

#---- compare_array_scalar
c(1L, 2L) > 1L
#++++
logical[]

#---- compare_array_cross_family
c(1L, 2L) < "a"
#++++
error: type mismatch

#---- unary_minus_named_map
-c(foo = 1L, bar = 2L)
#++++
integer[]

#---- sub_named_map_scalar
c(foo = 1L, bar = 2L) - 1L
#++++
integer[]

#---- c_three_numeric_promote
c(1L, 2.5, 3L)
#++++
double[]

