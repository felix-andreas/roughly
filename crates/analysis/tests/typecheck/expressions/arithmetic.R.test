#==== arithmetic
#---- integer_plus_integer
1L + 2L
#++++
integer

#---- integer_plus_double
1L + 2.5
#++++
double

#---- integer_minus_integer
2L - 1L
#++++
integer

#---- integer_times_double
2L * 1.5
#++++
double

#---- integer_div_integer
4L / 2L
#++++
double

#---- double_power_integer
2.5 ** 2L
#++++
double

#---- vector_plus_scalar
c(1L, 2L) + 4L
#++++
integer[]

#---- scalar_plus_vector
4L + c(1L, 2.5)
#++++
double[]

#---- named_map_plus_scalar_loses_map_likeness
c(foo = 1L, bar = 2L) + 4L
#++++
integer[]

#---- unary_minus_integer
-1L
#++++
integer

#---- unary_minus_vector
-c(1L, 2L)
#++++
integer[]

#---- unary_minus_named_map_loses_map_likeness
-c(foo = 1L, bar = 2L)
#++++
integer[]

#---- string_plus_integer
"foo" + 4L
#++++
error: invalid operand

#==== modulo_and_integer_division
#---- integer_modulo_integer
5L %% 2L
#++++
integer

#---- double_modulo_integer
5.5 %% 2L
#++++
double

#---- integer_division_integer
5L %/% 2L
#++++
integer

#---- integer_division_with_double
5L %/% 2.5
#++++
double

#---- vector_modulo_scalar
c(5L, 6L) %% 2L
#++++
integer[]

#---- character_modulo_is_rejected
"a" %% 2L
#++++
error: invalid operand

#==== power
#---- caret_is_power_operator
2L ^ 3L
#++++
double

#---- double_star_power
2L ** 3L
#++++
double

#---- vector_power
c(1L, 2L) ^ 2L
#++++
double[]

#==== unsupported_operators
#---- other_special_operator_is_unsupported
1L %o% 2L
#++++
Unknown

#---- tilde_formula_is_unsupported
1L ~ 2L
#++++
Unknown

#---- s4_slot_read_is_unknown_but_visits_the_subject
value <- 1L
value@slot
#++++
integer
Unknown

#---- s4_slot_read_still_surfaces_subject_errors
result <- (1L + "x")@slot
#++++
error: invalid operand

#==== whole_number_literal_operands
#---- double_literal_times_parameter_returns_double
# R semantics: `2` is a double literal, and double * integer is double at run time
# (`typeof(2 * 5L)` is "double"), so the inferred return is faithfully `double` — the
# whole-number-literal-counts-as-integer rule applies at parameter positions and `:` endpoints,
# deliberately NOT to arithmetic results. An integer-preserving double_it needs `2L * x`.
double_it <- function(x) 2 * x
double_it(5L)
#++++
fn(x: ?1) -> double
double

#---- integer_literal_times_parameter_preserves_integer
int_double_it <- function(x) 2L * x
int_double_it(5L)
#++++
fn(x: ?1) -> ?1
integer
