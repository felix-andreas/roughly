#==== arithmetic
#---- integer_plus_integer
1L + 2L
#++++
integer

#---- integer_plus_double
1L + 2.5
#++++
double

#---- integer_minus_integer
2L - 1L
#++++
integer

#---- integer_times_double
2L * 1.5
#++++
double

#---- integer_div_integer
4L / 2L
#++++
double

#---- double_power_integer
2.5 ** 2L
#++++
double

#---- vector_plus_scalar
c(1L, 2L) + 4L
#++++
integer[]

#---- scalar_plus_vector
4L + c(1L, 2.5)
#++++
double[]

#---- named_map_plus_scalar_loses_map_likeness
c(foo = 1L, bar = 2L) + 4L
#++++
integer[]

#---- unary_minus_integer
-1L
#++++
integer

#---- unary_minus_vector
-c(1L, 2L)
#++++
integer[]

#---- unary_minus_named_map_loses_map_likeness
-c(foo = 1L, bar = 2L)
#++++
integer[]

#---- string_plus_integer
"foo" + 4L
#++++
error: invalid operand

#==== modulo_and_integer_division
#---- integer_modulo_integer
5L %% 2L
#++++
integer

#---- double_modulo_integer
5.5 %% 2L
#++++
double

#---- integer_division_integer
5L %/% 2L
#++++
integer

#---- integer_division_with_double
5L %/% 2.5
#++++
double

#---- vector_modulo_scalar
c(5L, 6L) %% 2L
#++++
integer[]

#---- character_modulo_is_rejected
"a" %% 2L
#++++
error: invalid operand

#==== power
#---- caret_is_power_operator
2L ^ 3L
#++++
double

#---- double_star_power
2L ** 3L
#++++
double

#---- vector_power
c(1L, 2L) ^ 2L
#++++
double[]

#==== unsupported_operators
#---- other_special_operator_is_unsupported
1L %o% 2L
#++++
Unknown

#---- tilde_formula_is_unsupported
1L ~ 2L
#++++
Unknown
