#==== shadowing
#---- global_access
x <- 1L
f <- function() {
  x
}
#++++
integer
fn() -> integer

#---- local_shadows_global
x <- 1L
f <- function() {
  x <- "s"
  x
}
#++++
integer
fn() -> character

#---- argument_shadows_global
x <- 1L
f <- function(x) {
  x
}
#++++
integer
fn(x: ?1) -> ?1

#---- nested_function_access
f <- function() {
  x <- 1L
  g <- function() {
    x
  }
  g()
}
#++++
fn() -> integer

#---- nested_shadowing
f <- function() {
  x <- 1L
  g <- function() {
    x <- "s"
    x
  }
  g()
}
#++++
fn() -> character

#==== scope_visibility
#---- local_binding_does_not_escape
x <- 1L
f <- function() {
  x <- "ok"
  x
}
x
#++++
integer
fn() -> character
integer

#---- parameter_shadowing_preserves_outer_binding
x <- 1L
f <- function(x) x
x
f("ok")
#++++
integer
fn(x: ?1) -> ?1
integer
character

#---- nested_function_uses_enclosing_binding
x <- 1L
f <- function() {
  g <- function() x
  g()
}
f()
#++++
integer
fn() -> integer
integer
