#==== arithmetic
#---- numeric_union_accepted_member_wise
flag <- TRUE
x <- if (flag) 1L else 2.5
x + 1L
#++++
logical
integer | double
integer | double

#---- numeric_union_promotes_per_member
flag <- TRUE
x <- if (flag) 1L else 2.5
x + 1.5
#++++
logical
integer | double
double

#---- always_double_operator_collapses_union
flag <- TRUE
x <- if (flag) 1L else 2.5
x / 2L
#++++
logical
integer | double
double

#---- union_with_character_member_is_rejected
flag <- TRUE
x <- if (flag) 1L else "a"
x + 1L
#++++
error: invalid operand

#---- union_with_null_member_is_rejected
flag <- TRUE
x <- if (flag) 1L else NULL
x + 1L
#++++
error: invalid operand

#---- unary_minus_preserves_union
flag <- TRUE
x <- if (flag) 1L else 2.5
-x
#++++
logical
integer | double
integer | double

#---- vector_member_makes_pair_result_vector
flag <- TRUE
x <- if (flag) 1L else c(1.5, 2.5)
x + 1L
#++++
logical
integer | double[]
integer | double[]

#==== comparisons
#---- numeric_union_compares_member_wise
flag <- TRUE
x <- if (flag) 1L else 2.5
x > 0L
#++++
logical
integer | double
logical

#---- union_of_mixed_families_is_rejected
flag <- TRUE
x <- if (flag) 1L else "a"
x > 0L
#++++
error: type mismatch

#---- character_union_compares_within_family
flag <- TRUE
x <- if (flag) "a" else "b"
x > "a"
#++++
logical
character
logical

#==== iteration
#---- loop_variable_joins_union_of_vector_iterables
flag <- TRUE
items <- if (flag) c(1L, 2L) else c("a", "b")
for (item in items) item
#++++
logical
integer[] | character[]
NULL

#---- heterogeneous_list_element_arithmetic_is_member_wise
for (item in list(1L, 2.5)) item + 1L
#++++
NULL

#---- union_iterable_with_non_iterable_member_is_rejected
flag <- TRUE
items <- if (flag) c(1L, 2L) else function(x) x
for (item in items) item
#++++
error: type mismatch

#==== fields_and_elements
#---- shared_field_over_union_of_records
flag <- TRUE
rec <- if (flag) list(a = 1L) else list(a = 2L, b = "x")
rec$a
#++++
logical
list{a: integer} | list{a: integer, b: character}
integer

#---- field_with_differing_member_types_joins
flag <- TRUE
rec <- if (flag) list(a = 1L) else list(a = "x")
rec$a
#++++
logical
list{a: integer} | list{a: character}
integer | character

#---- field_missing_on_one_member_is_rejected
flag <- TRUE
rec <- if (flag) list(a = 1L) else list(b = "x")
rec$b
#++++
error: field does not exist

#---- subset2_over_union_of_lists
flag <- TRUE
items <- if (flag) list(1L, 2L) else list("a")
items[[1L]]
#++++
logical
list{integer, integer} | list{character}
integer | character

#---- subset_over_union_of_lists
flag <- TRUE
items <- if (flag) list(1L, 2L) else list("a")
items[1L]
#++++
logical
list{integer, integer} | list{character}
list[integer] | list[character]

