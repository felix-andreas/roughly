#==== vector_shapes
#---- logical_array
c(TRUE, FALSE)
#++++
logical[]

#---- integer_array
c(1L, 2L, 3L)
#++++
integer[]

#---- double_array
c(1.5, 2.5)
#++++
double[]

#---- integer_and_double_array_promotes_to_double
c(1L, 2.5)
#++++
double[]

#---- character_array
c("foo", "bar")
#++++
character[]

#---- logical_named_map
c(yes = TRUE, no = FALSE)
#++++
logical[named]

#---- integer_named_map
c(foo = 1L, bar = 2L)
#++++
integer[named]

#---- character_named_map
c(x = "foo", y = "bar")
#++++
character[named]

#==== vector_annotations
#---- scalar_checked_annotation_coerces_to_array
#: integer[]
value <- 1L
value
#++++
integer[]
integer[]

#---- named_map_checked_annotation_coerces_to_array
#: integer[]
value <- c(foo = 1L, bar = 2L)
value
#++++
integer[]
integer[]

#---- reverse_array_to_scalar_annotation_is_rejected
#: integer
value <- c(1L, 2L)
#++++
error: type mismatch

#---- reverse_array_to_named_map_annotation_is_rejected
#: integer[named]
value <- c(1L, 2L)
#++++
error: type mismatch

#==== combine_edge_cases
#---- empty_combine_is_null
c()
#++++
NULL

#---- nested_combine_flattens
c(c(1L, 2L), 3L)
#++++
integer[]

#---- combine_promotes_named_map_argument
c(c(foo = 1L), 2.5)
#++++
double[]

#---- combine_of_logical_and_integer_is_rejected
c(TRUE, 1L)
#++++
error: type mismatch

#---- combine_of_list_is_rejected
c(list(1L), 2L)
#++++
error: type mismatch
