#==== literals
#---- logical_literal_true
TRUE
#++++
logical

#---- logical_literal_false
FALSE
#++++
logical

#---- integer_literal
1L
#++++
integer

#---- double_literal
1.5
#++++
double

#---- character_literal
"hello"
#++++
character

#---- null_literal
NULL
#++++
NULL

#==== names_and_assignments
#---- known_name_after_assignment
value <- 1L
value
#++++
integer
integer

#---- assignment_expression_returns_assigned_type
other <- (value <- 1L)
value
other
#++++
integer
integer
integer

#---- rebinding_updates_name_type
value <- 1L
value <- "hello"
value
#++++
integer
character
character

#---- unknown_name
missing_value
#++++
error: unknown name

#==== blocks
#---- empty_block
{ }
#++++
NULL

#---- block_returns_last_expression_type
{
  1L
  2L
}
#++++
integer

#---- block_with_trailing_semicolon_returns_null
{
  1L;
}
#++++
NULL

#---- block_returns_unknown_when_last_expression_is_unknown
{
  1L
  1L ~ 2L
}
#++++
Unknown
