#==== explicit_special_types
#---- any_annotation_accepts_integer
#: Any
value <- 1L
value
#++++
Any
Any

#---- any_annotation_accepts_null
#: Any
value <- NULL
value
#++++
Any
Any

#---- any_annotation_accepts_unknown
#: Any
value <- 1L ~ 2L
value
#++++
Any
Any

#---- unsupported_construct_infers_unknown
1L ~ 2L
#++++
Unknown

#---- unknown_only_coercion_accepts_unknown
#: @if-unknown integer
value <- 1L ~ 2L
value
#++++
integer
integer

#---- unknown_only_coercion_rejects_known_type
#: @if-unknown integer
value <- 1L
#++++
error: type mismatch

#---- trusted_coercion_overrides_incompatible_source
#: @trust integer
value <- "hello"
value
#++++
integer
integer

#---- checked_annotation_rejects_unknown
#: integer
value <- 2L ^ 3L
#++++
error: type mismatch

#==== nullable_unions
#---- nullable_union_annotation_accepts_integer
#: integer | NULL
value <- 1L
value
#++++
integer | NULL
integer | NULL

#---- nullable_union_annotation_accepts_null
#: integer | NULL
value <- NULL
value
#++++
integer | NULL
integer | NULL

#---- nullable_union_not_assignable_to_plain_integer
#: integer
value <- if (TRUE) 1L
#++++
error: type mismatch
