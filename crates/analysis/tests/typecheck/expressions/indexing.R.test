#==== vector_indexing
#---- scalar_vector_double_bracket_returns_element
value <- 1L
value[[1L]]
#++++
integer
integer

#---- array_vector_double_bracket_returns_element
c(1L, 2L, 3L)[[1L]]
#++++
integer

#---- named_vector_name_lookup_is_nullable
c(foo = 1L, bar = 2L)[["foo"]]
#++++
integer | NULL

#==== list_indexing
#---- tuple_literal_position_returns_element_type
list(1L, "foo")[[2L]]
#++++
character

#---- tuple_nonliteral_position_is_rejected
index <- 2L
list(1L, "foo")[[index]]
#++++
error: non-literal subscript

#---- record_literal_name_returns_field_type
list(foo = 1L, bar = "foo")[["bar"]]
#++++
character

#---- record_missing_field_is_rejected
list(foo = 1L)[["bar"]]
#++++
error: field does not exist

#---- array_like_list_double_bracket_returns_element
#: list[integer]
value <- list(1L, 2L)
value[[1L]]
#++++
list[integer]
integer

#---- map_like_list_name_lookup_is_nullable
#: list[named: integer]
value <- list(foo = 1L, bar = 2L)
value[["foo"]]
#++++
list[named: integer]
integer | NULL

#---- array_like_list_bracket_returns_array_like_list
#: list[integer]
value <- list(1L, 2L)
value[1L]
#++++
list[integer]
list[integer]

#---- map_like_list_bracket_returns_map_like_list
#: list[named: integer]
value <- list(foo = 1L, bar = 2L)
value["foo"]
#++++
list[named: integer]
list[named: integer]

#---- tuple_bracket_coerces_to_array_like_list
list(1L, 2L, 3L)[1L]
#++++
list[integer]

#---- record_bracket_coerces_to_map_like_list
list(foo = 1L, bar = 2L)["foo"]
#++++
list[named: integer]

#---- dollar_name_is_record_lookup_sugar
list(foo = 1L, bar = 2L)$foo
#++++
integer

#==== unsupported_indexing
#---- bracket_on_scalar_vector_is_rejected
value <- 1L
value[1L]
#++++
error: unsupported `[` subset

#---- bracket_on_array_vector_is_rejected
c(1L, 2L)[1L]
#++++
error: unsupported `[` subset

#---- bracket_on_named_vector_is_rejected
c(foo = 1L)[["foo"]]
c(foo = 1L)["foo"]
#++++
error: unsupported `[` subset

#---- double_bracket_on_function_is_rejected
f <- function(x) x
f[[1L]]
#++++
error: not a list

#==== boundary_cases
#---- tuple_out_of_bounds_literal_position_is_rejected
list(1L, "foo")[[3L]]
#++++
error: position does not exist

#---- named_vector_positional_index_returns_element
c(foo = 1L, bar = 2L)[[1L]]
#++++
integer

#---- dollar_on_map_like_list_is_nullable
#: list[named: integer]
values <- list(foo = 1L, bar = 2L)
values$foo
#++++
list[named: integer]
integer | NULL

#---- dollar_on_named_vector_is_rejected
counts <- c(foo = 1L, bar = 2L)
counts$foo
#++++
error: dollar on atomic vector

#---- dollar_missing_record_field_is_rejected
list(foo = 1L)$bar
#++++
error: field does not exist

#---- chained_record_access
config <- list(server = list(port = 8080L))
config$server$port
#++++
list{server: list{port: integer}}
integer

#==== double_literal_position
#---- tuple_double_literal_position_returns_element
list(1L, "foo", TRUE)[[2]]
#++++
character
