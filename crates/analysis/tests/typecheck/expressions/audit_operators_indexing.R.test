#==== audit_operators_indexing
#---- comparison_le_character
"a" <= "b"
#++++
logical

#---- comparison_ge_double
2.5 >= 1L
#++++
logical

#---- comparison_logical_ordering
TRUE < FALSE
#++++
logical

#---- comparison_character_vectors
c("a", "b") < c("c", "d")
#++++
logical[]

#---- comparison_both_map_like_loses_map
c(a = 1L) == c(b = 2L)
#++++
logical[]

#---- comparison_integer_double_mix_vector
c(1L, 2L) >= 1.5
#++++
logical[]

#---- comparison_logical_vs_character_rejected
TRUE == "a"
#++++
error: type mismatch

#---- comparison_against_null_rejected
1L == NULL
#++++
error: invalid operand

#---- and_chained
TRUE && FALSE && TRUE
#++++
logical

#---- or_with_vector_right_rejected
TRUE || c(FALSE, TRUE)
#++++
error: type mismatch

#---- and_of_comparisons
(1L < 2L) && (2L < 3L)
#++++
logical

#---- not_double_negation
!!TRUE
#++++
logical

#---- not_map_like_loses_map
!c(yes = TRUE, no = FALSE)
#++++
logical[]

#---- not_null_rejected
!NULL
#++++
error: invalid operand

#---- and_non_logical_rejected
1L && TRUE
#++++
error: type mismatch

#==== audit_operators_indexing_idx
#---- double_bracket_scalar_vector
x <- 1L
x[[1L]]
#++++
integer
integer

#---- double_bracket_array_vector
c(1.5, 2.5)[[1L]]
#++++
double

#---- double_bracket_named_vector_name_nullable
c(foo = 1L)[["foo"]]
#++++
integer | NULL

#---- double_bracket_named_vector_positional
c(foo = 1L, bar = 2L)[[2L]]
#++++
integer

#---- double_bracket_tuple_literal_position
list(1L, "foo", TRUE)[[2L]]
#++++
character

#---- double_bracket_tuple_out_of_bounds
list(1L, "foo")[[5L]]
#++++
error: type mismatch

#---- double_bracket_tuple_nonliteral_rejected
i <- 1L
list(1L, "foo")[[i]]
#++++
error: type mismatch

#---- double_bracket_record_literal_name
list(foo = 1L, bar = "x")[["foo"]]
#++++
integer

#---- double_bracket_record_missing_name_rejected
list(foo = 1L)[["missing"]]
#++++
error: type mismatch

#---- double_bracket_array_list
#: list[integer]
v <- list(1L, 2L)
v[[1L]]
#++++
list[integer]
integer

#---- double_bracket_map_list_name_nullable
#: list[named: integer]
v <- list(foo = 1L)
v[["foo"]]
#++++
list[named: integer]
integer | NULL

#---- bracket_array_list_returns_array_list
#: list[integer]
v <- list(1L, 2L)
v[1L]
#++++
list[integer]
list[integer]

#---- bracket_map_list_returns_map_list
#: list[named: integer]
v <- list(foo = 1L)
v["foo"]
#++++
list[named: integer]
list[named: integer]

#---- bracket_tuple_coerces_to_array_list
list(1L, 2L, 3L)[2L]
#++++
list[integer]

#---- bracket_record_coerces_to_map_list
list(foo = 1L, bar = 2L)["bar"]
#++++
list[named: integer]

#---- bracket_heterogeneous_tuple_rejected
list(1L, "foo")[1L]
#++++
error: type mismatch

#---- bracket_on_scalar_vector_rejected
y <- 1L
y[1L]
#++++
error: type mismatch

#---- bracket_on_array_vector_rejected
c(1L, 2L)[1L]
#++++
error: type mismatch

#---- dollar_record_field
list(foo = 1L, bar = "x")$foo
#++++
integer

#---- dollar_missing_record_field_rejected
list(foo = 1L)$bar
#++++
error: type mismatch

#---- dollar_tuple_list_rejected
list(1L, 2L)$foo
#++++
error: type mismatch

#---- dollar_map_list_nullable
#: list[named: integer]
v <- list(foo = 1L)
v$foo
#++++
list[named: integer]
integer | NULL

#---- dollar_named_vector_nullable
c(foo = 1L, bar = 2L)$foo
#++++
integer | NULL

#---- double_bracket_on_function_rejected
f <- function(x) x
f[[1L]]
#++++
error: type mismatch

#---- chained_double_bracket_nested_list
#: list[list[integer]]
v <- list(list(1L), list(2L))
v[[1L]][[1L]]
#++++
list[list[integer]]
integer

#---- chained_dollar_record
cfg <- list(a = list(b = 2L))
cfg$a$b
#++++
list{a: list{b: integer}}
integer

#==== audit_operators_indexing_nominal
#---- nominal_dollar_projects
#: @type Person {list{name: character}}

#: @new Person
p <- list(name = "bob")
p$name
#++++
Person
character

#---- nominal_double_bracket_projects
#: @type Person {list{name: character, age: integer}}

#: @new Person
p <- list(name = "bob", age = 3L)
p[["age"]]
#++++
Person
integer

#---- nominal_arithmetic_projects
#: @type Meters {double}

#: @new Meters
h <- 1.8
h + h
#++++
Meters
double

#---- nominal_comparison_projects
#: @type Meters {double}

#: @new Meters
h <- 1.8
h < 2.0
#++++
Meters
logical

#---- nominal_bracket_projects_array_list
#: @type Bag {list[integer]}

#: @new Bag
b <- list(1L, 2L)
b[1L]
#++++
Bag
list[integer]

