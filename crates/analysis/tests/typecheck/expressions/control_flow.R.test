#==== if_expressions
#---- if_without_else_integer_branch
if (TRUE) 1L
#++++
integer | NULL

#---- if_without_else_empty_block
if (TRUE) { }
#++++
NULL

#---- if_else_matching_integer_branches
if (TRUE) 1L else 2L
#++++
integer

#---- if_else_integer_and_null
if (TRUE) 1L else NULL
#++++
integer | NULL

#---- if_else_null_and_integer
if (TRUE) NULL else 2L
#++++
integer | NULL

#---- if_else_both_empty_blocks
if (TRUE) { } else { }
#++++
NULL

#---- if_else_different_branches_union
if (TRUE) 1L else "foo"
#++++
integer | character

#---- if_else_union_flows_into_binding
flag <- TRUE
value <- if (flag) 1L else "foo"
value
#++++
logical
integer | character
integer | character

#---- if_condition_must_be_scalar_logical
if (c(TRUE, FALSE)) 1L else 2L
#++++
error: type mismatch

#==== boolean_operators
#---- scalar_logical_and
TRUE && FALSE
#++++
logical

#---- scalar_logical_or
flag <- TRUE
other_flag <- FALSE
flag || other_flag
#++++
logical
logical
logical

#---- vector_logical_and_is_rejected
c(TRUE, FALSE) && TRUE
#++++
error: type mismatch

#==== loops
#---- for_over_scalar_vector_returns_null
for (item in 1L) item
#++++
NULL

#---- for_over_tuple_like_list_returns_null
for (item in list(1L, 2L)) item
#++++
NULL

#---- while_returns_null
while (TRUE) { }
#++++
NULL

#---- while_condition_must_be_scalar_logical
while (c(TRUE, FALSE)) { }
#++++
error: type mismatch

#---- repeat_returns_null
repeat { }
#++++
NULL

#==== if_normalization
#---- if_without_else_null_branch_stays_null
if (TRUE) NULL
#++++
NULL

#---- if_without_else_nullable_branch_stays_single_nullable
flag <- TRUE
value <- if (flag) 1L
if (flag) value
#++++
logical
integer | NULL
integer | NULL

#---- if_else_same_nullable_branches
flag <- TRUE
left <- if (flag) 1L
right <- if (flag) 2L
if (flag) left else right
#++++
logical
integer | NULL
integer | NULL
integer | NULL

#---- negated_condition
flag <- TRUE
if (!flag) 1L else 2L
#++++
logical
integer

#---- comparison_condition
count <- 3L
if (count > 2L) "big" else "small"
#++++
integer
character

#==== loop_iteration_types
#---- for_over_range_binds_element_type
total <- 0L
for (index in 1L:3L) {
  total <- total + index
}
#++++
integer
NULL

#---- for_over_record_like_list
for (field in list(foo = 1L, bar = 2L)) field
#++++
NULL

#---- for_over_map_like_list_annotation
#: list[named: integer]
values <- list(foo = 1L, bar = 2L)
for (value in values) value
#++++
list[named: integer]
NULL

#---- for_body_uses_element_type_in_typed_call
#: fn(count: integer) -> integer
double_count <- function(count) count + count
for (count in c(1L, 2L)) double_count(count)
#++++
fn(count: integer) -> integer
NULL

#---- for_over_heterogeneous_tuple_allowed
for (item in list(1L, "foo")) item
#++++
NULL

#---- for_over_empty_list_allowed
for (item in list()) item
#++++
NULL

#---- for_over_heterogeneous_named_list_allowed
for (item in list(a = 1L, b = "two")) item
#++++
NULL

#---- for_element_union_usable_at_union_parameter
#: fn(value: integer | character) -> logical
accepts <- function(value) TRUE
for (item in list(a = 1L, b = "two")) accepts(item)
#++++
fn(value: integer | character) -> logical
NULL

#---- for_element_union_rejected_at_member_parameter
#: fn(count: integer) -> integer
double_count <- function(count) count + count
for (item in list(a = 1L, b = "two")) double_count(item)
#++++
error: type mismatch

#---- for_over_function_is_rejected
for (item in function(x) x) item
#++++
error: type mismatch

#==== branch_unification
#---- unknown_branch_propagates
u <- 1L ~ 2L
if (TRUE) 1L else u
#++++
Unknown
Unknown

#==== variable_joins
#---- conditional_retype_joins_with_prior_state
flag <- TRUE
x <- 1L
if (flag) x <- "a"
x
#++++
logical
integer
character | NULL
integer | character

#---- both_branches_retype_join_without_prior_state_member
flag <- TRUE
x <- 1L
if (flag) x <- "a" else x <- 2L
x
#++++
logical
integer
character | integer
character | integer

#---- same_type_rewrite_keeps_single_type
flag <- TRUE
x <- 1L
if (flag) x <- 2L
x
#++++
logical
integer
integer | NULL
integer

#---- loop_accumulator_stays_integer
total <- 0L
for (i in 1:3) {
  total <- total + i
}
total
#++++
integer
NULL
integer

#---- loop_rewrite_joins_across_iterations
flag <- TRUE
x <- 1L
while (flag) {
  x <- "a"
}
x
#++++
logical
integer
NULL
integer | character

#---- repeat_division_widens_to_double
x <- 1L
repeat {
  x <- x / 2
}
x
#++++
integer
NULL
double

#---- structurally_growing_loop_slot_widens_to_unknown
x <- 1L
repeat {
  x <- list(x)
}
x
#++++
integer
NULL
Unknown
