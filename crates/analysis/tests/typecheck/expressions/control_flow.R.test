#==== if_expressions
#---- if_without_else_integer_branch
if (TRUE) 1L
#++++
integer | NULL

#---- if_without_else_empty_block
if (TRUE) { }
#++++
NULL

#---- if_else_matching_integer_branches
if (TRUE) 1L else 2L
#++++
integer

#---- if_else_integer_and_null
if (TRUE) 1L else NULL
#++++
integer | NULL

#---- if_else_null_and_integer
if (TRUE) NULL else 2L
#++++
integer | NULL

#---- if_else_both_empty_blocks
if (TRUE) { } else { }
#++++
NULL

#---- if_else_branch_mismatch
if (TRUE) 1L else "foo"
#++++
error: type mismatch

#---- if_condition_must_be_scalar_logical
if (c(TRUE, FALSE)) 1L else 2L
#++++
error: type mismatch

#==== boolean_operators
#---- scalar_logical_and
TRUE && FALSE
#++++
logical

#---- scalar_logical_or
flag <- TRUE
other_flag <- FALSE
flag || other_flag
#++++
logical
logical
logical

#---- vector_logical_and_is_rejected
c(TRUE, FALSE) && TRUE
#++++
error: type mismatch

#==== loops
#---- for_over_scalar_vector_returns_null
for (item in 1L) item
#++++
NULL

#---- for_over_tuple_like_list_returns_null
for (item in list(1L, 2L)) item
#++++
NULL

#---- while_returns_null
while (TRUE) { }
#++++
NULL

#---- while_condition_must_be_scalar_logical
while (c(TRUE, FALSE)) { }
#++++
error: type mismatch

#---- repeat_returns_null
repeat { }
#++++
NULL

#==== if_normalization
#---- if_without_else_null_branch_stays_null
if (TRUE) NULL
#++++
NULL

#---- if_without_else_nullable_branch_stays_single_nullable
flag <- TRUE
value <- if (flag) 1L
if (flag) value
#++++
logical
integer | NULL
integer | NULL

#---- if_else_same_nullable_branches
flag <- TRUE
left <- if (flag) 1L
right <- if (flag) 2L
if (flag) left else right
#++++
logical
integer | NULL
integer | NULL
integer | NULL

#---- negated_condition
flag <- TRUE
if (!flag) 1L else 2L
#++++
logical
integer

#---- comparison_condition
count <- 3L
if (count > 2L) "big" else "small"
#++++
integer
character

#==== loop_iteration_types
#---- for_over_range_binds_element_type
total <- 0L
for (index in 1L:3L) {
  total <- total + index
}
#++++
integer
NULL

#---- for_over_record_like_list
for (field in list(foo = 1L, bar = 2L)) field
#++++
NULL

#---- for_over_map_like_list_annotation
#: list[named: integer]
values <- list(foo = 1L, bar = 2L)
for (value in values) value
#++++
list[named: integer]
NULL

#---- for_body_uses_element_type_in_typed_call
#: fn(count: integer) -> integer
double_count <- function(count) count + count
for (count in c(1L, 2L)) double_count(count)
#++++
fn(count: integer) -> integer
NULL

#---- for_over_heterogeneous_tuple_is_rejected
for (item in list(1L, "foo")) item
#++++
error: type mismatch

#---- for_over_function_is_rejected
for (item in function(x) x) item
#++++
error: type mismatch
