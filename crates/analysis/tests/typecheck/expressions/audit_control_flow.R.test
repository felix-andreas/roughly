#==== audit_control_flow
#---- if_without_else_double
if (TRUE) 1.5
#++++
double | NULL

#---- if_without_else_character
if (TRUE) "x"
#++++
character | NULL

#---- if_without_else_logical
if (TRUE) FALSE
#++++
logical | NULL

#---- if_without_else_vector_branch
if (TRUE) c(1L, 2L)
#++++
integer[] | NULL

#---- if_without_else_null_literal
if (TRUE) NULL
#++++
NULL

#---- if_without_else_block_last_expr
if (TRUE) {
  1L
}
#++++
integer | NULL

#---- if_without_else_block_trailing_semicolon
if (TRUE) {
  1L;
}
#++++
NULL

#---- if_else_double_branches
if (TRUE) 1.5 else 2.5
#++++
double

#---- if_else_character_branches
if (TRUE) "a" else "b"
#++++
character

#---- if_else_both_null
if (TRUE) NULL else NULL
#++++
NULL

#---- if_else_vector_branches
if (TRUE) c(1L, 2L) else c(3L, 4L)
#++++
integer[]

#---- if_else_mismatch_integer_double
if (TRUE) 1L else 2.5
#++++
error: type mismatch

#---- if_else_mismatch_character_integer
if (TRUE) "a" else 1L
#++++
error: type mismatch

#---- if_condition_integer_rejected
if (1L) 1L else 2L
#++++
error: type mismatch

#---- if_condition_character_rejected
if ("x") 1L else 2L
#++++
error: type mismatch

#---- if_else_nested_in_else
if (TRUE) 1L else if (FALSE) 2L else 3L
#++++
integer

#---- if_value_assigned_nullable
result <- if (TRUE) 1L
result
#++++
integer | NULL
integer | NULL

#---- if_else_value_assigned
result <- if (TRUE) 1L else 2L
result
#++++
integer
integer

#---- if_branch_is_assignment
flag <- TRUE
if (flag) x <- 1L
x
#++++
logical
integer | NULL
integer

