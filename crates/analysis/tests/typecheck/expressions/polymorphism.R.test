#==== let_polymorphism
#---- identity_instantiates_at_multiple_types
identity <- function(x) x
first <- identity(1L)
second <- identity("hello")
#++++
fn(x: ?1) -> ?1
integer
character

#---- repeated_polymorphic_instantiations_remain_independent
identity <- function(x) x
first <- identity(1L)
second <- identity("hello")
third <- identity(2L)
#++++
fn(x: ?1) -> ?1
integer
character
integer

#---- aliased_polymorphic_function_remains_polymorphic
identity <- function(x) x
alias <- identity
first <- alias(1L)
second <- alias("hello")
#++++
fn(x: ?1) -> ?1
fn(x: ?1) -> ?1
integer
character

#---- higher_order_polymorphic_identity
identity <- function(x) x
apply_once <- function(f, value) f(value)
first <- apply_once(identity, 1L)
second <- apply_once(identity, "hello")
#++++
fn(x: ?1) -> ?1
fn(f: fn(?1) -> ?2, value: ?1) -> ?2
integer
character

#---- constant_function_instantiates_across_argument_types
const_integer <- function(x) 1L
const_integer(1L)
const_integer("hello")
#++++
fn(x: ?1) -> integer
integer
integer

#---- repeated_fresh_instantiation_in_higher_order_calls
apply <- function(f, value) f(value)
const_integer <- function(x) 1L
identity <- function(x) x
apply(const_integer, "hello")
apply(identity, 1L)
apply(identity, "hello")
#++++
fn(f: fn(?1) -> ?2, value: ?1) -> ?2
fn(x: ?1) -> integer
fn(x: ?1) -> ?1
integer
integer
character

#---- solved_returned_function_keeps_outer_argument_type
apply_left <- function(x) function(f) f(x)
use_integer <- apply_left(1L)
use_integer(function(value) 1L)
#++++
fn(x: ?1) -> fn(f: fn(?1) -> ?2) -> ?2
fn(f: fn(integer) -> ?1) -> ?1
integer

#==== explicit_foralls
#---- compact_forall_identity_instantiates
#: <T> fn(value: T) -> T
identity <- function(value) value
identity(1L)
identity("hello")
#++++
fn(value: ?1) -> ?1
integer
character

#---- expanded_forall_identity_instantiates
#: @forall T
#: @param value {T}
#: @return {T}
identity <- function(value) value
identity(1L)
identity("hello")
#++++
fn(value: ?1) -> ?1
integer
character

#---- forall_two_parameters_keep_left
#: <T, U> fn(left: T, right: U) -> T
keep_left <- function(left, right) left
keep_left(1L, "x")
keep_left("x", 1L)
#++++
fn(left: ?1, right: ?2) -> ?1
integer
character

#---- forall_nullable_return
#: <T> fn(condition: logical, value: T) -> T | NULL
then_some <- function(condition, value) {
  if (condition) value
}
then_some(TRUE, 1L)
then_some(FALSE, "x")
#++++
fn(condition: logical, value: ?1) -> ?1 | NULL
integer | NULL
character | NULL

#---- forall_higher_order_application
#: <T, U> fn(transform: fn(T) -> U, value: T) -> U
apply_once <- function(transform, value) transform(value)

#: fn(count: integer) -> character
render <- function(count) "ok"
apply_once(render, 1L)
#++++
fn(transform: fn(?1) -> ?2, value: ?1) -> ?2
fn(count: integer) -> character
character

#==== generic_vector_elements
#---- forall_vector_element_preserves_atomic
#: <T> fn(x: T[]) -> T[]
same <- function(x) x
same(c(1L, 2L))
same(c("a", "b"))
#++++
fn(x: ?1[]) -> ?1[]
integer[]
character[]

#---- forall_vector_element_accepts_scalar_coercion
#: <T> fn(x: T[]) -> T[]
same <- function(x) x
same(2.5)
#++++
fn(x: ?1[]) -> ?1[]
double[]

#---- forall_vector_element_rejects_list
#: <T> fn(x: T[]) -> T[]
same <- function(x) x
same(list(1L, 2L))
#++++
error: type mismatch

#---- forall_vector_element_used_arithmetically
#: <T> fn(x: T[]) -> T[]
same <- function(x) x
same(c(1L, 2L)) + 1L
#++++
fn(x: ?1[]) -> ?1[]
integer[]

#---- forall_vector_element_extraction
#: <T> fn(x: T[]) -> T
first_of <- function(x) x[[1L]]
first_of(c("a", "b"))
#++++
fn(x: ?1[]) -> ?1
character

#---- vector_suffix_rejects_non_atomic_element
#: @alias Person {list{name: character}}

#: fn(x: Person[]) -> NULL
f <- function(x) NULL
#++++
error: invalid vector element
