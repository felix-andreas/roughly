#==== nominal_introduction
#---- nominal_introduction_rejects_alias
#---- R/main.R
#: @alias Person {list{name: character}}
value <- 1L
#: @new Person
other <- list(name = "bob")
#++++
TypeAlias(Person = list{name: character})
Assign(value@b0)
  Integer(1L)
Assign(other@b1)
  Call
    Symbol(list@?)
    Argument(name)
      Character("\"bob\"")

error[syntax-error] Syntax Error: invalid semantics: `@new` requires a nominal type declared with `@type`, but `Person` is an alias.
--> 3:1-3:15
| #: @new Person

