#==== locals
#---- local_assignment_introduces_fresh_binding
#---- R/main.R
f <- function() {
  value <- 1L
  value
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(value@b1)
        Integer(1L)
      Symbol(value@b1)

#---- local_rebinding_creates_fresh_binding
#---- R/main.R
f <- function() {
  value <- 1L
  value <- "ok"
  value
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(value@b1)
        Integer(1L)
      Assign(value@b1)
        Character("\"ok\"")
      Symbol(value@b1)

#---- assignment_rhs_sees_outer_parameter_before_local_rebinding
#---- R/main.R
f <- function(x) {
  x <- x
  x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(x@b1)
        Symbol(x@b1)
      Symbol(x@b1)

#---- local_assignment_shadows_top_level_binding
#---- R/main.R
x <- 1L
f <- function() {
  x <- "ok"
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Assign(x@b2)
        Character("\"ok\"")
      Symbol(x@b2)

#---- local_assignment_rebinds_parameter_name
#---- R/main.R
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Symbol(x@b1)

#---- assignment_rhs_can_use_other_outer_binding_while_rebinding_different_name
#---- R/main.R
x <- 1L
f <- function(y) {
  x <- y
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function(y@b2)
    Block
      Assign(x@b3)
        Symbol(y@b2)
      Symbol(x@b3)

#---- local_assignment_beats_final_package_global_winner
#---- R/a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)

warning[naming] Top-level binding `x` is overwritten by a later top-level binding in this package.
--> 1:1-1:8
| x <- 1L
note: the later binding is here. --> R/b.R:1:1
#---- R/b.R
x <- 2L
#++++
Assign(x@b1)
  Integer(2L)

warning[naming] Top-level binding `x` overwrites an earlier top-level binding in this package.
--> 1:1-1:8
| x <- 2L
note: the earlier binding is here. --> R/a.R:1:1
#---- R/c.R
f <- function() {
  x <- 3L
  x
}
#++++
Assign(f@b2)
  Function()
    Block
      Assign(x@b3)
        Integer(3L)
      Symbol(x@b3)
