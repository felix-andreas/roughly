#==== top_level
#---- top_level_reference
#---- R/main.R
x <- 1L
x
#++++
Assign(x@b0)
  Integer(1L)
Symbol(x@b0)

#---- top_level_reference_before_first_binding
#---- R/main.R
x
x <- 1L
#++++
Symbol(x@b0)
Assign(x@b0)
  Integer(1L)

#---- top_level_call_resolves_callee_and_argument
#---- R/main.R
value <- 1L
mirror <- function(x) x
mirror(value)
#++++
Assign(value@b0)
  Integer(1L)
Assign(mirror@b1)
  Function(x@b2)
    Symbol(x@b2)
Call
  Symbol(mirror@b1)
  Argument
    Symbol(value@b0)

#---- distinct_top_level_bindings_have_distinct_uses
#---- R/main.R
x <- 1L
y <- "ok"
x
y
#++++
Assign(x@b0)
  Integer(1L)
Assign(y@b1)
  Character("\"ok\"")
Symbol(x@b0)
Symbol(y@b1)

#==== rebinding
#---- top_level_rebinding_creates_fresh_binding
#---- R/main.R
x <- 1L
x <- "ok"
x
#++++
Assign(x@b0)
  Integer(1L)
Assign(x@b1)
  Character("\"ok\"")
Symbol(x@b1)

warning[naming] Top-level binding `x` is overwritten by a later top-level binding in this package.
--> 1:1-1:8
| x <- 1L
note: the later binding is here. --> R/main.R:2:1

warning[naming] Top-level binding `x` overwrites an earlier top-level binding in this package.
--> 2:1-2:10
| x <- "ok"
note: the earlier binding is here. --> R/main.R:1:1

#---- earlier_use_resolves_to_final_global_binding
#---- R/main.R
x <- 1L
x
x <- "ok"
x
#++++
Assign(x@b0)
  Integer(1L)
Symbol(x@b1)
Assign(x@b1)
  Character("\"ok\"")
Symbol(x@b1)

warning[naming] Top-level binding `x` is overwritten by a later top-level binding in this package.
--> 1:1-1:8
| x <- 1L
note: the later binding is here. --> R/main.R:3:1

warning[naming] Top-level binding `x` overwrites an earlier top-level binding in this package.
--> 3:1-3:10
| x <- "ok"
note: the earlier binding is here. --> R/main.R:1:1

#---- assignment_rhs_resolves_to_final_global_binding
#---- R/main.R
x <- 1L
x <- x
x
#++++
Assign(x@b0)
  Integer(1L)
Assign(x@b1)
  Symbol(x@b1)
Symbol(x@b1)

