#==== parameters
#---- parameter_shadows_outer_binding
#---- R/main.R
x <- 1L
f <- function(x) x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function(x@b2)
    Symbol(x@b2)

#==== locals
#---- local_assignment_shadows_outer_binding
#---- R/main.R
x <- 1L
f <- function() {
  x <- "ok"
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Assign(x@b2)
        Character("\"ok\"")
      Symbol(x@b2)

#---- local_assignment_shadows_parameter
#---- R/main.R
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Symbol(x@b1)

#==== nested_functions
#---- nested_function_parameter_shadows_enclosing_binding
#---- R/main.R
f <- function() {
  x <- 1L
  g <- function(x) x
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(x@b1)
        Integer(1L)
      Assign(g@b2)
        Function(x@b3)
          Symbol(x@b3)

#---- nested_function_local_shadows_enclosing_binding
#---- R/main.R
f <- function(x) {
  g <- function() {
    x <- "ok"
    x
  }
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(g@b2)
        Function()
          Block
            Assign(x@b3)
              Character("\"ok\"")
            Symbol(x@b3)

#---- multi_hop_nested_function_uses_nearest_shadowing_binding
#---- R/main.R
x <- 1L
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    h <- function() x
  }
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Assign(x@b2)
        Character("\"outer\"")
      Assign(g@b3)
        Function()
          Block
            Assign(x@b4)
              Logical(true)
            Assign(h@b5)
              Function()
                Symbol(x@b4)

#---- repeated_shadow_chain
#---- R/main.R
x <- 1L
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function(x@b2)
    Block
      Assign(x@b2)
        Character("\"ok\"")
      Symbol(x@b2)

#==== for_loops
#---- for_variable_shadows_outer_binding_inside_loop
#---- R/main.R
x <- 1L
for (x in list(1L)) {
  x
}
x
#++++
Assign(x@b0)
  Integer(1L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Symbol(x@b1)
Symbol(x@b1)

#==== cross_file_rebinding
#---- later_file_rebinding_wins_for_later_files
#---- R/a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)

warning[naming] Top-level binding `x` is overwritten by a later top-level binding in this package.
--> 1:1-1:8
| x <- 1L
note: the later binding is here. --> R/b.R:1:1
#---- R/b.R
x <- x
#++++
Assign(x@b1)
  Symbol(x@b1)

warning[naming] Top-level binding `x` overwrites an earlier top-level binding in this package.
--> 1:1-1:7
| x <- x
note: the earlier binding is here. --> R/a.R:1:1
#---- R/c.R
x
#++++
Symbol(x@b1)

