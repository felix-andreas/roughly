#==== parameters
#---- function_parameter_referenced_in_body
#---- R/main.R
mirror <- function(x) x
#++++
Assign(mirror@b0)
  Function(x@b1)
    Symbol(x@b1)

#---- multiple_parameters_referenced_in_order
#---- R/main.R
pair <- function(x, y) {
  x
  y
}
#++++
Assign(pair@b0)
  Function(x@b1, y@b2)
    Block
      Symbol(x@b1)
      Symbol(y@b2)

#---- unused_parameter_still_introduces_binding
#---- R/main.R
mirror <- function(x, y) x
#++++
Assign(mirror@b0)
  Function(x@b1, y@b2)
    Symbol(x@b1)

#---- parameter_referenced_after_local_statement
#---- R/main.R
mirror <- function(x) {
  helper <- 1L
  x
}
#++++
Assign(mirror@b0)
  Function(x@b1)
    Block
      Assign(helper@b2)
        Integer(1L)
      Symbol(x@b1)

#---- parameter_shadows_top_level_binding
#---- R/main.R
x <- 1L
f <- function(x) x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function(x@b2)
    Symbol(x@b2)

#---- nested_function_closes_over_enclosing_parameter
#---- R/main.R
f <- function(x) {
  g <- function() x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(g@b2)
        Function()
          Symbol(x@b1)

#---- local_assignment_later_shadows_parameter
#---- R/main.R
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Symbol(x@b1)

#---- function_body_uses_global_when_parameter_does_not_match
#---- R/main.R
x <- 1L
f <- function(y) x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function(y@b2)
    Symbol(x@b0)

#---- parameter_beats_final_package_global_winner
#---- R/a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)

warning[naming] Top-level binding `x` is overwritten by a later top-level binding in this package.
--> 1:1-1:8
| x <- 1L
note: the later binding is here. --> R/b.R:1:1
#---- R/b.R
x <- 2L
#++++
Assign(x@b1)
  Integer(2L)

warning[naming] Top-level binding `x` overwrites an earlier top-level binding in this package.
--> 1:1-1:8
| x <- 2L
note: the earlier binding is here. --> R/a.R:1:1
#---- R/c.R
f <- function(x) x
#++++
Assign(f@b2)
  Function(x@b3)
    Symbol(x@b3)
