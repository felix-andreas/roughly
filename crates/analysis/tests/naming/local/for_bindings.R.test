#==== for_loops
#---- for_variable_introduces_fresh_binding
for (x in list(1L)) {
  x
}
#++++
For(x@b0)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Symbol(x@b0)

No diagnostics.

#---- loop_body_resolves_other_outer_binding
y <- 1L
for (x in list(1L)) {
  y
}
#++++
Assign(y@b0)
  Integer(1L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Symbol(y@?)

No diagnostics.

#---- assignment_inside_loop_rhs_sees_loop_binding
x <- 0L
for (x in list(1L)) {
  x <- x
  x
}
x
#++++
Assign(x@b0)
  Integer(0L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Assign(x@b2)
      Symbol(x@b1)
    Symbol(x@b2)
Symbol(x@?)

No diagnostics.

#---- assignment_inside_loop_rhs_can_use_other_outer_binding
y <- 0L
for (x in list(1L)) {
  y <- y
  y
}
y
#++++
Assign(y@b0)
  Integer(0L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Assign(y@b2)
      Symbol(y@?)
    Symbol(y@b2)
Symbol(y@?)

No diagnostics.

#---- nested_closure_inside_loop_captures_loop_binding
for (x in list(1L)) {
  g <- function() x
}
#++++
For(x@b0)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Assign(g@b1)
      Function()
        Symbol(x@b0)

No diagnostics.

#---- for_variable_shadows_outer_top_level_binding
x <- 1L
for (x in list(1L)) {
  x
}
x
#++++
Assign(x@b0)
  Integer(1L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Symbol(x@b1)
Symbol(x@?)

No diagnostics.
