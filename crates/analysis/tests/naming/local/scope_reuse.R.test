#==== blocks
#---- nested_block_uses_nearest_binding
x <- 1L
f <- function() {
  x <- "ok"
  {
    x
  }
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b2)
  Function()
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Block
        Symbol(x@b1)

No diagnostics.

#---- braces_do_not_restore_outer_binding
x <- 1L
f <- function() {
  {
    x <- "ok"
  }
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b2)
  Function()
    Block
      Block
        Assign(x@b1)
          Character("\"ok\"")
      Symbol(x@b1)

No diagnostics.

#---- binding_inside_braces_remains_visible_after_braces
f <- function() {
  {
    x <- 1L
  }
  x
}
#++++
Assign(f@b1)
  Function()
    Block
      Block
        Assign(x@b0)
          Integer(1L)
      Symbol(x@b0)

No diagnostics.

#---- nested_braces_reuse_same_scope_chain
f <- function() {
  {
    x <- 1L
    {
      x
    }
  }
  x
}
#++++
Assign(f@b1)
  Function()
    Block
      Block
        Assign(x@b0)
          Integer(1L)
        Block
          Symbol(x@b0)
      Symbol(x@b0)

No diagnostics.

#---- braces_inside_loop_do_not_restore_pre_loop_binding
x <- 0L
for (x in list(1L)) {
  {
    x <- 2L
  }
  x
}
x
#++++
Assign(x@b0)
  Integer(0L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Block
      Assign(x@b1)
        Integer(2L)
    Symbol(x@b1)
Symbol(x@b1)

No diagnostics.

#---- assignment_inside_loop_body_remains_visible_later_in_same_body
for (item in list(1L)) {
  value <- 1L
  value
}
#++++
For(item@b0)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Assign(value@b1)
      Integer(1L)
    Symbol(value@b1)

No diagnostics.

#---- nested_block_resolves_outer_global_when_unshadowed
x <- 1L
f <- function() {
  {
    x
  }
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Block
        Symbol(x@?)

No diagnostics.
