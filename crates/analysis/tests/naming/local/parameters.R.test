#==== parameters
#---- function_parameter_referenced_in_body
identity <- function(x) x
#++++
Assign(identity@b1)
  Function(x@b0)
    Symbol(x@b0)

No diagnostics.

#---- multiple_parameters_referenced_in_order
pair <- function(x, y) {
  x
  y
}
#++++
Assign(pair@b2)
  Function(x@b0, y@b1)
    Block
      Symbol(x@b0)
      Symbol(y@b1)

No diagnostics.

#---- unused_parameter_still_introduces_binding
identity <- function(x, y) x
#++++
Assign(identity@b2)
  Function(x@b0, y@b1)
    Symbol(x@b0)

No diagnostics.

#---- parameter_referenced_after_local_statement
identity <- function(x) {
  helper <- 1L
  x
}
#++++
Assign(identity@b2)
  Function(x@b0)
    Block
      Assign(helper@b1)
        Integer(1L)
      Symbol(x@b0)

No diagnostics.

#---- parameter_shadows_top_level_binding
x <- 1L
f <- function(x) x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b2)
  Function(x@b1)
    Symbol(x@b1)

No diagnostics.

#---- nested_function_closes_over_enclosing_parameter
f <- function(x) {
  g <- function() x
}
#++++
Assign(f@b2)
  Function(x@b0)
    Block
      Assign(g@b1)
        Function()
          Symbol(x@b0)

No diagnostics.

#---- local_assignment_later_shadows_parameter
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(f@b1)
  Function(x@b0)
    Block
      Assign(x@b0)
        Character("\"ok\"")
      Symbol(x@b0)

No diagnostics.
