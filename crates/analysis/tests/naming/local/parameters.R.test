#==== parameters
#---- function_parameter_referenced_in_body
mirror <- function(x) x
#++++
Assign(mirror@b0)
  Function(x@b1)
    Symbol(x@b1)

No diagnostics.

#---- multiple_parameters_referenced_in_order
pair <- function(x, y) {
  x
  y
}
#++++
Assign(pair@b0)
  Function(x@b1, y@b2)
    Block
      Symbol(x@b1)
      Symbol(y@b2)

No diagnostics.

#---- unused_parameter_still_introduces_binding
mirror <- function(x, y) x
#++++
Assign(mirror@b0)
  Function(x@b1, y@b2)
    Symbol(x@b1)

No diagnostics.

#---- parameter_referenced_after_local_statement
mirror <- function(x) {
  helper <- 1L
  x
}
#++++
Assign(mirror@b0)
  Function(x@b1)
    Block
      Assign(helper@b2)
        Integer(1L)
      Symbol(x@b1)

No diagnostics.

#---- parameter_shadows_top_level_binding
x <- 1L
f <- function(x) x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function(x@b2)
    Symbol(x@b2)

No diagnostics.

#---- nested_function_closes_over_enclosing_parameter
f <- function(x) {
  g <- function() x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(g@b2)
        Function()
          Symbol(x@b1)

No diagnostics.

#---- local_assignment_later_shadows_parameter
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Symbol(x@b1)

No diagnostics.
