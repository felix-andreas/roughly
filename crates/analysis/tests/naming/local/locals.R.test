#==== locals
#---- local_assignment_introduces_fresh_binding
f <- function() {
  value <- 1L
  value
}
#++++
Assign(f@b1)
  Function()
    Block
      Assign(value@b0)
        Integer(1L)
      Symbol(value@b0)

No diagnostics.

#---- local_rebinding_creates_fresh_binding
f <- function() {
  value <- 1L
  value <- "ok"
  value
}
#++++
Assign(f@b2)
  Function()
    Block
      Assign(value@b0)
        Integer(1L)
      Assign(value@b1)
        Character("\"ok\"")
      Symbol(value@b1)

No diagnostics.

#---- assignment_rhs_sees_outer_parameter_before_local_rebinding
f <- function(x) {
  x <- x
  x
}
#++++
Assign(f@b2)
  Function(x@b0)
    Block
      Assign(x@b1)
        Symbol(x@b0)
      Symbol(x@b1)

No diagnostics.

#---- local_assignment_shadows_top_level_binding
x <- 1L
f <- function() {
  x <- "ok"
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b2)
  Function()
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Symbol(x@b1)

No diagnostics.

#---- local_assignment_rebinds_parameter_name
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(f@b2)
  Function(x@b0)
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Symbol(x@b1)

No diagnostics.

#---- assignment_rhs_can_use_other_outer_binding_while_rebinding_different_name
x <- 1L
f <- function(y) {
  x <- y
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b3)
  Function(y@b1)
    Block
      Assign(x@b2)
        Symbol(y@b1)
      Symbol(x@b2)

No diagnostics.
