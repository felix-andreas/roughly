#==== unused_locals
#---- unused_local_is_reported
f <- function() {
  x <- 1L
  2L
}
#++++
warning[naming] `x` is assigned but never used.
--> 2:3-2:10
|   x <- 1L

#---- used_local_is_not_reported
f <- function() {
  x <- 1L
  x
}
#++++
No diagnostics.

#---- only_final_reassignment_is_kept
f <- function() {
  x <- 1L
  x <- 2L
  x
}
#++++
warning[naming] `x` is assigned but never used.
--> 2:3-2:10
|   x <- 1L

#---- multiple_unused_locals_each_reported
f <- function() {
  a <- 1L
  b <- 2L
  3L
}
#++++
warning[naming] `a` is assigned but never used.
--> 2:3-2:10
|   a <- 1L

warning[naming] `b` is assigned but never used.
--> 3:3-3:10
|   b <- 2L

#---- local_used_only_in_nested_function_is_not_reported
f <- function() {
  outer <- 1L
  function() outer
}
#++++
No diagnostics.

#---- nested_unused_local_is_reported
f <- function() {
  inner <- function() {
    helper <- 1L
    2L
  }
  inner
}
#++++
warning[naming] `helper` is assigned but never used.
--> 3:5-3:17
|     helper <- 1L

#==== conventions
#---- dot_prefixed_local_is_ignored
f <- function() {
  .ignored <- 1L
  2L
}
#++++
No diagnostics.

#---- underscore_prefixed_local_is_ignored
f <- function() {
  `_ignored` <- 1L
  2L
}
#++++
No diagnostics.

#==== excluded_kinds
#---- top_level_assignment_is_not_reported
unused_global <- 1L
#++++
No diagnostics.

#---- unused_parameter_is_not_reported
f <- function(unused_param) 1L
#++++
No diagnostics.

#---- unused_for_variable_is_not_reported
f <- function() {
  for (item in 1:3) {
    1L
  }
}
#++++
No diagnostics.

#---- local_used_in_expression_is_not_reported
f <- function() {
  value <- 1L
  value + 1L
}
#++++
No diagnostics.
