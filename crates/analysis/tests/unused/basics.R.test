#==== unused_locals
#---- unused_local_is_reported
f <- function() {
  x <- 1L
  2L
}
#++++
warning[unused] `x` is assigned but never used.
--> 2:3-2:10
|   x <- 1L

#---- used_local_is_not_reported
f <- function() {
  x <- 1L
  x
}
#++++
No diagnostics.

#---- only_final_reassignment_is_kept
f <- function() {
  x <- 1L
  x <- 2L
  x
}
#++++
warning[unused] `x` is assigned but never used.
--> 2:3-2:10
|   x <- 1L

#==== reaching_writes
#---- conditional_update_before_read_is_used
f <- function(flag) {
  x <- 1L
  if (flag) {
    x <- 2L
  }
  x
}
#++++
No diagnostics.

#---- loop_accumulator_is_used
g <- function() {
  total <- 0L
  for (i in 1:3) {
    total <- total + i
  }
  total
}
#++++
No diagnostics.

#---- dead_store_before_rewrite_is_reported
f <- function() {
  x <- 1L
  x <- 2L
  y <- x
  y
}
#++++
warning[unused] `x` is assigned but never used.
--> 2:3-2:10
|   x <- 1L

#---- write_read_only_on_loop_back_edge_is_used
f <- function(n) {
  while (n > 0L) {
    y <- x
    x <- 1L
    n <- n - 1L
  }
}
#++++
warning[naming] `x` might be undefined here because it is introduced only in conditionally executed code.
--> 3:10-3:11
|     y <- x

warning[unused] `y` is assigned but never used.
--> 3:5-3:11
|     y <- x

#---- conditional_write_never_read_is_reported
f <- function(flag) {
  if (flag) {
    x <- 1L
  }
  2L
}
#++++
warning[unused] `x` is assigned but never used.
--> 3:5-3:12
|     x <- 1L

#---- read_before_conditional_introduction_warns
f <- function(flag) {
  if (flag) {
    x <- 1L
  }
  x
}
#++++
warning[naming] `x` might be undefined here because it is introduced only in conditionally executed code.
--> 5:3-5:4
|   x

#---- multiple_unused_locals_each_reported
f <- function() {
  a <- 1L
  b <- 2L
  3L
}
#++++
warning[unused] `a` is assigned but never used.
--> 2:3-2:10
|   a <- 1L

warning[unused] `b` is assigned but never used.
--> 3:3-3:10
|   b <- 2L

#---- local_used_only_in_nested_function_is_not_reported
f <- function() {
  outer <- 1L
  function() outer
}
#++++
No diagnostics.

#---- nested_unused_local_is_reported
f <- function() {
  inner <- function() {
    helper <- 1L
    2L
  }
  inner
}
#++++
warning[unused] `helper` is assigned but never used.
--> 3:5-3:17
|     helper <- 1L

#==== conventions
#---- dot_prefixed_local_is_ignored
f <- function() {
  .ignored <- 1L
  2L
}
#++++
No diagnostics.

#---- underscore_prefixed_local_is_ignored
f <- function() {
  `_ignored` <- 1L
  2L
}
#++++
No diagnostics.

#==== excluded_kinds
#---- top_level_assignment_is_not_reported
unused_global <- 1L
#++++
No diagnostics.

#---- unused_parameter_is_not_reported
f <- function(unused_param) 1L
#++++
No diagnostics.

#---- unused_for_variable_is_not_reported
f <- function() {
  for (item in 1:3) {
    1L
  }
}
#++++
No diagnostics.

#---- local_used_in_expression_is_not_reported
f <- function() {
  value <- 1L
  value + 1L
}
#++++
No diagnostics.

#---- local_read_through_a_slot_access_counts
f <- function() {
  config <- list()
  config@port
}
#++++
No diagnostics.

#---- slot_replacement_write_is_exempt
f <- function() {
  config <- list()
  config@port <- 8080L
  config
}
#++++
No diagnostics.
