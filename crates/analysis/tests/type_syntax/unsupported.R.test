#==== unsupported_generics
#---- generic_atomic_array_suffix_not_supported
T[]
#++++
UnsupportedConstruct { message: "generic atomic vector suffix types are not supported yet. `T[]` would require constraining `T` to atomic element types." }

#---- generic_atomic_named_suffix_not_supported
T[named]
#++++
UnsupportedConstruct { message: "generic named atomic vector suffix types are not supported yet. `T[named]` would require constraining `T` to atomic element types." }

#---- higher_rank_function_parameter_not_supported
fn(transform: <T> fn(T) -> T) -> integer
#++++
UnsupportedConstruct { message: "higher-rank polymorphism is not supported. type parameter binders may only appear at the outermost level. (while parsing named parameter type)" }

#---- higher_rank_record_field_not_supported
list{value: <T> list[T]}
#++++
UnsupportedConstruct { message: "higher-rank polymorphism is not supported. type parameter binders may only appear at the outermost level. (while parsing field `value`)" }

#---- nested_forall_inside_function_return_not_supported
fn(integer) -> <T> fn(T) -> T
#++++
UnsupportedConstruct { message: "higher-rank polymorphism is not supported. type parameter binders may only appear at the outermost level." }

#==== unsupported_unions
#---- duplicate_null_union
NULL | NULL
#++++
UnsupportedConstruct { message: "`NULL | NULL` is not valid type syntax." }
