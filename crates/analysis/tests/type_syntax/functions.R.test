#==== basic_functions
#---- null_return_by_default
fn(integer)
#++++
fn(integer) -> NULL

#---- positional_parameters
fn(integer,character)->logical
#++++
fn(integer, character) -> logical

#---- named_parameters
fn(count:integer,label:character)->integer
#++++
fn(count: integer, label: character) -> integer

#---- mixed_positional_and_named_parameters
fn(integer,label:character,verbose:logical)->character
#++++
fn(integer, label: character, verbose: logical) -> character

#---- nullable_parameter_and_return
fn(integer | NULL)->character | NULL
#++++
fn(integer | NULL) -> character | NULL

#==== higher_order_functions
#---- function_parameter
fn(fn(integer)->character)->logical
#++++
fn(fn(integer) -> character) -> logical

#---- function_return
fn(integer)->fn(character)->logical
#++++
fn(integer) -> fn(character) -> logical

#---- function_parameter_and_named_parameter
fn(fn(integer)->character,formatter:fn(character)->raw)->logical
#++++
fn(fn(integer) -> character, formatter: fn(character) -> raw) -> logical

#---- nested_higher_order_function
fn(fn(integer)->fn(character)->logical)->fn(raw)->double
#++++
fn(fn(integer) -> fn(character) -> logical) -> fn(raw) -> double

#==== structured_function_types
#---- record_parameter
fn(list{count:integer,label:character})->logical
#++++
fn(list{count: integer, label: character}) -> logical

#---- list_parameter_and_record_return
fn(list[integer])->list{sum:integer,mean:double}
#++++
fn(list[integer]) -> list{sum: integer, mean: double}

#---- named_list_parameter
fn(payload:list[named:character])->integer
#++++
fn(payload: list[named: character]) -> integer

#---- tuple_parameter
fn(list{integer,character,logical})->raw
#++++
fn(list{integer, character, logical}) -> raw



#==== expanded_annotations
#---- expanded_single_parameter
@param count {integer}
@return {character}
#++++
fn(count: integer) -> character

#---- expanded_multiple_parameters
@param count {integer}
@param label {character}
@return {logical}
#++++
fn(count: integer, label: character) -> logical

#---- expanded_optional_parameter
@param count {integer}
@param [label] {character}
@return {logical}
#++++
fn(count: integer, [label]: character) -> logical

#---- expanded_returns_alias
@param value {double}
@returns {integer}
#++++
fn(value: double) -> integer

#---- expanded_without_return_defaults_to_null
@param count {integer}
#++++
fn(count: integer) -> NULL

#---- expanded_higher_order_parameter
@param formatter {fn(integer) -> character}
@param count {integer}
@return {character}
#++++
fn(formatter: fn(integer) -> character, count: integer) -> character

#---- expanded_structured_return
@param count {integer}
@return {list{value: integer, ok: logical}}
#++++
fn(count: integer) -> list{value: integer, ok: logical}

#---- multiline_expanded_structured_return
@param count {integer}
@param payload {list{
    label: character,
    values: list[double]
}}
@return {list{
    ok: logical,
    result: character
}}
#++++
fn(count: integer, payload: list{label: character, values: list[double]}) -> list{ok: logical, result: character}

#---- multiline_expanded_higher_order_parameter
@param formatter {fn(
    integer,
    options: list{
        verbose: logical
    }
) -> character}
@return {list[named: character]}
#++++
fn(formatter: fn(integer, options: list{verbose: logical}) -> character) -> list[named: character]

#---- compact_optional_named_parameter
fn(count: integer, [label]: character) -> integer
#++++
fn(count: integer, [label]: character) -> integer

#---- compact_optional_parameter_without_name_is_rejected
fn(integer, [character]) -> integer
#++++
InvalidSyntax { message: "expected `:` after `[name]` in an optional parameter." }

#---- compact_optional_parameter_missing_colon_is_rejected
fn([label] character) -> integer
#++++
InvalidSyntax { message: "expected `:` after `[name]` in an optional parameter." }

#==== dotted_parameter_names
#---- named_parameter_with_interior_dot
fn(x: double, na.rm: logical) -> double
#++++
fn(x: double, na.rm: logical) -> double

#---- optional_parameter_with_interior_dot
fn(x: integer, [length.out]: integer) -> integer[]
#++++
fn(x: integer, [length.out]: integer) -> integer[]

#---- dot_allowed_in_type_name
foo.bar
#++++
foo.bar

#---- dot_not_allowed_in_type_parameter
<T.x> fn(T) -> T
#++++
InvalidSyntax { message: "expected `,` or `>` in `<...>`." }

#==== variadic
#---- bare_rest_parameter
fn(...) -> character
#++++
fn(...: Any) -> character

#---- typed_rest_parameter
fn(...: character) -> character
#++++
fn(...: character) -> character

#---- named_rest_parameter
fn(...values: integer) -> integer
#++++
fn(...: integer) -> integer

#---- rest_after_fixed_parameters
fn(sep: character, ...: Any) -> character
#++++
fn(sep: character, ...: Any) -> character

#---- rest_after_positional
fn(integer, ...: double) -> double
#++++
fn(integer, ...: double) -> double

#---- generic_rest_parameter
<T> fn(...: T) -> list[T]
#++++
<T> fn(...: T) -> list[T]

#---- rest_must_be_last
fn(..., x: integer) -> integer
#++++
InvalidSyntax { message: "a `...` rest parameter must be the last parameter in `fn(...)`." }

#---- two_rest_parameters_rejected
fn(..., ...) -> integer
#++++
InvalidSyntax { message: "a `...` rest parameter must be the last parameter in `fn(...)`." }
