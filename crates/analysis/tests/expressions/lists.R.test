#==== list_shapes
#---- empty_list_is_empty_tuple
list()
#++++
list{}

#---- positional_list_is_tuple_like_even_when_homogeneous
list(1L, 2L, 3L)
#++++
list{integer, integer, integer}

#---- positional_list_preserves_heterogeneous_shape
list(1L, "foo")
#++++
list{integer, character}

#---- named_list_is_record_like
list(foo = 1L, bar = "foo")
#++++
list{foo: integer, bar: character}

#---- mixed_named_and_unnamed_list_is_rejected
list(1L, bar = "foo")
#++++
error: mixed list elements

#==== list_coercions
#---- tuple_like_list_coerces_to_array_like_annotation
#: list[integer]
value <- list(1L, 2L, 3L)
value
#++++
list[integer]
list[integer]

#---- record_like_list_coerces_to_array_like_annotation
#: list[integer]
value <- list(foo = 1L, bar = 2L)
value
#++++
list[integer]
list[integer]

#---- record_like_list_coerces_to_map_like_annotation
#: list[named: integer]
value <- list(foo = 1L, bar = 2L)
value
#++++
list[named: integer]
list[named: integer]

#---- heterogeneous_tuple_does_not_coerce_to_homogeneous_array_like_list
#: list[integer]
value <- list(1L, "foo")
#++++
error: type mismatch

#---- array_like_list_does_not_coerce_back_to_tuple_like
#: @trust list[integer]
value <- list(1L, 2L)
#: list{integer, integer}
copy <- value
#++++
error: type mismatch

#---- map_like_list_does_not_coerce_back_to_record_like
#: @trust list[named: integer]
value <- list(foo = 1L, bar = 2L)
#: list{foo: integer, bar: integer}
copy <- value
#++++
error: type mismatch
