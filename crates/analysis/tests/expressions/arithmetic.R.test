#==== arithmetic
#---- integer_plus_integer
1L + 2L
#++++
integer

#---- integer_plus_double
1L + 2.5
#++++
double

#---- integer_minus_integer
2L - 1L
#++++
integer

#---- integer_times_double
2L * 1.5
#++++
double

#---- integer_div_integer
4L / 2L
#++++
double

#---- double_power_integer
2.5 ** 2L
#++++
double

#---- vector_plus_scalar
c(1L, 2L) + 4L
#++++
integer[]

#---- scalar_plus_vector
4L + c(1L, 2.5)
#++++
double[]

#---- named_map_plus_scalar_loses_map_likeness
c(foo = 1L, bar = 2L) + 4L
#++++
integer[]

#---- unary_minus_integer
-1L
#++++
integer

#---- unary_minus_vector
-c(1L, 2L)
#++++
integer[]

#---- unary_minus_named_map_loses_map_likeness
-c(foo = 1L, bar = 2L)
#++++
integer[]

#---- string_plus_integer
"foo" + 4L
#++++
error: invalid plus operand
