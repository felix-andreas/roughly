#==== let_polymorphism
#---- identity_instantiates_at_multiple_types
identity <- function(x) x
first <- identity(1L)
second <- identity("hello")
#++++
fn(?1) -> ?1
integer
character

#---- repeated_polymorphic_instantiations_remain_independent
identity <- function(x) x
first <- identity(1L)
second <- identity("hello")
third <- identity(2L)
#++++
fn(?1) -> ?1
integer
character
integer

#---- aliased_polymorphic_function_remains_polymorphic
identity <- function(x) x
alias <- identity
first <- alias(1L)
second <- alias("hello")
#++++
fn(?1) -> ?1
fn(?1) -> ?1
integer
character

#---- higher_order_polymorphic_identity
identity <- function(x) x
apply_once <- function(f, value) f(value)
first <- apply_once(identity, 1L)
second <- apply_once(identity, "hello")
#++++
fn(?1) -> ?1
fn(fn(?1) -> ?2, ?1) -> ?2
integer
character
