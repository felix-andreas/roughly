#==== captures
#---- a_nested_function_reads_the_enclosing_parameter
f <- function(x) {
  g <- function() x
  g
}
#++++
# f
  b0 x parameter 14..15
  b1 g local 21..22
  b2 f top-level 0..1
  0..1 f <- b2
  21..22 g <- b1
  37..38 x -> b0 captured
  41..42 g -> b1

#---- a_capture_reaches_through_several_nested_functions
f <- function() {
  x <- 1L
  g <- function() {
    h <- function() x
    h
  }
  g
}
#++++
# f
  b0 x local 20..21
  b1 g local 30..31
  b2 h local 52..53
  b3 f top-level 0..1
  0..1 f <- b3
  20..21 x <- b0 captured
  30..31 g <- b1
  52..53 h <- b2
  68..69 x -> b0 captured
  74..75 h -> b2
  82..83 g -> b1

#---- an_inner_parameter_shadows_the_captured_name
f <- function() {
  x <- 1L
  g <- function(x) x
  g
}
#++++
# f
  b0 x local 20..21
  b1 g local 30..31
  b2 x parameter 44..45
  b3 f top-level 0..1
  0..1 f <- b3
  20..21 x <- b0
  30..31 g <- b1
  47..48 x -> b2
  51..52 g -> b1
  unused x 20..21

#---- the_nearest_enclosing_frame_wins_across_hops
# Three frames each bind `x`: the innermost function must read the nearest
# enclosing one, not the outermost. A walk to the wrong frame still resolves and
# still type-checks, which is why the binding is stated here.
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    h <- function() x
    h
  }
  g
}
#++++
# f
  b0 x local 20..21
  b1 g local 35..36
  b2 x local 57..58
  b3 h local 71..72
  b4 f top-level 0..1
  0..1 f <- b4
  20..21 x <- b0
  35..36 g <- b1
  57..58 x <- b2 captured
  71..72 h <- b3
  87..88 x -> b2 captured
  93..94 h -> b3
  101..102 g -> b1
  unused x 20..21

#---- every_write_of_a_captured_slot_stays_alive
# The closure runs after `f`'s frame executed, so BOTH writes are observable
# through it and neither is a dead store.
f <- function() {
  x <- 1L
  g <- function() x
  x <- 2L
  g
}
#++++
# f
  b0 x local 20..21
  b1 g local 30..31
  b2 f top-level 0..1
  0..1 f <- b2
  20..21 x <- b0 captured
  30..31 g <- b1
  46..47 x -> b0 captured
  50..51 x <- b0 captured
  60..61 g -> b1

#---- a_shadowed_outer_write_is_dead_despite_the_inner_capture
# Only the frame the read resolves to is protected. The innermost function reads
# `g`'s `x`, so `f`'s `x` is still a dead store.
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    function() x
  }
  g
}
#++++
# f
  b0 x local 20..21
  b1 g local 35..36
  b2 x local 57..58
  b3 f top-level 0..1
  0..1 f <- b3
  20..21 x <- b0
  35..36 g <- b1
  57..58 x <- b2 captured
  82..83 x -> b2 captured
  90..91 g -> b1
  unused x 20..21

#---- a_closure_reads_a_name_the_frame_writes_later
# The closure runs when it is called, which is after the frame finished, so a
# name written later in the frame resolves — a plain top-down walk would report
# it as a non-local.
f <- function() {
  g <- function() later
  later <- 1L
  g
}
#++++
# f
  b0 g local 20..21
  b1 later local 44..49
  b2 f top-level 0..1
  0..1 f <- b2
  20..21 g <- b0
  36..41 later -> b1 captured
  44..49 later <- b1 captured
  58..59 g -> b0

#---- a_closure_built_in_a_loop_captures_the_loop_variable
f <- function() {
  handlers <- list()
  for (index in 1:3) {
    handlers[[index]] <- function() index
  }
  handlers
}
#++++
# f
  b0 handlers local 20..28
  b1 index for-variable 46..51
  b2 f top-level 0..1
  0..1 f <- b2
  20..28 handlers <- b0
  32..36 list -> non-local deferred
  66..74 handlers -> b0
  76..81 index -> b1 captured
  98..103 index -> b1 captured
  110..118 handlers -> b0

#---- a_handler_functions_parameter_is_scoped_to_the_handler
f <- function(action) {
  tryCatch(action(), error = function(condition) conditionMessage(condition))
}
#++++
# f
  b0 action parameter 14..20
  b1 condition parameter 62..71
  b2 f top-level 0..1
  0..1 f <- b2
  26..34 tryCatch -> non-local deferred
  35..41 action -> b0
  73..89 conditionMessage -> non-local deferred
  90..99 condition -> b1

#---- a_read_with_no_lexical_slot_inside_a_closure_leaves_the_item
f <- function() {
  g <- function() elsewhere
  g
}
#++++
# f
  b0 g local 20..21
  b1 f top-level 0..1
  0..1 f <- b1
  20..21 g <- b0
  36..45 elsewhere -> non-local deferred
  48..49 g -> b0

#==== super_assignment
#---- a_super_assignment_writes_the_nearest_enclosing_slot
outer <- function() {
  count <- 0L
  bump <- function() count <<- count + 1L
  bump
}
#++++
# outer
  b0 count local 24..29
  b1 bump local 38..42
  b2 outer top-level 0..5
  0..5 outer <- b2
  24..29 count <- b0 captured
  38..42 bump <- b1
  57..62 count <- b0 captured
  67..72 count -> b0 captured
  80..84 bump -> b1

#---- a_super_assignment_reaches_past_an_intermediate_frame
outer <- function() {
  count <- 0L
  bump <- function() {
    inner <- function() count <<- count + 1L
    inner
  }
  bump
}
#++++
# outer
  b0 count local 24..29
  b1 bump local 38..42
  b2 inner local 63..68
  b3 outer top-level 0..5
  0..5 outer <- b3
  24..29 count <- b0 captured
  38..42 bump <- b1
  63..68 inner <- b2
  83..88 count <- b0 captured
  93..98 count -> b0 captured
  108..113 inner -> b2
  120..124 bump -> b1

#---- an_intervening_frame_that_binds_the_name_takes_the_super_assignment
# `<<-` starts at the parent of the frame it runs in, so the middle frame's own
# `count` catches it and the outermost write is genuinely dead.
outer <- function() {
  count <- 0L
  bump <- function() {
    count <- 100L
    inner <- function() count <<- count + 1L
    inner
  }
  bump
}
#++++
# outer
  b0 count local 24..29
  b1 bump local 38..42
  b2 count local 63..68
  b3 inner local 81..86
  b4 outer top-level 0..5
  0..5 outer <- b4
  24..29 count <- b0
  38..42 bump <- b1
  63..68 count <- b2 captured
  81..86 inner <- b3
  101..106 count <- b2 captured
  111..116 count -> b2 captured
  126..131 inner -> b3
  138..142 bump -> b1
  unused count 24..29

#---- a_super_assignment_from_a_nested_frame_with_no_slot_is_a_global
f <- function() {
  g <- function() {
    counter <<- 1L
  }
  g
}
#++++
# f
  b0 g local 20..21
  b1 f top-level 0..1
  0..1 f <- b1
  20..21 g <- b0
  42..49 counter -> non-local
  63..64 g -> b0
  super-globals: counter

#---- the_right_facing_super_assignment_spells_the_same_thing
f <- function() {
  total <- 0L
  g <- function() total + 1L ->> total
  g
}
#++++
# f
  b0 total local 20..25
  b1 g local 34..35
  b2 f top-level 0..1
  0..1 f <- b2
  20..25 total <- b0 captured
  34..35 g <- b1
  50..55 total -> b0 captured
  65..70 total <- b0 captured
  73..74 g -> b1

#==== deferred_reads
#---- an_on_exit_expression_keeps_later_writes_alive
# `on.exit` stores its expression and runs it when the function returns, so the
# read observes the final value of `committed`. Walking it as an ordinary
# argument would make `committed <- TRUE` a dead store, and deleting that write
# on the warning's advice makes every transaction roll back.
with_transaction <- function(connection, body) {
  committed <- FALSE
  on.exit(if (!committed) rollback(connection))
  body(connection)
  committed <- TRUE
  invisible(TRUE)
}
#++++
# with_transaction
  b0 connection parameter 29..39
  b1 body parameter 41..45
  b2 committed local 51..60
  b3 with_transaction top-level 0..16
  0..16 with_transaction <- b3
  51..60 committed <- b2 captured
  72..79 on.exit -> non-local deferred
  85..94 committed -> b2 captured
  96..104 rollback -> non-local deferred
  105..115 connection -> b0 captured
  120..124 body -> b1
  125..135 connection -> b0 captured
  139..148 committed <- b2 captured
  159..168 invisible -> non-local deferred
