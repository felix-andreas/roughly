#==== schemes
#---- identity
id <- function(x) x
#++++
id: <T> fn(x: T) -> T

#---- arithmetic_generalizes
add1 <- function(x) x + 1L
#++++
add1: <T: numeric> fn(x: T) -> T

#---- two_operands_tie
add <- function(a, b) a + b
#++++
add: <T: numeric> fn(a: T, b: T) -> T

#---- division_is_double
half <- function(x) x / 2
#++++
half: <T: numeric> fn(x: T) -> double

#---- comparison_constrains
positive <- function(x) x > 0L
#++++
positive: <T: numeric> fn(x: T) -> logical

#---- two_flexible_comparison_stays_unconstrained
cmp <- function(a, b) a < b
mixed <- cmp(1L, "s")
#++++
cmp: <T, U> fn(a: T, b: U) -> logical
mixed: logical

#---- values
n <- 1L
s <- "hi"
flag <- TRUE
#++++
n: integer
s: character
flag: logical

#---- let_polymorphism
use <- function() {
  id <- function(x) x
  id(1L)
  id("s")
}
#++++
use: fn() -> character

#---- conditional_reassignment_monomorphizes
f <- function(flag) {
  x <- 1L
  if (flag) x <- "two"
  x
}
#++++
f: fn(flag: logical) -> integer | character

#==== errors
#---- call_numeric_violation
f <- function() {
  add1 <- function(x) x + 1L
  add1("txt")
}
#++++
f: Unknown
54..59 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- forward_read_is_tolerant
f <- function() later()
later <- function() 1L
#++++
f: fn() -> integer
later: fn() -> integer

#==== interface
#---- growing_self_reference_pins_to_unknown
x <- list(v = 1, w = x)
#++++
x: Unknown

#---- occurs_check_names_the_infinite_type
f <- function(g) g(g)
#++++
f: Unknown
17..21 error[type-mismatch] I cannot construct an infinite type: T occurs inside `fn(T) -> U`.

#==== constants
#---- reserved_constants_infer_fixed_types
flag <- NA
count <- NA_integer_
amount <- NA_real_
label <- NA_character_
z <- NA_complex_
inf <- Inf
nan <- NaN
im <- 1i
#++++
flag: logical
count: integer
amount: double
label: character
z: complex
inf: double
nan: double
im: complex

#==== operators
#---- modulo_and_integer_division_follow_arithmetic
f <- function() 7L %% 2L
g <- function() 7L %/% 2.5
#++++
f: fn() -> integer
g: fn() -> double

#---- power_is_always_double
f <- function() 2L ^ 3L
g <- function() 2L ** 3L
h <- function(x) x ^ 2L
#++++
f: fn() -> double
g: fn() -> double
h: <T: numeric> fn(x: T) -> double

#---- unary_minus_keeps_the_atom_and_shape
f <- function() -1L
g <- function() -c(1L, 2L)
h <- function() -c(foo = 1L, bar = 2L)
#++++
f: fn() -> integer
g: fn() -> integer[]
h: fn() -> integer[]

#---- unary_not_requires_logical
f <- function() !TRUE
g <- function() !c(TRUE, FALSE)
h <- function() !1L
#++++
f: fn() -> logical
g: fn() -> logical[]
h: Unknown
71..73 error[type-mismatch] expected a `logical` value, found `integer`

#---- comparison_families
f <- function() "a" < "b"
g <- function() c(1L, 2L) > 1L
h <- function() 1L < "a"
#++++
f: fn() -> logical
g: fn() -> logical[]
h: Unknown
73..81 error[type-mismatch] expected `integer`, found `character`

#---- logical_operands_promote_to_integer_in_arithmetic
f <- function() TRUE + TRUE
g <- function() TRUE + 1L
h <- function() TRUE + 1.5
k <- function() c(TRUE, FALSE) * 2L
#++++
f: fn() -> integer
g: fn() -> integer
h: fn() -> double
k: fn() -> integer[]

#---- logical_compares_in_the_numeric_family
f <- function() TRUE > 0
g <- function() c(TRUE, FALSE) > 0L
h <- function() TRUE == 1L
k <- function() TRUE < "a"
#++++
f: fn() -> logical
g: fn() -> logical[]
h: fn() -> logical
k: Unknown
104..114 error[type-mismatch] expected `logical`, found `character`

#---- range_operator_shapes
f <- function() 1L:10L
g <- function() 1:10
h <- function() 1.5:3L
k <- function(n) 1:n
#++++
f: fn() -> integer[]
g: fn() -> integer[]
h: fn() -> double[]
k: <T: scalar numeric> fn(n: T) -> double[]

#---- boolean_operators_are_scalar_only
f <- function(a, b) a && b
g <- function() c(TRUE, FALSE) && TRUE
#++++
f: fn(a: logical, b: logical) -> logical
g: Unknown
43..57 error[type-mismatch] expected `logical`, found `logical[]`

#---- unary_minus_generalizes
f <- function(x) -x
#++++
f: <T: numeric> fn(x: T) -> T

#---- division_by_literal_keeps_the_parameter_numeric
f <- function(x) x / 2
#++++
f: <T: numeric> fn(x: T) -> double
