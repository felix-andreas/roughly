#==== branch_unions
#---- a_concrete_branch_does_not_pin_an_unannotated_parameter
f <- function(flag, x) if (flag) x else "s"
a <- f(TRUE, 1)
b <- f(TRUE, "text")
#++++
f: <T> fn(flag: logical, x: T) -> T | character
a: double | character
b: character

#---- a_guard_branch_reading_the_guarded_parameter_does_not_pin_it
fmt <- function(x) if (is.character(x)) x else "other"
a <- fmt(1)
b <- fmt("text")
#++++
fmt: <T> fn(x: T) -> T | character
a: double | character
b: character

#---- two_open_branches_still_tie_to_each_other
coalesce <- function(value, fallback) if (is.null(value)) fallback else value
#++++
coalesce: <T> fn(value: T | NULL, fallback: T) -> T

#---- a_constrained_branch_may_unify_so_recursion_converges
fact <- function(n) if (n <= 1L) 1L else n * fact(n - 1L)
#++++
fact: fn(n: integer) -> integer

#==== joins
#---- if_unifies_or_unions
same <- function(flag) if (flag) 1L else 2L
mixed <- function(flag) if (flag) 1L else "foo"
nullable <- function(flag) if (flag) 1L else NULL
#++++
same: fn(flag: logical) -> integer
mixed: fn(flag: logical) -> integer | character
nullable: fn(flag: logical) -> integer | NULL

#---- if_without_else_is_nullable
f <- function(flag) if (flag) 1L
#++++
f: fn(flag: logical) -> integer | NULL

#---- a_numeric_condition_coerces
# R coerces a numeric condition — zero is false, anything else true — so the
# `if (length(x))` idiom is ordinary R rather than a mistake.
f <- function() if (1L) 2L
g <- function(x) if (length(x)) 1L else 2L
h <- function() {
  n <- 3L
  while (n) n <- n - 1L
  n
}
#++++
f: fn() -> integer | NULL
g: <T> fn(x: T) -> integer
h: fn() -> integer

#---- a_character_condition_is_refused
# Every string but the spellings of TRUE and FALSE raises at run time in R.
f <- function() if ("yes") 2L
#++++
f: Unknown
96..101 error[type-mismatch] expected `logical`, found `character`

#---- condition_blame_drills_through_parens
f <- function() if (("yes")) 2L
#++++
f: Unknown
21..26 error[type-mismatch] expected `logical`, found `character`

#---- condition_blame_excludes_trailing_trivia
f <- function(n) if (n %% 2L ) 2L
#++++
f: Unknown
21..28 error[type-mismatch] expected a numeric value (`integer` or `double`), found `logical`

#==== returns
#---- early_return_unions
f <- function(c) {
  if (c) return("foo")
  5
}
#++++
f: fn(c: logical) -> character | double

#---- diverging_branch_drops_value_and_state
f <- function(c) {
  x <- if (c) return(NULL) else 5
  x + 1
}
#++++
f: fn(c: logical) -> double | NULL

#==== guards
#---- early_exit_narrows
#: fn(x: integer | NULL) -> integer
f <- function(x) {
  if (is.null(x)) {
    return(0L)
  }
  x + 1L
}
#++++
f: fn(x: integer | NULL) -> integer

#---- coalesce_idiom_shapes
coalesce <- function(value, fallback) if (is.null(value)) fallback else value
#++++
coalesce: <T> fn(value: T | NULL, fallback: T) -> T

#---- family_guard_filters
f <- function(flag) {
  y <- if (flag) 1L else "a"
  if (is.character(y)) y else "z"
}
#++++
f: fn(flag: logical) -> character

#---- negated_guard_swaps_edges
f <- function(flag) {
  x <- if (flag) 1L else NULL
  if (!is.null(x)) x + 1L else 0L
}
#++++
f: fn(flag: logical) -> integer

#---- numeric_guard_covers_both_atoms
f <- function(flag) {
  x <- if (flag) 1L else "s"
  if (is.numeric(x)) x + 1L else 0L
}
#++++
f: fn(flag: logical) -> integer

#---- family_guard_keeps_scalar_and_vector_members
f <- function(flag) {
  x <- if (flag) "s" else c("a", "b")
  if (is.character(x)) x else "z"
}
#++++
f: fn(flag: logical) -> character | character[]

#---- function_guard_filters
f <- function(flag) {
  x <- if (flag) function() 1L else 2L
  if (is.function(x)) x() else x
}
#++++
f: fn(flag: logical) -> integer

#---- guard_without_a_null_member_does_not_fire
f <- function(flag) {
  x <- if (flag) 1L else 2L
  if (is.null(x)) x else x + 1L
}
#++++
f: fn(flag: logical) -> integer

#---- field_access_guards_do_not_narrow
f <- function(record) {
  if (is.null(record$value)) 0L else record$value
}
#++++
f: <T> fn(record: T) -> integer

#---- null_test_makes_unguarded_use_a_finding
f <- function(x) {
  if (is.null(x)) {
    print("missing")
  }
  x + 1L
}
#++++
f: Unknown
66..67 error[type-mismatch] expected a numeric value (`integer` or `double`), found `T | NULL`

#==== loops
#---- accumulator_is_stable
f <- function() {
  total <- 0L
  for (i in 1:3) {
    total <- total + i
  }
  total
}
#++++
f: fn() -> integer

#---- heterogeneous_iteration
f <- function() {
  out <- 1L
  for (item in list(2L, "a")) {
    out <- item
  }
  out
}
#++++
f: fn() -> integer | character

#---- function_is_not_iterable
f <- function() {
  g <- function() 1L
  for (i in g) i
}
#++++
f: Unknown
51..52 error[type-mismatch] this `for` sequence is `fn() -> integer`, which cannot be iterated — expected a vector or list.

#---- repeat_applies_exit_state
f <- function() {
  repeat {
    x <- 1L
    break
  }
  x + 1L
}
#++++
f: fn() -> integer

#==== switch
#---- branches_union_with_null
f <- function(x) switch(x, a = 1L, b = "s")
#++++
f: <T> fn(x: T) -> integer | character | NULL

#---- default_removes_null
f <- function(x) switch(x, a = 1L, 2L)
#++++
f: <T> fn(x: T) -> integer

#==== scoping
#---- local_scopes_its_bindings
f <- function() {
  n <- local({
    y <- 1L
    y + 1L
  })
  n
}
#++++
f: fn() -> integer

#---- super_assignment_survives_the_closure
counter <- function() {
  n <- 0L
  bump <- function() {
    n <<- n + 1L
    n
  }
  bump()
  n
}
#++++
counter: fn() -> integer

#---- super_assignment_joins_as_a_union
f <- function() {
  x <- 1L
  set <- function() {
    x <<- "s"
  }
  set()
  x
}
#++++
f: fn() -> integer | character

#---- trailing_semicolon_yields_null
f <- function() {
  1L;
}
#++++
f: fn() -> NULL

#---- forward_capture_resolves_after_repass
f <- function() {
  helper <- function() other()
  other <- function() 1L
  helper()
}
#++++
f: fn() -> integer

#---- local_mutual_recursion_is_tolerant
f <- function(n) {
  even <- function(k) if (k == 0L) TRUE else odd(k - 1L)
  odd <- function(k) if (k == 0L) FALSE else even(k - 1L)
  even(n)
}
#++++
f: <T: numeric> fn(n: T) -> logical

#---- forward_capture_sees_the_frame_write
f <- function() {
  shout <- function() toupper(word)
  word <- 1L
  shout()
}
#++++
f: fn() -> character

#---- unresolved_reference_suggests_the_nearest_stub
f <- function(x) lenght(x)
#++++
f: <T> fn(x: T) -> Unknown
17..23 warning[unresolved] I could not resolve `lenght` in this package, its imports, or builtins. Did you mean `length`?

#---- conditional_top_level_slot_resolves_a_later_read_in_this_file
for (i in 1:3) total <- i
report <- function() total
#++++
report: fn() -> integer

#---- loop_carried_read_starts_from_the_outer_binding
p <- "word"
while (TRUE) p <- p - 1L
#++++
p: character
30..31 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- loop_carried_read_continues_the_outer_type
n <- 10L
while (n > 0L) n <- n - 1L
after <- function() n
#++++
n: integer
after: fn() -> integer

#---- rebinding_statement_reads_the_earlier_binding
p <- "word"
p <- p - 1L
#++++
p: character
p: Unknown
0..1 warning[duplicate] Top-level binding `p` is overwritten by a later top-level binding in this package.
12..13 warning[duplicate] Top-level binding `p` overwrites an earlier top-level binding in this package.

#---- self_referential_first_writer_stays_tolerated
x <- x + 1
#++++
x: Unknown

#---- accumulator_seeded_by_an_earlier_item
total <- 0L
for (i in 1:3) total <- total + i
report <- function() total
#++++
total: integer
report: fn() -> integer

#---- shadowed_outer_binding_is_dead_despite_the_capture
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    h <- function() x
    h
  }
  g
}
#++++
f: fn() -> fn() -> fn() -> logical
20..21 warning[unused] `x` is assigned but never used.

#---- rebinding_in_the_captured_frame_stays_alive
f <- function() {
  x <- 1L
  g <- function() x
  x <- 2L
  g
}
#++++
f: fn() -> fn() -> integer

#==== missing_formals
#---- reading_a_missing_formal_is_an_error
describe <- function(name, punct) {
  if (missing(punct)) {
    return(nchar(punct))
  }
  paste0(name, punct)
}
#++++
describe: Unknown
77..82 error[type-mismatch] reading `punct` here would fail at run time: this branch runs only when `punct` is missing, and it has no default.

#---- supplying_the_formal_on_the_missing_branch_is_fine
describe <- function(name, punct) {
  if (missing(punct)) {
    punct <- "."
  }
  paste0(name, punct)
}
#++++
describe: <T> fn(name: T, [punct]: character) -> character

#---- the_else_branch_reads_the_supplied_formal
describe <- function(name, punct) {
  if (missing(punct)) {
    return(name)
  }
  paste0(name, punct)
}
#++++
describe: <T, U> fn(name: T, [punct]: U) -> T | character
