#==== stubs
#---- resolves_cleanly
total <- function(x) sum(x, na.rm = TRUE)
size <- function(x) length(x)
#++++
total: <T> fn(x: T) -> Any
size: <T> fn(x: T) -> integer

#---- debugging_family_resolves
f <- function(choices) {
  debug(sum)
  selected <- menu(choices)
  confirmed <- askYesNo("proceed?")
  if (confirmed) selected else 0L
}
#++++
f: fn(choices: character | character[]) -> integer

#---- error_handler_stubs_resolve
options(error = recover)
handler <- function() traceback()
#++++
handler: fn() -> Any

#---- manifest_only_exports_resolve
f <- function(x, y) bitwAnd(x, y)
g <- function(path) utils::aspell(path)
#++++
f: <T, U> fn(x: T, y: U) -> Unknown
g: <T> fn(path: T) -> Unknown

#---- qualified_only_namespace_resolves
extension <- function(path) tools::file_ext(path)
#++++
extension: <T> fn(path: T) -> Unknown

#---- datasets_type_through_stubs
measurements <- function() iris
#++++
measurements: fn() -> data.frame

#---- overload_picks_specific
f <- function() cumsum(1L)
#++++
f: fn() -> integer[]

#---- strict_round_keeps_double
f <- function() sum(1, 2)
#++++
f: fn() -> double

#---- literal_courtesy
f <- function() seq_len(10)
#++++
f: fn() -> integer[]

#---- stub_argument_mismatch
f <- function(x) grepl(1L, x)
#++++
f: Unknown
23..25 error[type-mismatch] expected `character`, found `integer`

#---- namespace_access
f <- function(x) base::length(x)
#++++
f: <T> fn(x: T) -> integer

#==== matching
#---- named_arguments_match_formals
f <- function() {
  g <- function(x, y) x
  g(y = 1L, x = "a")
}
#++++
f: fn() -> character

#---- unknown_named_argument
f <- function() {
  g <- function(x) x
  g(z = 1)
}
#++++
f: Unknown
43..44 error[type-mismatch] this function has no parameter `z` — its named parameter is `x`

#---- surplus_positional
f <- function() {
  g <- function(x) x
  g(1, 2)
}
#++++
f: Unknown
41..42 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

#---- missing_required
f <- function() {
  g <- function(x, y) x
  g(1L)
}
#++++
f: Unknown
44..45 error[type-mismatch] this call supplies 1 argument, but the function requires 2 — a required argument is missing

#---- defaulted_formal_may_stay_unfilled
f <- function() {
  g <- function(x, y = 2L) x
  g(1L)
}
#++++
f: fn() -> integer

#==== union_commit
#---- flexible_argument_commits_to_the_union_at_first_use
#: fn(x: integer | character) -> logical
first <- function(x) TRUE
#: fn(x: logical | character) -> logical
second <- function(x) TRUE
both <- function(v) {
  first(v)
  second(v)
}
#++++
first: fn(x: integer | character) -> logical
second: fn(x: logical | character) -> logical
both: Unknown
177..178 error[type-mismatch] expected `logical | character`, found `integer | character`

#---- union_commit_blames_the_later_conflicting_use
#: fn(x: integer | logical) -> logical
first <- function(x) TRUE
#: fn(x: character | logical) -> logical
second <- function(x) TRUE
both <- function(v) {
  second(v)
  first(v)
}
#++++
first: fn(x: integer | logical) -> logical
second: fn(x: character | logical) -> logical
both: Unknown
175..176 error[type-mismatch] expected `integer | logical`, found `character | logical`

#---- a_logical_member_promotes_into_an_integer_member
#: fn(x: integer | character) -> logical
first <- function(x) TRUE
#: fn(x: logical | character) -> logical
second <- function(x) TRUE
both <- function(v) {
  second(v)
  first(v)
}
#++++
first: fn(x: integer | character) -> logical
second: fn(x: logical | character) -> logical
both: fn(v: logical | character) -> logical

#---- vapply_checks_the_callback_against_its_template
xs <- c(1, 2, 3)
labels <- vapply(xs, function(v) as.character(v), character(1))
wrong <- vapply(xs, function(v) as.character(v), numeric(1))
#++++
xs: double[]
labels: character[]
wrong: Unknown
130..140 error[type-mismatch] expected `character[] | character`, found `double[]`

#==== higher_order
#---- callback_pairs_positionally
apply1 <- function() {
  call_with <- function(f) f(1L)
  call_with(function(x) x + 1L)
}
#++++
apply1: fn() -> integer

#---- dispatch_table_union
f <- function(flag) {
  h <- if (flag) function(x) 1L else function(x) "a"
  h(2L)
}
#++++
f: fn(flag: logical) -> integer | character

#---- lapply_maps_the_element_type
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, nchar)
}
#++++
f: fn() -> list[integer]

#---- lapply_forwards_extra_arguments
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, gsub, pattern = "a", replacement = "o")
}
#++++
f: fn() -> list[character]

#---- lapply_rejects_a_wrong_callback
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, function(a, b) a)
}
#++++
f: Unknown
64..80 error[type-mismatch] expected `fn(character) -> T`, found `fn(a: U, b: V) -> U`

#---- missing_tested_formal_is_optional
f <- function() {
  g <- function(x, tag) {
    if (missing(tag)) x else tag
  }
  g(1L)
}
#++++
f: fn() -> integer

#---- unknown_typed_parameter_accepts_anything
user <- function(w) helper("text")
helper <- function(r) {
  if (!isRestart(r)) r <- findRestart(r)
  r
}
#++++
user: <T> fn(w: T) -> Unknown
helper: fn(r: Unknown) -> Unknown

#---- walrus_outside_masked_brackets_is_an_operator_call
f <- function(a, b) quo(a := b)
#++++
f: <T, U> fn(a: T, b: U) -> Unknown
20..23 warning[unresolved] I could not resolve `quo` in this package, its imports, or builtins.
26..28 warning[unresolved] I could not resolve ``:=`` in this package, its imports, or builtins.

#---- any_callee_arguments_are_not_checked
fail_with <- function(x) stop(paste0("bad: ", class(x)[1]))
checked <- function(x) paste0("bad: ", class(x)[1])
#++++
fail_with: <T> fn(x: T) -> Unknown
checked: <T> fn(x: T) -> character

#==== exported_constraints
#---- higher_order_result_keeps_its_constraint_across_items
invoke <- function(f) function(x) f(x + 1L)
mirror <- function(x) x
mixed_apply <- invoke(mirror)
bad <- mixed_apply("ok")
ok <- mixed_apply(2L)
#++++
invoke: <T: numeric, U> fn(f: fn(T) -> U) -> fn(x: T) -> U
mirror: <T> fn(x: T) -> T
mixed_apply: <T: numeric> fn(x: T) -> T
bad: Unknown
ok: integer
117..121 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- undetermined_argument_uses_the_general_candidate
wrap <- function(x) sum(x)
#++++
wrap: <T> fn(x: T) -> Any

#---- corpus_overload_sets_end_in_a_general_candidate
f <- function() cumsum("word")
#++++
f: fn() -> Any

#---- overloaded_name_as_a_value_sees_the_first_declaration
folder <- cumsum
#++++
folder: fn(x: Any) -> Any

#---- local_binding_disables_the_overload_set
cumsum <- function(x) "shadowed"
f <- function() cumsum(1L)
#++++
cumsum: <T> fn(x: T) -> character
f: fn() -> character

#---- optional_display_formals_work_directly_and_as_callbacks
f <- function() nchar("word", type = "bytes")
g <- function() lapply(list("a", "bb"), nchar)
#++++
f: fn() -> integer
g: fn() -> list[integer]

#---- forwarded_dots_disable_arity_checking
two <- function(a, b) a + b
wrap <- function(...) two(...)
partial <- function(x, ...) two(x, ...)
#++++
two: <T: numeric> fn(a: T, b: T) -> T
wrap: <T: numeric> fn(...: Any) -> T
partial: <T: numeric> fn(x: T, ...: Any) -> T

#==== pipes
#---- pipe_lowers_to_first_argument_call
f <- function(x) x |> length()
#++++
f: <T> fn(x: T) -> integer

#---- pipe_chains_type_end_to_end
f <- function(x) x |> length() |> sqrt()
#++++
f: <T> fn(x: T) -> double

#---- pipe_argument_errors_blame_the_piped_value
half <- function(n) n / 2
f <- function() "text" |> half()
#++++
half: <T: numeric> fn(n: T) -> double
f: Unknown
42..48 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- pipe_named_placeholder_receives_the_value
scale_by <- function(value, factor) value * factor
f <- function(x) x |> scale_by(2, factor = _)
#++++
scale_by: <T: numeric> fn(value: T, factor: T) -> T
f: fn(x: double) -> double

#---- placeholder_without_the_piped_first_argument_is_missing_an_argument
scale_by <- function(value, factor) value * factor
f <- function() 2 |> scale_by(factor = _)
#++++
scale_by: <T: numeric> fn(value: T, factor: T) -> T
f: Unknown
72..80 error[type-mismatch] this call supplies 1 argument, but the function requires 2 — a required argument is missing

#---- pipe_into_a_namespaced_callee
f <- function(x) x |> stats::sd()
#++++
f: <T> fn(x: T) -> double

#---- non_call_pipe_stays_opaque
f <- function(x, g) x |> g
#++++
f: <T, U> fn(x: T, g: U) -> Unknown

#---- positional_placeholder_stays_opaque
f <- function(x) x |> paste(_, "a")
#++++
f: <T> fn(x: T) -> Unknown
