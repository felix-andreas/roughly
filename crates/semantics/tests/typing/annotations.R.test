#==== checked
#---- declared_scheme_wins
#: <T> fn(x: T) -> T
id <- function(x) x
#++++
id: <T> fn(x: T) -> T

#---- return_mismatch
#: fn(x: integer) -> character
f <- function(x) x
#++++
f: Unknown
48..49 error[type-mismatch] expected `character`, found `integer`

#---- parameter_name_mismatch
#: fn(x: integer) -> integer
f <- function(y) 1L
#++++
f: Unknown
34..48 error[type-mismatch] this annotation names a parameter `x`, but the function does not define one — annotation parameter names must match the function's parameter names

#---- rigid_refuses_undeclared_bound
#: <T> fn(x: T) -> T
bad <- function(x) x + 1L
#++++
bad: Unknown
40..41 error[type-mismatch] expected a numeric value (`integer` or `double`), found `T`

#---- declared_numeric_bound_admits_arithmetic
#: <T: numeric> fn(x: T) -> T
ok <- function(x) x + 1L
#++++
ok: <T: numeric> fn(x: T) -> T

#---- expanded_form
#: @forall T: numeric
#: @param x {T}
#: @return {T}
round2 <- function(x) x + 1L
#++++
round2: <T: numeric> fn(x: T) -> T

#---- value_annotation_checks
#: integer
n <- 1L
#: character
bad <- 2L
#++++
n: integer
bad: Unknown
39..41 error[type-mismatch] expected `character`, found `integer`

#==== trusted
#---- trust_skips_enforcement
#: @trust fn(x: integer) -> character
f <- function(x) x
#++++
f: fn(x: integer) -> character

#==== blocks
#---- definition_mixed_with_compact_is_refused
#: @type Person {list{name: character}}
#: integer
n <- 1L
#++++
n: integer
0..50 error[annotation] `@type` and `@alias` declarations need their own `#:` block — separate them from other annotations with a blank line.

#---- definition_mixed_with_expanded_is_refused
#: @type Person {list{name: character}}
#: @param count {integer}
#: @return {Person}
make <- function(count) list(name = "a")
#++++
make: <T> fn(count: T) -> list{name: character}
0..85 error[annotation] `@type` and `@alias` declarations need their own `#:` block — separate them from other annotations with a blank line.

#---- compact_mixed_with_expanded_is_refused
#: fn(x: integer) -> integer
#: @return {integer}
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
0..49 error[annotation] a `#:` block uses either one compact annotation or `@param`/`@return` lines, not both — separate the two forms with a blank line.

#---- multiple_compact_annotations_are_refused
#: integer
#: double
n <- 1L
#++++
n: integer
0..20 error[annotation] only one compact annotation fits in a `#:` block — separate the annotations with a blank line so each gets its own block.

#---- declared_return_mismatch_blames_the_tail_expression
#: fn(x: integer) -> character
f <- function(x) {
  y <- x + 1L
  y
}
#++++
f: Unknown
66..67 error[type-mismatch] expected `character`, found `integer`

#---- duplicate_type_declarations_error_at_every_site
#: @type Point {list{v: double}}

#: @alias Point {integer}

#: @new Point
origin <- list(v = 1)
#++++
origin: list{v: double}
3..32 error[annotation] the type name `Point` is declared more than once — `@type` and `@alias` declarations share one project-global namespace.
37..59 error[annotation] the type name `Point` is declared more than once — `@type` and `@alias` declarations share one project-global namespace.

#==== form
#---- param_after_return_is_refused
#: @return {integer}
#: @param count {integer}
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
24..46 error[annotation] `@param` directives must appear before `@return` or `@returns` in the same `#:` block.

#---- multiple_returns_are_refused
#: @param count {integer}
#: @return {integer}
#: @returns {character}
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
50..70 error[annotation] cannot use more than one `@return` or `@returns` directive in the same `#:` block.

#---- forall_after_param_is_refused
#: @param count {integer}
#: @forall T
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
29..38 error[annotation] `@forall` directives must appear before `@param`, `@return`, or `@returns` in the same `#:` block.

#---- duplicate_forall_parameter_is_refused
#: @forall T
#: @forall T
#: @param value {T}
#: @return {T}
f <- function(value) value
#++++
f: <T> fn(value: T) -> T
24..29 error[annotation] duplicate type parameter name `T` in expanded function annotation.

#---- duplicate_compact_binder_is_refused
#: <T, T> fn(x: T) -> T
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
7..8 error[annotation] duplicate type parameter name `T` in `<...>`.

#---- duplicate_definition_parameter_is_refused
#: @type Pair<T, T> {list{a: T, b: T}}
value <- 1L
#++++
value: integer
17..18 error[annotation] duplicate type parameter name `T` in named type definition.

#---- unknown_constraint_name_is_refused
#: <T: frobnicate> fn(x: T) -> T
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
7..17 error[annotation] unknown type-parameter constraint `frobnicate`; the available constraints are `numeric` and `atomic`.

#---- applied_type_parameter_is_refused
#: @alias Wrap<T> {list{v: T}}

#: @alias Outer<Wrap> {Wrap<integer>}
value <- 1L
#++++
value: integer
55..68 error[annotation] `Wrap` is a type parameter here and takes no type arguments.

#==== dangling
#---- empty_annotation_is_refused
#:
value <- 1L
#++++
value: integer
0..2 error[annotation] A `#:` typing comment must include a type expression.

#---- annotation_at_end_of_file_is_refused
value <- 1L
#: integer
#++++
value: integer
12..22 error[annotation] A `#:` typing comment must be followed immediately by an expression.

#---- blank_line_breaks_the_annotation
#: integer

value <- "s"
#++++
value: character
0..10 error[annotation] A `#:` typing comment cannot be separated from its expression by an empty line.

#---- comment_between_annotation_and_expression_is_refused
#: integer
# note
value <- 1L
#++++
value: integer
0..10 error[annotation] A `#:` typing comment must be followed immediately by an expression.

#---- expanded_annotation_separated_by_blank_line_is_refused
#: @param count {integer}

render <- function(count) count
#++++
render: <T> fn(count: T) -> T
0..25 error[annotation] A `#:` typing comment cannot be separated from its expression by an empty line.

#---- definitions_and_strict_toggles_need_no_target
#: @type Person {list{name: character}}

#: @strict off

value <- 1L
#++++
value: integer

#==== new_shape
#---- new_requires_a_nominal_reference
#: @new integer
value <- 1L
#++++
value: integer
8..15 error[annotation] expected a nominal type reference after `@new`.

#---- new_on_alias_is_refused
#: @alias Meters {double}

#: @new Meters
h <- 1.8
#++++
h: double
35..41 error[annotation] `@new` requires a nominal type declared with `@type`, but `Meters` is an alias.

#==== vectors
#---- alias_vector_element_must_be_atomic
#: @alias Person {list{name: character}}

#: fn(x: Person[]) -> NULL
f <- function(x) NULL
#++++
f: fn(x: Person[]) -> NULL
51..59 error[type-mismatch] the element of a `[]` vector type must be an atomic type, found `Person` — for a list of these, write `list[Person]`

#---- structural_vector_element_is_refused
#: fn(x: list{name: character}[]) -> NULL
f <- function(x) NULL
#++++
f: fn(x: list{name: character}[]) -> NULL
9..32 error[type-mismatch] the element of a `[]` vector type must be an atomic type, found `list{name: character}` — for a list of these, write `list[list{name: character}]`

#---- atomic_alias_and_binder_vector_elements_are_fine
#: @alias Id {integer}

#: <T> fn(x: T[], y: Id[]) -> integer[]
f <- function(x, y) y
#++++
f: <T> fn(x: T[], y: Id[]) -> integer[]

#==== placement
#---- type_definition_below_top_level_is_refused
value <- {
  #: @type Person {list{name: character}}
  1L
}
#++++
value: integer
13..52 error[annotation] Type definition blocks are only allowed at the top level of a file.
