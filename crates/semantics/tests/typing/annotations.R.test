#==== nested_definitions
#---- a_nested_annotation_pushes_parameter_types_into_the_body
outer <- function() {
  #: fn(x: character) -> integer
  inner <- function(x) x + 1L
  inner("a")
}
#++++
outer: Unknown
78..79 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- a_nested_annotation_checks_its_return
outer <- function() {
  #: fn(x: double[]) -> double
  inner <- function(x) "text"
  inner(c(1, 2))
}
#++++
outer: Unknown
76..82 error[type-mismatch] expected `double`, found `character`

#---- a_nested_annotation_checks_its_call_sites
outer <- function() {
  #: fn(x: double[]) -> double
  inner <- function(x) x[[1L]]
  inner("bad")
}
#++++
outer: Unknown
92..97 error[type-mismatch] expected `double[]`, found `character`

#==== unknown_only_coercions
#---- if_unknown_fills_a_genuine_gap
frame <- data.frame(a = 1)

#: @if-unknown integer
gap <- frame$a
#++++
frame: Unknown
gap: integer

#---- if_unknown_on_a_known_type_is_an_error
#: @if-unknown integer
known <- 1L
#++++
known: Unknown
32..34 error[type-mismatch] `@if-unknown` applies only where the type is unknown, and this is already `integer` — drop the annotation, or use `#:` to check the type or `@trust` to override it

#---- the_coerced_type_is_then_enforced
frame <- data.frame(a = 1)

#: @if-unknown character
gap <- frame$a
label <- gap + 1L
#++++
frame: Unknown
gap: character
label: Unknown
77..80 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#==== checked
#---- declared_scheme_wins
#: <T> fn(x: T) -> T
id <- function(x) x
#++++
id: <T> fn(x: T) -> T

#---- return_mismatch
#: fn(x: integer) -> character
f <- function(x) x
#++++
f: fn(x: integer) -> character
48..49 error[type-mismatch] expected `character`, found `integer`

#---- parameter_name_mismatch
#: fn(x: integer) -> integer
f <- function(y) 1L
#++++
f: fn(x: integer) -> integer
34..48 error[type-mismatch] this annotation names a parameter `x`, but the function does not define one — annotation parameter names must match the function's parameter names

#---- rigid_refuses_undeclared_bound
#: <T> fn(x: T) -> T
bad <- function(x) x + 1L
#++++
bad: <T> fn(x: T) -> T
40..41 error[type-mismatch] expected a numeric value (`integer` or `double`), found `T`

#---- declared_numeric_bound_admits_arithmetic
#: <T: numeric> fn(x: T) -> T
ok <- function(x) x + 1L
#++++
ok: <T: numeric> fn(x: T) -> T

#---- expanded_form
#: @forall T: numeric
#: @param x {T}
#: @return {T}
round2 <- function(x) x + 1L
#++++
round2: <T: numeric> fn(x: T) -> T

#---- value_annotation_checks
#: integer
n <- 1L
#: character
bad <- 2L
#++++
n: integer
bad: character
39..41 error[type-mismatch] expected `character`, found `integer`

#==== trusted
#---- trust_skips_enforcement
#: @trust fn(x: integer) -> character
f <- function(x) x
#++++
f: fn(x: integer) -> character

#==== blocks
#---- definition_mixed_with_compact_is_refused
#: @type Person {list{name: character}}
#: integer
n <- 1L
#++++
n: integer
0..50 error[annotation] `@type` and `@alias` declarations need their own `#:` block — separate them from other annotations with a blank line.

#---- definition_mixed_with_expanded_is_refused
#: @type Person {list{name: character}}
#: @param count {integer}
#: @return {Person}
make <- function(count) list(name = "a")
#++++
make: <T> fn(count: T) -> list{name: character}
0..85 error[annotation] `@type` and `@alias` declarations need their own `#:` block — separate them from other annotations with a blank line.

#---- compact_mixed_with_expanded_is_refused
#: fn(x: integer) -> integer
#: @return {integer}
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
0..49 error[annotation] a `#:` block uses either one compact annotation or `@param`/`@return` lines, not both — separate the two forms with a blank line.

#---- multiple_compact_annotations_are_refused
#: integer
#: double
n <- 1L
#++++
n: integer
0..20 error[annotation] only one compact annotation fits in a `#:` block — separate the annotations with a blank line so each gets its own block.

#---- declared_return_mismatch_blames_the_tail_expression
#: fn(x: integer) -> character
f <- function(x) {
  y <- x + 1L
  y
}
#++++
f: fn(x: integer) -> character
66..67 error[type-mismatch] expected `character`, found `integer`

#---- duplicate_type_declarations_error_at_every_site
#: @type Point {list{v: double}}

#: @alias Point {integer}

#: @new Point
origin <- list(v = 1)
#++++
origin: list{v: double}
3..32 error[annotation] the type name `Point` is declared more than once — `@type` and `@alias` declarations share one project-global namespace.
37..59 error[annotation] the type name `Point` is declared more than once — `@type` and `@alias` declarations share one project-global namespace.

#==== form
#---- param_after_return_is_refused
#: @return {integer}
#: @param count {integer}
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
24..46 error[annotation] `@param` directives must appear before `@return` or `@returns` in the same `#:` block.

#---- multiple_returns_are_refused
#: @param count {integer}
#: @return {integer}
#: @returns {character}
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
50..70 error[annotation] cannot use more than one `@return` or `@returns` directive in the same `#:` block.

#---- forall_after_param_is_refused
#: @param count {integer}
#: @forall T
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
29..38 error[annotation] `@forall` directives must appear before `@param`, `@return`, or `@returns` in the same `#:` block.

#---- duplicate_forall_parameter_is_refused
#: @forall T
#: @forall T
#: @param value {T}
#: @return {T}
f <- function(value) value
#++++
f: <T> fn(value: T) -> T
24..29 error[annotation] duplicate type parameter name `T` in expanded function annotation.

#---- duplicate_compact_binder_is_refused
#: <T, T> fn(x: T) -> T
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
7..8 error[annotation] duplicate type parameter name `T` in `<...>`.

#---- duplicate_definition_parameter_is_refused
#: @type Pair<T, T> {list{a: T, b: T}}
value <- 1L
#++++
value: integer
17..18 error[annotation] duplicate type parameter name `T` in named type definition.

#---- unknown_constraint_name_is_refused
#: <T: frobnicate> fn(x: T) -> T
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
7..17 error[annotation] unknown type-parameter constraint `frobnicate`; the available constraints are `numeric` and `atomic`.

#---- applied_type_parameter_is_refused
#: @alias Wrap<T> {list{v: T}}

#: @alias Outer<Wrap> {Wrap<integer>}
value <- 1L
#++++
value: integer
55..68 error[annotation] `Wrap` is a type parameter here and takes no type arguments.

#==== dangling
#---- empty_annotation_is_refused
#:
value <- 1L
#++++
value: integer
0..2 error[annotation] A `#:` typing comment must include a type expression.

#---- annotation_at_end_of_file_is_refused
value <- 1L
#: integer
#++++
value: integer
12..22 error[annotation] A `#:` typing comment must be followed immediately by an expression.

#---- blank_line_breaks_the_annotation
#: integer

value <- "s"
#++++
value: character
0..10 error[annotation] A `#:` typing comment cannot be separated from its expression by an empty line.

#---- comment_between_annotation_and_expression_is_refused
#: integer
# note
value <- 1L
#++++
value: integer
0..10 error[annotation] A `#:` typing comment must be followed immediately by an expression.

#---- expanded_annotation_separated_by_blank_line_is_refused
#: @param count {integer}

render <- function(count) count
#++++
render: <T> fn(count: T) -> T
0..25 error[annotation] A `#:` typing comment cannot be separated from its expression by an empty line.

#---- definitions_and_strict_toggles_need_no_target
#: @type Person {list{name: character}}

#: @strict off

value <- 1L
#++++
value: integer

#==== new_shape
#---- new_requires_a_nominal_reference
#: @new integer
value <- 1L
#++++
value: integer
8..15 error[annotation] expected a nominal type reference after `@new`.

#---- new_on_alias_is_refused
#: @alias Meters {double}

#: @new Meters
h <- 1.8
#++++
h: double
35..41 error[annotation] `@new` requires a nominal type declared with `@type`, but `Meters` is an alias.

#==== vectors
#---- alias_vector_element_must_be_atomic
#: @alias Person {list{name: character}}

#: fn(x: Person[]) -> NULL
f <- function(x) NULL
#++++
f: fn(x: Person[]) -> NULL
51..59 error[type-mismatch] the element of a `[]` vector type must be an atomic type, found `Person` — for a list of these, write `list[Person]`

#---- structural_vector_element_is_refused
#: fn(x: list{name: character}[]) -> NULL
f <- function(x) NULL
#++++
f: fn(x: list{name: character}[]) -> NULL
9..32 error[type-mismatch] the element of a `[]` vector type must be an atomic type, found `list{name: character}` — for a list of these, write `list[list{name: character}]`

#---- atomic_alias_and_binder_vector_elements_are_fine
#: @alias Id {integer}

#: <T> fn(x: T[], y: Id[]) -> integer[]
f <- function(x, y) y
#++++
f: <T> fn(x: T[], y: Id[]) -> integer[]

#==== declared_shape
#---- declared_optional_requires_an_actual_default
#: fn(count: integer, [label]: character) -> integer
double_count <- function(count, label) count + count
#++++
double_count: fn(count: integer, [label]: character) -> integer
69..105 error[type-mismatch] expected `fn(count: integer, [label]: character) -> integer`, found `fn(count: integer, label: character) -> integer`

#---- rest_position_must_match_the_formals
#: fn(...: Any, x: integer) -> integer
f <- function(x, ...) x
#++++
f: fn(...: Any, x: integer) -> integer
44..62 error[type-mismatch] expected `fn(...: Any, x: integer) -> integer`, found `fn(x: integer, ...: Any) -> integer`

#---- fixed_annotation_on_a_variadic_function_is_rejected
#: fn(x: integer) -> integer
f <- function(x, ...) x
#++++
f: fn(x: integer) -> integer
34..52 error[type-mismatch] expected `fn(x: integer) -> integer`, found `fn(x: integer, ...: Any) -> integer`

#---- variadic_annotation_on_a_fixed_function_is_rejected
#: fn(x: integer, ...: Any) -> integer
f <- function(x) x
#++++
f: fn(x: integer, ...: Any) -> integer
44..57 error[type-mismatch] expected `fn(x: integer, ...: Any) -> integer`, found `fn(x: integer) -> integer`

#---- matching_shapes_are_fine
#: fn(count: integer, [label]: character, ...: Any) -> integer
render <- function(count, label = "x", ...) count
#++++
render: fn(count: integer, [label]: character, ...: Any) -> integer

#==== expression_level
#---- new_on_a_local_assignment_constructs_the_nominal
#: @type Person {list{name: character}}

#: fn(name: character) -> Person
make_person <- function(name) {
  #: @new Person
  person <- list(name = name)
  person
}
#++++
make_person: fn(name: character) -> Person

#---- new_on_the_block_final_expression
#: @type User {list{name: character, age: integer}}

#: fn(name: character, age: integer) -> User
create_user <- function(name, age) {
  #: @new User
  list(name = name, age = age)
}
#++++
create_user: fn(name: character, age: integer) -> User

#---- new_with_incompatible_representation_errors
#: @type Person {list{name: character}}

make <- function() {
  #: @new Person
  list(name = 1L)
}
#++++
make: Unknown
81..96 error[type-mismatch] expected `list{name: character}`, found `list{name: integer}`

#---- checked_annotation_on_a_local_binding
f <- function() {
  #: integer
  count <- "many"
  count
}
#++++
f: Unknown
42..48 error[type-mismatch] expected `integer`, found `character`

#---- trusted_local_overrides_unchecked
f <- function() {
  #: @trust integer
  count <- "many"
  count
}
#++++
f: fn() -> integer

#---- checked_bare_expression_at_top_level
#: integer
"foo"
#++++
11..16 error[type-mismatch] expected `integer`, found `character`

#---- checked_bare_expression_matching_is_quiet
#: integer
1L
#++++

#---- blank_line_still_breaks_nested_attachment
f <- function() {
  #: integer

  count <- "many"
  count
}
#++++
f: fn() -> character
20..30 error[annotation] A `#:` typing comment cannot be separated from its expression by an empty line.

#==== alias_callees
#---- alias_typed_callee_expands_to_a_function
#: @alias Formatter {fn(count: integer) -> character}

#: Formatter
render <- function(count) "ok"
out <- render(1L)
#++++
render: Formatter
out: character

#---- alias_typed_callee_still_checks_arguments
#: @alias Formatter {fn(count: integer) -> character}

#: Formatter
render <- function(count) "ok"
out <- render("nope")
#++++
render: Formatter
out: Unknown
113..119 error[type-mismatch] expected `integer`, found `character`

#==== elided_returns
#---- elided_callback_return_means_null
#: @param cb {fn(integer)}
run_cb <- function(cb) cb(1L)
run_cb(function(x) x + 1L)
#++++
run_cb: fn(cb: fn(integer) -> NULL) -> Unknown
64..82 error[type-mismatch] expected `fn(integer) -> NULL`, found `fn(x: T) -> T`

#---- elided_callback_accepts_a_null_callback
#: @param cb {fn(integer)}
run_cb <- function(cb) cb(1L)
run_cb(function(x) NULL)
#++++
run_cb: fn(cb: fn(integer) -> NULL) -> Unknown

#---- elided_definition_return_still_infers
#: fn(count: integer)
f <- function(count) count
#++++
f: fn(count: integer) -> Unknown

#---- nested_compact_callback_elides_to_null
#: fn(cb: fn(integer)) -> NULL
run_cb <- function(cb) {
  cb(1L)
  NULL
}
run_cb(function(x) x + 1L)
#++++
run_cb: fn(cb: fn(integer) -> NULL) -> NULL
81..99 error[type-mismatch] expected `fn(integer) -> NULL`, found `fn(x: T) -> T`

#==== placement
#---- type_definition_below_top_level_is_refused
value <- {
  #: @type Person {list{name: character}}
  1L
}
#++++
value: integer
13..52 error[annotation] Type definition blocks are only allowed at the top level of a file.

#---- named_parameters_pair_by_name_not_order
#: fn(a: integer, b: character) -> character
f <- function(b, a) paste0(b, a)
#++++
f: fn(a: integer, b: character) -> character

#---- annotation_may_not_rename_a_parameter
#: fn(count: integer) -> integer
f <- function(n) n
#++++
f: fn(count: integer) -> integer
38..51 error[type-mismatch] this annotation names a parameter `count`, but the function does not define one — annotation parameter names must match the function's parameter names

#---- callback_parameter_contravariance
#: fn(callback: fn(x: integer) -> integer) -> integer
apply_it <- function(callback) callback(1L)

#: fn(x: integer | NULL) -> integer
wider <- function(x) if (is.null(x)) 0L else x
use_wider <- function() apply_it(wider)

#: fn(callback: fn(x: integer | NULL) -> integer) -> integer
apply_wide <- function(callback) callback(NULL)
#: fn(x: integer) -> integer
narrow <- function(x) x
use_narrow <- function() apply_wide(narrow)
#++++
apply_it: fn(callback: fn(x: integer) -> integer) -> integer
wider: fn(x: integer | NULL) -> integer
use_wider: fn() -> integer
apply_wide: fn(callback: fn(x: integer | NULL) -> integer) -> integer
narrow: fn(x: integer) -> integer
use_narrow: Unknown
421..427 error[type-mismatch] expected `fn(x: integer | NULL) -> integer`, found `fn(x: integer) -> integer`

#---- variadic_and_fixed_arity_never_pair
#: fn(callback: fn(...: integer) -> integer) -> integer
apply_variadic <- function(callback) callback(1L, 2L)
#: fn(x: integer) -> integer
fixed <- function(x) x
use_fixed <- function() apply_variadic(fixed)
#++++
apply_variadic: fn(callback: fn(...: integer) -> integer) -> integer
fixed: fn(x: integer) -> integer
use_fixed: Unknown
201..206 error[type-mismatch] expected `fn(...: integer) -> integer`, found `fn(x: integer) -> integer`
