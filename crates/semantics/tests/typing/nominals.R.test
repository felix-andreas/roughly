#==== aliases
#---- alias_is_transparent
#: @alias UserId {integer}

#: fn(x: UserId) -> UserId
bump <- function(x) x + 1L
use <- function() bump(7L)
#++++
bump: fn(x: UserId) -> UserId
use: fn() -> integer

#---- generic_alias_applies
#: @alias Pair<T> {list{T, T}}

#: fn(p: Pair<integer>) -> integer
first <- function(p) p[[1L]]
#++++
first: fn(p: Pair<integer>) -> integer

#---- alias_self_cycle_used
#: @alias A {A}

#: A
value <- 1L
#++++
value: Unknown
22..33 error[type-mismatch] Type alias `A` expands in a cycle.

#---- alias_mutual_cycle_used
#: @alias A {B}
#: @alias B {A}

#: A
value <- 1L
#++++
value: Unknown
38..49 error[type-mismatch] Type alias `A` expands in a cycle.

#==== nominals
#---- new_introduces_and_projects
#: @type Person {list{name: character, age: integer}}

#: @new Person
default_person <- list(name = "ada", age = 36L)
greet <- function() default_person$name
#++++
default_person: Person
greet: fn() -> character

#---- structural_value_needs_new
#: @type Person {list{name: character, age: integer}}

#: fn(p: Person) -> character
name_of <- function(p) p$name
imposter <- function() name_of(list(name = "eve", age = 1L))
#++++
name_of: fn(p: Person) -> character
imposter: Unknown
146..174 error[type-mismatch] expected `Person`, found `list{name: character, age: integer}`

#---- new_checks_the_representation
#: @type Person {list{name: character, age: integer}}

#: @new Person
broken <- list(name = 42L, age = 36L)
#++++
broken: Unknown
80..107 error[type-mismatch] expected `list{name: character, age: integer}`, found `list{name: integer, age: integer}`

#---- generic_nominal_fully_applied
#: @type Box<T> {list{value: T}}

#: @new Box<integer>
int_box <- list(value = 1L)
unwrap <- function() int_box$value
#++++
int_box: Box<integer>
unwrap: fn() -> integer

#---- distinct_nominals_do_not_mix
#: @type Meters {double}
#: @type Feet {double}

#: @new Meters
height <- 1.8
#: fn(m: Meters) -> Meters
keep <- function(m) m
#: @new Feet
imperial <- 6.0
mixed <- function() keep(imperial)
#++++
height: Meters
keep: fn(m: Meters) -> Meters
imperial: Feet
mixed: Unknown
181..189 error[type-mismatch] expected `Meters`, found `Feet`

#---- arithmetic_projects_to_the_representation
#: @type Meters {double}

#: fn(m: Meters) -> Meters
double_it <- function(m) m * 2
#++++
double_it: Unknown
78..83 error[type-mismatch] expected `Meters`, found `double`

#==== unknown_names
#---- misspelled_type_inside_a_type_body
#: @type Instrument {list{isin: character}}

#: @type Future {list{instrument: Instument, expiry: character}}

#: @new Future
f <- list(instrument = list(isin = "DE1"), expiry = "2026-12")
#++++
f: Future
79..88 error[annotation] I do not know the type `Instument`. It is not a built-in type, a declared `@type` or `@alias` name, or a class from the standard-library stubs. Did you mean `Instrument`?

#---- unknown_type_in_a_checked_annotation
#: Instument
x <- 1L
#++++
x: Instument
3..12 error[annotation] I do not know the type `Instument`. It is not a built-in type, a declared `@type` or `@alias` name, or a class from the standard-library stubs.

#---- forward_reference_resolves_and_needs_new
#: Point
origin <- list(v = 1)
#: @type Point {list{v: double}}
#++++
origin: Unknown
19..30 error[type-mismatch] expected `Point`, found `list{v: double}`

#---- unknown_generic_application
#: Pair<integer>
x <- 1L
#++++
x: Pair<integer>
3..7 error[annotation] I do not know the type `Pair`. It is not a built-in type, a declared `@type` or `@alias` name, or a class from the standard-library stubs.

#---- stub_class_resolves
#: data.frame
frame <- read.csv("x.csv")
print(frame)
#++++
frame: data.frame

#==== generic_arity
#---- applied_arity_must_match
#: @type Box<T> {list{value: T}}

#: Box<integer, double>
b <- list(value = 1L)
#++++
b: Box<integer, double>
37..40 error[annotation] generic type `Box` expects 1 type argument, but found 2.

#---- non_generic_takes_no_arguments
#: @type Meters {double}

#: Meters<integer>
m <- 1.0
#++++
m: Meters<integer>
29..35 error[annotation] `Meters` is not a generic type — it takes no type arguments.

#---- bare_generic_reference_must_be_applied
#: @type Box<T> {list{value: T}}

#: Box
b <- list(value = 1L)
#++++
b: Box
37..40 error[annotation] generic type `Box` expects 1 type argument, but found 0.

#---- bare_generic_under_new_infers_its_arguments
#: @type Box<T> {list{value: T}}

#: @new Box
b <- list(value = 1L)
#++++
b: Box<integer>

#---- duplicate_named_argument_is_called_out
f <- function(x) x
g <- f(x = 1L, x = 2L)
#++++
f: <T> fn(x: T) -> T
g: Unknown
24..41 error[type-mismatch] this call names the argument `x` more than once — R matches each named parameter at most once

#==== s4
#---- set_generic_defines_the_name
setClass("Account", representation(balance = "numeric"))
setGeneric("deposit", function(account, amount) standardGeneric("deposit"))
setMethod("deposit", "Account", function(account, amount) account)
use <- function(account) deposit(account, 50)
#++++
use: <T> fn(account: T) -> Unknown
