#---- brackets_keep_the_class_through_chains
#description Imports: data.table
summarize <- function(path) {
  dt <- fread(path)
  dt[speed > 20][, .(m = mean(speed)), by = cyl]
}
#++++
summarize: fn(path: character) -> data.table

#---- walrus_assignment_returns_the_subject
#description Imports: data.table
add_ratio <- function(path) {
  dt <- fread(path)
  dt[, ratio := speed / dist]
}
#++++
add_ratio: fn(path: character) -> data.table

#---- grouped_j_always_returns_a_table
#description Imports: data.table
per_group <- function(path) {
  dt <- fread(path)
  dt[, sum(speed), by = cyl]
}
#++++
per_group: fn(path: character) -> data.table

