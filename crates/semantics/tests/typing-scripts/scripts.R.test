print(y)
#++++
x: integer
y: integer

#---- an_on_exit_read_keeps_later_writes_alive
# R stores `on.exit`'s expression and runs it when the function returns, so it
# observes the LAST value of what it reads. Treating it as an ordinary argument
# made the canonical rollback guard a dead store — and deleting that write, the
# obvious response to the warning, makes every transaction roll back.
guard <- function(con) {
  committed <- FALSE
  on.exit(if (!committed) rollback(con))
  committed <- TRUE
  invisible(committed)
}
print(guard)
#++++
guard: <T> fn(con: T) -> logical
383..391 warning[unresolved] I could not resolve `rollback` in this package, its imports, or builtins.

#---- a_real_dead_store_beside_an_on_exit_guard_still_reports
guard <- function(con) {
  committed <- FALSE
  on.exit(if (!committed) rollback(con))
  scratch <- 1L
  scratch <- 2L
  committed <- TRUE
  invisible(scratch)
}
print(guard)
#++++
guard: <T> fn(con: T) -> integer
72..80 warning[unresolved] I could not resolve `rollback` in this package, its imports, or builtins.
89..96 warning[unused] `scratch` is assigned but never used.

#---- s3_dispatch_is_a_use
# Nothing reads `speak.dog` — every call goes through the generic — so the
# liveness walk cannot see the use. Calling the method dead is a false positive
# on code that works, and a script cannot export its way out of it.
speak <- function(x, ...) UseMethod("speak")
speak.dog <- function(x, ...) "woof"
speak.default <- function(x, ...) "..."
print(speak(structure(list(), class = "dog")))
#++++
speak: <T> fn(x: T, ...: Any) -> Any
speak.dog: <T> fn(x: T, ...: Any) -> character
speak.default: <T> fn(x: T, ...: Any) -> character

