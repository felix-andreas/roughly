total <- sum(sizes)
#++++
sizes: integer[]
total: integer
23..28 warning[unused] `total` is assigned but never used.

#---- script_definition_shadows_a_stub
sum <- function(a, b) a + b
shadowed <- sum(1L, 2L)
#++++
sum: <T: numeric> fn(a: T, b: T) -> T
shadowed: integer
28..36 warning[unused] `shadowed` is assigned but never used.

#---- aliased_function_reference_exports_closed
f <- function(p) p
g <- f
h <- function() g()
#++++
f: <T> fn(p: T) -> T
g: fn(p: Unknown) -> Unknown
h: Unknown
26..27 warning[unused] `h` is assigned but never used.
42..43 error[type-mismatch] this call supplies 0 arguments, but the function requires 1 — a required argument is missing

#---- unused_marks_the_name_not_the_multiline_value
helper <- function(count) {
  count + 1L
}
#++++
helper: <T: numeric> fn(count: T) -> T
0..6 warning[unused] `helper` is assigned but never used.

#---- a_declared_contract_survives_a_failing_body
#: fn(spec: character) -> integer
steps_for <- function(spec) "not an integer"
count <- steps_for(42L)
print(count)
#++++
steps_for: fn(spec: character) -> integer
count: Unknown
62..78 error[type-mismatch] expected `integer`, found `character`
98..101 error[type-mismatch] expected `character`, found `integer`

#==== resolution
#---- use_before_any_definition_is_unresolved
b <- a
a <- 1L
print(b)
print(a)
#++++
b: Unknown
a: integer
5..6 warning[unresolved] I could not resolve `a` in this package, its imports, or builtins.

#---- read_inside_the_defining_statement_is_unresolved
x <- x + 1L
print(x)
#++++
x: Unknown
5..6 warning[unresolved] I could not resolve `x` in this package, its imports, or builtins.

#---- self_recursive_closure_resolves
a <- function() a()
print(a())
#++++
a: fn() -> Unknown

#---- forward_capture_resolves_to_the_later_binding
f <- function() y + 1L
y <- 2L
print(f())
#++++
f: fn() -> integer
y: integer

#---- deferred_read_sees_the_last_binding
g <- function() g()
h <- g
g <- function(x) x
print(h())
print(g(1L))
#++++
g: Unknown
h: Unknown
g: <T> fn(x: T) -> T
16..17 error[type-mismatch] this call supplies 0 arguments, but the function requires 1 — a required argument is missing

#==== conditional_slots
#---- loop_binding_resolves_a_later_read
for (i in 1:3) x <- i
print(x)
#++++

#---- loop_binding_with_no_read_warns
for (i in 1:3) dead <- i + 1L
#++++
15..19 warning[unused] `dead` is assigned but never used.

#---- loop_reading_its_carried_variable_stays_alive
x <- 1L
while (x > 0L) x <- x - 1L
#++++
x: integer

#---- conditional_rebinding_keeps_the_earlier_definition_alive
g <- function(x) x
for (i in 1:3) g <- f + i
print(g)
#++++
g: <T> fn(x: T) -> T
39..40 warning[unresolved] I could not resolve `f` in this package, its imports, or builtins.

#==== reads_that_keep_bindings_alive
#---- pipe_read_is_a_use
x <- 1L
y <- x |> print()
print(y)
#++++
x: integer
y: integer

#---- operator_use_is_a_use
`%||%` <- function(a, b) if (is.null(a)) b else a
fallback <- NULL %||% 3L
print(fallback)
#++++
%||%: <T> fn(a: T | NULL, b: T) -> T
fallback: Unknown

#---- an_operator_nothing_uses_still_warns
`%unused%` <- function(a, b) a
print(1L)
#++++
%unused%: <T, U> fn(a: T, b: U) -> T
0..10 warning[unused] `%unused%` is assigned but never used.

#---- masked_read_is_a_use
x <- 1L
out <- with(list(y = 2L), x + y)
print(out)
#++++
x: integer
out: Unknown

#==== loop_carried_reads
#---- rebinding_reads_the_nearest_earlier_binding
p <- "word"
p <- p - 1L
#++++
p: character
p: Unknown
12..13 warning[unused] `p` is assigned but never used.
17..18 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- loop_carried_read_starts_from_the_earlier_binding
p <- "word"
while (TRUE) p <- p - 1L
#++++
p: character
30..31 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

