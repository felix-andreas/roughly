#==== nominal_introduction
#---- new_with_incompatible_value
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = 1L)
#++++
error[type-error] expected `list{name: character}`, found `list{name: integer}`
--> 4:1-4:26
| person <- list(name = 1L)

#---- structural_value_for_nominal_parameter
#: @type Person {list{name: character}}

#: fn(value: Person) -> character
get_name <- function(value) value$name

get_name(list(name = "bob"))
#++++
error[type-error] expected `Person`, found `list{name: character}`
--> 6:10-6:28
| get_name(list(name = "bob"))

#---- cross_nominal_argument
#: @type Cat {list{name: character}}
#: @type Dog {list{name: character}}

#: fn(value: Cat) -> character
pet_cat <- function(value) value$name

#: @new Dog
dog <- list(name = "rex")
pet_cat(dog)
#++++
error[type-error] expected `Cat`, found `Dog`
--> 9:9-9:12
| pet_cat(dog)
