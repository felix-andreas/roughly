#==== definitions
#---- definition_can_reference_previous_definition
#---- R/main.R
#: @type Person {list{name: character}}
#: @type Team {list{owner: Person}}
value <- 1L
#++++
TypeDefinition(Person = list{name: character})
TypeDefinition(Team = list{owner: Person})
Assign(value@b0)
  Integer(1L)

#---- definition_forward_reference_same_file
#---- R/main.R
#: @type Team {list{owner: Person}}
#: @type Person {list{name: character}}
value <- 1L
#++++
TypeDefinition(Team = list{owner: Person})
TypeDefinition(Person = list{name: character})
Assign(value@b0)
  Integer(1L)

#---- definition_forward_reference_resolves_across_files
#---- R/a.R
#: @type Team {list{owner: Person}}
#++++
TypeDefinition(Team = list{owner: Person})
#---- R/b.R
#: @type Person {list{name: character}}
#++++
TypeDefinition(Person = list{name: character})
#---- R/c.R
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)

#---- alias_can_reference_nominal_from_other_file
#---- R/a.R
#: @type Person {list{name: character}}
#++++
TypeDefinition(Person = list{name: character})
#---- R/b.R
#: @alias TeamOwner {Person}
#++++
TypeAlias(TeamOwner = Person)

#==== annotations
#---- annotation_can_reference_declared_nominal
#---- R/main.R
#: @type Person {integer}

#: Person
value <- 1L
#++++
TypeDefinition(Person = integer)
Assign(value@b0)
  Integer(1L)

#---- annotation_can_reference_alias
#---- R/main.R
#: @alias Count {integer}

#: Count
value <- 1L
#++++
TypeAlias(Count = integer)
Assign(value@b0)
  Integer(1L)

#---- annotation_uses_nominal_type_from_other_file
#---- R/a.R
#: @type Person {integer}
#++++
TypeDefinition(Person = integer)
#---- R/b.R
#: Person
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)

#---- annotation_uses_alias_from_other_file
#---- R/a.R
#: @alias Count {integer}
#++++
TypeAlias(Count = integer)
#---- R/b.R
#: Count
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)

#---- annotation_forward_reference_resolves_across_files
#---- R/a.R
#: Person
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)
#---- R/b.R
#: @type Person {integer}
#++++
TypeDefinition(Person = integer)

#==== nominal_introduction
#---- nominal_introduction_accepts_nominal_type
#---- R/main.R
#: @type Person {list{name: character}}

#: @new Person
value <- list(name = "bob")
#++++
TypeDefinition(Person = list{name: character})
Assign(value@b0)
  Call
    Symbol(list@?)
    Argument(name)
      Character("\"bob\"")

#---- nominal_introduction_uses_type_from_other_file
#---- R/a.R
#: @type Person {list{name: character}}
#++++
TypeDefinition(Person = list{name: character})
#---- R/b.R
#: @new Person
value <- list(name = "bob")
#++++
Assign(value@b0)
  Call
    Symbol(list@?)
    Argument(name)
      Character("\"bob\"")

#---- nominal_introduction_accepts_fully_applied_generic_type
#---- R/main.R
#: @type Person<T> {list{value: T}}

#: @new Person<integer>
value <- list(value = 1L)
#++++
TypeDefinition(Person<T> = list{value: T})
Assign(value@b0)
  Call
    Symbol(list@?)
    Argument(value)
      Integer(1L)
