#==== function_globals
#---- top_level_binding_used_inside_function
x <- 1L
f <- function() x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Symbol(x@?)

No diagnostics.

#==== nested_functions
#---- nested_function_closes_over_outer_local
f <- function() {
  x <- 1L
  g <- function() x
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(x@b1)
        Integer(1L)
      Assign(g@b2)
        Function()
          Symbol(x@b1)

No diagnostics.

#---- nested_function_closes_over_outer_parameter
f <- function(x) {
  g <- function() x
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(g@b2)
        Function()
          Symbol(x@b1)

No diagnostics.

#---- nested_function_closes_over_top_level_global
x <- 1L
f <- function() {
  g <- function() x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Assign(g@b2)
        Function()
          Symbol(x@?)

No diagnostics.

#---- multi_hop_nested_function_closes_over_outer_local
f <- function() {
  x <- 1L
  g <- function() {
    h <- function() x
  }
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(x@b1)
        Integer(1L)
      Assign(g@b2)
        Function()
          Block
            Assign(h@b3)
              Function()
                Symbol(x@b1)

No diagnostics.

#---- closure_parameter_shadows_enclosing_binding
f <- function() {
  x <- 1L
  g <- function(x) x
}
#++++
Assign(f@b0)
  Function()
    Block
      Assign(x@b1)
        Integer(1L)
      Assign(g@b2)
        Function(x@b3)
          Symbol(x@b3)

No diagnostics.

#---- closure_local_shadows_enclosing_binding
f <- function(x) {
  g <- function() {
    x <- "ok"
    x
  }
}
#++++
Assign(f@b0)
  Function(x@b1)
    Block
      Assign(g@b2)
        Function()
          Block
            Assign(x@b3)
              Character("\"ok\"")
            Symbol(x@b3)

No diagnostics.

#---- closure_uses_nearest_shadowing_binding_across_hops
x <- 1L
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    h <- function() x
  }
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Assign(x@b2)
        Character("\"outer\"")
      Assign(g@b3)
        Function()
          Block
            Assign(x@b4)
              Logical(true)
            Assign(h@b5)
              Function()
                Symbol(x@b4)

No diagnostics.

#==== recursive_closures
#---- local_recursive_function_resolves_its_own_name
driver <- function(n) {
  fact <- function(k) {
    if (k <= 1L) 1L else k * fact(k - 1L)
  }
  fact(n)
}
#++++
Assign(driver@b0)
  Function(n@b1)
    Block
      Assign(fact@b2)
        Function(k@b3)
          Block
            If
              Call
                Symbol(<=@?)
                Argument
                  Symbol(k@b3)
                Argument
                  Integer(1L)
              Integer(1L)
              Call
                Symbol(*@?)
                Argument
                  Symbol(k@b3)
                Argument
                  Call
                    Symbol(fact@b2)
                    Argument
                      Call
                        Symbol(-@?)
                        Argument
                          Symbol(k@b3)
                        Argument
                          Integer(1L)
      Call
        Symbol(fact@b2)
        Argument
          Symbol(n@b1)

No diagnostics.

#---- non_closure_rhs_still_reads_the_old_binding
outer_value <- 1L
f <- function() {
  outer_value <- outer_value + 1L
  outer_value
}
#++++
Assign(outer_value@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Block
      Assign(outer_value@b2)
        Call
          Symbol(+@?)
          Argument
            Symbol(outer_value@?)
          Argument
            Integer(1L)
      Symbol(outer_value@b2)

No diagnostics.

#==== data_masking
#---- data_table_brackets_mask_column_references
report <- function(dt) {
  dt[region == "west", .(total = sum(amount)), by = product]
}
#++++
Assign(report@b0)
  Function(dt@b1)
    Block
      Subset
        Symbol(dt@b1)
        Argument
          Call
            Symbol(==@masked)
            Argument
              Symbol(region@masked)
            Argument
              Character("\"west\"")
        Argument
          Call
            Symbol(.@masked)
            Argument(total)
              Call
                Symbol(sum@masked)
                Argument
                  Symbol(amount@masked)
        Argument(by)
          Symbol(product@masked)

No diagnostics.

#---- walrus_marks_the_mask
add_revenue <- function(dt) {
  dt[, revenue := price * quantity]
}
#++++
Assign(add_revenue@b0)
  Function(dt@b1)
    Block
      Subset
        Symbol(dt@b1)
        Argument
          Call
            Symbol(:=@masked)
            Argument
              Symbol(revenue@masked)
            Argument
              Call
                Symbol(*@masked)
                Argument
                  Symbol(price@masked)
                Argument
                  Symbol(quantity@masked)

No diagnostics.

#---- base_indexing_stays_lexical
pick <- function(m) {
  m[not_a_column]
}
#++++
Assign(pick@b0)
  Function(m@b1)
    Block
      Subset
        Symbol(m@b1)
        Argument
          Symbol(not_a_column@?)

No diagnostics.

#---- with_family_masks_after_the_data
peek <- function(dt) {
  with(dt, mean(score_col))
}
#++++
Assign(peek@b0)
  Function(dt@b1)
    Block
      Call
        Symbol(with@?)
        Argument
          Symbol(dt@b1)
        Argument
          Call
            Symbol(mean@masked)
            Argument
              Symbol(score_col@masked)

No diagnostics.
