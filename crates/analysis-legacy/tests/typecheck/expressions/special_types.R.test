#==== explicit_special_types
#---- any_annotation_accepts_integer
#: Any
value <- 1L
value
#++++
Any
Any

#---- any_annotation_accepts_null
#: Any
value <- NULL
value
#++++
Any
Any

#---- any_annotation_accepts_unknown
#: Any
value <- 1L ~ 2L
value
#++++
Any
Any

#---- unsupported_construct_infers_unknown
1L ~ 2L
#++++
Unknown

#---- unknown_only_coercion_accepts_unknown
#: @if-unknown integer
value <- 1L ~ 2L
value
#++++
integer
integer

#---- unknown_only_coercion_rejects_known_type
#: @if-unknown integer
value <- 1L
#++++
error: type mismatch

#---- trusted_coercion_overrides_incompatible_source
#: @trust integer
value <- "hello"
value
#++++
integer
integer

#---- checked_annotation_rejects_unknown
#: integer
value <- 1L ~ 2L
#++++
error: type mismatch

#==== nullable_unions
#---- nullable_union_annotation_accepts_integer
#: integer | NULL
value <- 1L
value
#++++
integer | NULL
integer | NULL

#---- nullable_union_annotation_accepts_null
#: integer | NULL
value <- NULL
value
#++++
integer | NULL
integer | NULL

#---- nullable_union_not_assignable_to_plain_integer
#: integer
value <- if (TRUE) 1L
#++++
error: type mismatch

#==== unknown_propagation
#---- unknown_argument_is_accepted_without_cascading
unsupported <- 1L ~ 2L

#: fn(count: integer) -> integer
double_count <- function(count) count + count
double_count(unsupported)
#++++
Unknown
fn(count: integer) -> integer
integer

#---- unknown_callee_call_evaluates_to_unknown
unsupported <- 1L ~ 2L
unsupported(1L)
#++++
Unknown
Unknown

#---- any_callee_call_evaluates_to_any
#: @trust Any
callee <- 1L
callee(1L)
#++++
Any
Any

#---- any_argument_is_accepted
#: @trust Any
anything <- 1L

#: fn(count: integer) -> integer
double_count <- function(count) count + count
double_count(anything)
#++++
Any
fn(count: integer) -> integer
integer

#---- unknown_in_arithmetic_stays_unknown
unsupported <- 1L ~ 2L
unsupported + 1L
#++++
Unknown
Unknown

#==== multi_member_unions
#---- union_annotation_accepts_integer
#: integer | character
value <- 1L
value
#++++
integer | character
integer | character

#---- union_annotation_accepts_character
#: integer | character
value <- "two"
value
#++++
integer | character
integer | character

#---- union_annotation_rejects_non_member
#: integer | character
value <- TRUE
#++++
error: type mismatch

#---- member_accepted_where_union_parameter_expected
#: fn(value: integer | character | NULL) -> logical
accepts <- function(value) TRUE

accepts(1L)
#++++
fn(value: integer | character | NULL) -> logical
logical

#---- null_accepted_where_union_contains_null
#: fn(value: integer | character | NULL) -> logical
accepts <- function(value) TRUE

accepts(NULL)
#++++
fn(value: integer | character | NULL) -> logical
logical

#---- union_rejected_where_plain_member_expected
#: integer | character
value <- 1L

#: integer
narrowed <- value
#++++
error: type mismatch

#---- union_accepted_where_wider_union_expected
#: integer | NULL
narrow <- 1L

#: integer | character | NULL
wide <- narrow
wide
#++++
integer | NULL
integer | character | NULL
integer | character | NULL

#---- union_rejected_where_narrower_union_expected
#: integer | character | NULL
wide <- 1L

#: integer | NULL
narrow <- wide
#++++
error: type mismatch

#---- alias_expansion_into_union_dedupes
#: @alias MaybeCount {integer | NULL}

#: MaybeCount | integer | NULL
value <- 1L
value
#++++
integer | NULL
integer | NULL
