#==== functions
#---- scalar_binding
value <- 1L
#++++
value: integer

#---- character_binding
label <- "ok"
#++++
label: character

#---- identity_binding
mirror <- function(x) x
#++++
mirror: <T> fn(x: T) -> T

#---- first_binding
first <- function(x, y) x
#++++
first: <T, U> fn(x: T, y: U) -> T

#---- annotated_optional_parameter_binding
#: @param count {integer}
#: @param [label] {character}
#: @return {integer}
double_count <- function(count, label = NULL) count + count
#++++
double_count: fn(count: integer, [label]: character) -> integer

#---- constant_function_binding
render <- function(count) "ok"
#++++
render: <T> fn(count: T) -> character

#---- constant_integer_function_binding
const_integer <- function(x) 1L
#++++
const_integer: <T> fn(x: T) -> integer

#---- alias_of_polymorphic_binding
mirror <- function(x) x
alias <- mirror
#++++
mirror: <T> fn(x: T) -> T
alias: <T> fn(x: T) -> T

#---- annotated_monomorphic_binding
#: fn(integer) -> integer
increment <- function(value) value
#++++
increment: fn(integer) -> integer

#---- annotated_named_parameter_binding
#: fn(count: integer) -> integer
double_count <- function(count) count + count
#++++
double_count: fn(count: integer) -> integer

#---- higher_order_apply_binding
invoke <- function(f, value) f(value)
#++++
invoke: <T, U> fn(f: fn(T) -> U, value: T) -> U

#---- numeric_param_plus_literal
increment <- function(x) x + 1L
#++++
increment: <T: numeric> fn(x: T) -> T

#---- numeric_param_negate
negate <- function(x) -x
#++++
negate: <T: numeric> fn(x: T) -> T

#---- numeric_param_compare_literal
is_positive <- function(x) x > 0L
#++++
is_positive: <T: numeric> fn(x: T) -> logical

#---- numeric_two_params_sum
add <- function(a, b) a + b
#++++
add: <T: numeric> fn(a: T, b: T) -> T

#---- numeric_param_double_result
halve <- function(x) x / 2
#++++
halve: <T: numeric> fn(x: T) -> double

#---- numeric_variable_defaults_to_double_when_unpinned
increment <- function(x) x + 1L
#: Any
anything <- 1L
result <- increment(anything)
#++++
increment: <T: numeric> fn(x: T) -> T
anything: Any
result: double

#---- numeric_param_polymorphic_through_local_binding
compute <- function(x) {
  doubled <- x + x
  doubled
}
#++++
compute: <T: numeric> fn(x: T) -> T
