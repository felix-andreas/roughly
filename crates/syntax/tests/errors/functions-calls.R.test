#==== definitions
#---- function_missing_parameter_list
f <- function 1
#++++
error: expected `(` to open the parameter list, found number
 --> 1:15
  | f <- function 1
  |               ^

#---- function_unclosed_parameter_list
f <- function(x, y
#++++
error: unclosed `(`; expected `)` to close the parameter list
 --> 1:14
  | f <- function(x, y
  |              ^

#---- function_parameter_separator
f <- function(x y) x
#++++
error: missing `,` between these parameters
 --> 1:16
  | f <- function(x y) x
  |                ^

#---- function_parameter_separator_across_lines
f <- function(x
              y) x
#++++
error: missing `,` between these parameters
 --> 1:16
  | f <- function(x
  |                ^

#---- function_missing_default
f <- function(x = ) x
#++++
error: expected a default value after `=`
 --> 1:19
  | f <- function(x = ) x
  |                   ^

#---- function_missing_body
f <- function(x)
#++++
error: expected a function body
 --> 1:6
  | f <- function(x)
  |      ^^^^^^^^

#---- lambda_bad_parameter
g <- \(1) 1
#++++
error: expected a parameter name, found number
 --> 1:8
  | g <- \(1) 1
  |        ^

#==== calls
#---- call_missing_comma
total <- sum(1 2)
#++++
error: missing `,` between these arguments
 --> 1:15
  | total <- sum(1 2)
  |               ^

#---- call_missing_comma_across_lines
total <- sum(alpha
             beta)
#++++
error: missing `,` between these arguments
 --> 1:19
  | total <- sum(alpha
  |                   ^

#---- an_unclosed_call_stops_at_the_next_statement
# One finding, not five. Reading on adopted each following statement as another
# argument — a confident "missing `,`" per line, scaling with the file — and the
# adopted lines lost their definitions with it. A line that ASSIGNS is what
# tells an unclosed opener from a forgotten comma; the case above keeps its
# report because `beta)` is a fragment, not a statement.
totals <- sum(c(1, 2, 3)
a <- mean(c(1))
b <- mean(c(2))
c <- mean(c(3))
#++++
error: unclosed `(`; expected `)` to close it
 --> 6:14
  | totals <- sum(c(1, 2, 3)
  |              ^

#---- an_unclosed_subset_stops_at_the_next_statement
first <- values[1
second <- values[2]
#++++
error: unclosed `[`; expected `]` to close it
 --> 1:16
  | first <- values[1
  |                ^

#---- an_assignment_argument_on_its_own_line_is_still_an_argument
# The comma makes it a continuation, so the boundary rule must not fire: this is
# legal R and stays silent.
value <- run(
  1,
  x <- 2
)
#++++
no errors

#---- a_named_argument_on_the_next_line_is_a_forgotten_comma
# `name = value` on the following line is a NAMED ARGUMENT, so the boundary rule
# must not read it as the next statement — this is the ordinary forgotten comma
# in a multi-line call, and it earns the report that names the missing `,`.
# Treating `=` as an assignment gave this the unclosed-opener report instead,
# then broke the rest of the call into top-level statements, which drew lint and
# unused findings out of source that had not parsed: six findings for one comma.
config <- list(
  title = "Revenue"
  subtitle = "by quarter",
  width = 800
)
#++++
error: missing `,` between these arguments
 --> 8:20
  |   title = "Revenue"
  |                    ^

#---- call_separator_junk_still_recovers
total <- sum(1; 2)
#++++
error: expected `,` or `)` in this argument list, found `;`
 --> 1:15
  | total <- sum(1; 2)
  |               ^

#---- call_unclosed_nested
wrap <- f(g(1, h(2)
#++++
error: unclosed `(`; expected `)` to close it
 --> 1:10
  | wrap <- f(g(1, h(2)
  |          ^
error: unclosed `(`; expected `)` to close it
 --> 1:12
  | wrap <- f(g(1, h(2)
  |            ^

#---- call_argument_after_comma
f(1, )
#++++
no errors
