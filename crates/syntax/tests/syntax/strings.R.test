#==== quoting
#---- double_quoted
"hello"
#++++
SOURCE_FILE@0..7
  LITERAL@0..7
    STRING@0..7 "\"hello\""

#---- single_quoted
'hello'
#++++
SOURCE_FILE@0..7
  LITERAL@0..7
    STRING@0..7 "'hello'"

#---- nested_quotes
"it's"
#++++
SOURCE_FILE@0..6
  LITERAL@0..6
    STRING@0..6 "\"it's\""

#---- escaped_quote
"say \"hi\""
#++++
SOURCE_FILE@0..12
  LITERAL@0..12
    STRING@0..12 "\"say \\\"hi\\\"\""

#---- escape_soup
"\n\t\\\x41é\u{1F600}"
#++++
SOURCE_FILE@0..23
  LITERAL@0..23
    STRING@0..23 "\"\\n\\t\\\\\\x41é\\u{1F600}\""

#---- multiline_string
"line one
line two"
#++++
SOURCE_FILE@0..19
  LITERAL@0..19
    STRING@0..19 "\"line one\nline two\""

#---- unterminated
"never ends
#++++
