    NAME@0..1
      IDENT@0..1 "x"
    WHITESPACE@1..2 " "
    LESS_MINUS@2..4 "<-"
    WHITESPACE@4..5 " "
    LITERAL@5..6
      DOUBLE@5..6 "1"
    WHITESPACE@6..7 " "
    COMMENT@7..18 "# a comment"

