#---- calls_with_return_as_argument_name
# `return` is not a reserved word in R (it's not in `?Reserved`), so it is
# allowed as an argument name (#189).

fn(return = TRUE)
fn(return = )

# One specific example from #189
switch(
  x,
  return = ,
)
