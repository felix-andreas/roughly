#==== basics
#---- integer_literal
1L
#++++
integer

#---- double_literal
1.5
#++++
double

#---- character_literal
"hello"
#++++
character

#==== names
#---- known_name_after_assignment
value <- 1L
value
#++++
integer
integer

#---- unknown_name
missing_value
#++++
error: unknown name

#==== functions
#---- identity_function
identity <- function(x) x
#++++
fn(type1) -> type1

#---- call_identity_with_integer
identity <- function(x) x
identity(1L)
#++++
fn(type1) -> type1
integer

#---- call_identity_with_character
identity <- function(x) x
identity("hello")
#++++
fn(type1) -> type1
character

#---- polymorphic_assignment_multiple_types
identity <- function(x) x
first <- identity(1L)
second <- identity("hello")
#++++
fn(type1) -> type1
integer
character

#---- repeated_polymorphic_instantiations
identity <- function(x) x
first <- identity(1L)
second <- identity("hello")
third <- identity(2L)
#++++
fn(type1) -> type1
integer
character
integer

#==== calls
#---- arity_mismatch
identity <- function(x) x
identity(1L, 2L)
#++++
error: function arity mismatch

#---- calling_non_function
value <- 1L
value(2L)
#++++
error: type mismatch

#==== arithmetic
#---- integer_plus_double
1L + 2.5
#++++
double

#---- vector_plus_scalar
c(1L, 2L) + 4L
#++++
integer[]

#---- scalar_plus_vector
4L + c(1L, 2.5)
#++++
double[]

#---- string_plus_integer
"foo" + 4L
#++++
error: invalid plus operand
