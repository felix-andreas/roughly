#==== special_types
#---- nullable_if_else_branch_mismatch
if (flag) 1L else "foo"
#++++
error[type-error] expected `integer`, found `character`
--> 1:18-1:23
| if (flag) 1L else "foo"

#---- nullable_if_condition_must_be_scalar_logical
if (c(TRUE, FALSE)) 1L
#++++
error[type-error] expected `logical`, found `logical[]`
--> 1:5-1:20
| if (c(TRUE, FALSE)) 1L

#---- nullable_union_not_assignable_to_plain_type
#: integer
value <- if (flag) 1L
#++++
error[type-error] expected `integer`, found `integer | NULL`
--> 2:1-2:23
| value <- if (flag) 1L

#---- nullable_union_allows_null_branch
#: integer | NULL
value <- if (flag) 1L else NULL
#++++
No diagnostics.

#---- nullable_union_allows_null_literal
#: integer | NULL
value <- NULL
#++++
No diagnostics.

#---- null_not_assignable_to_plain_type
#: integer
value <- NULL
#++++
error[type-error] expected `integer`, found `NULL`
--> 2:1-2:14
| value <- NULL

