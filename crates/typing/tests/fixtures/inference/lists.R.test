#==== containers
#---- empty_list_is_empty_tuple
list()
#++++
list{}

#---- positional_list_is_tuple_like_even_when_homogeneous
list(1L, 2L, 3L)
#++++
list{integer, integer, integer}

#---- positional_list_preserves_heterogeneous_shape
list(1L, "foo")
#++++
list{integer, character}

#---- named_list_is_record_like
list(foo = 1L, bar = "foo")
#++++
list{foo: integer, bar: character}

#---- tuple_like_list_coerces_to_homogeneous_list_annotation
#: list[integer]
value <- list(1L, 2L, 3L)
value
#++++
list[integer]
list[integer]

#---- record_like_list_coerces_to_homogeneous_map_like_annotation
#: list[named: integer]
value <- list(foo = 1L, bar = 2L)
value
#++++
list[named: integer]
list[named: integer]
