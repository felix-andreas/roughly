#==== containers
#---- empty_list_is_empty_tuple
list()
#++++
{}

#---- positional_list_is_tuple_like_even_when_homogeneous
list(1L, 2L, 3L)
#++++
{integer, integer, integer}

#---- positional_list_preserves_heterogeneous_shape
list(1L, "foo")
#++++
{integer, character}

#---- named_list_is_map_like
list(foo = 1L, bar = "foo")
#++++
{foo: integer, bar: character}

#---- tuple_like_list_coerces_to_homogeneous_list_annotation
#: list[integer]
value <- list(1L, 2L, 3L)
value
#++++
list[integer]
list[integer]

#---- map_like_list_coerces_to_homogeneous_keyed_list_annotation
#: list[character: integer]
value <- list(foo = 1L, bar = 2L)
value
#++++
list[character: integer]
list[character: integer]
