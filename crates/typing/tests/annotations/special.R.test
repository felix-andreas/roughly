#==== special_types
#---- null_keyword_uppercase
NULL
#++++
NULL

#---- null_keyword_lowercase
null
#++++
NULL

#---- unknown_keyword_uppercase
Unknown
#++++
Unknown

#---- unknown_keyword_lowercase
unknown
#++++
Unknown

#---- any_keyword_uppercase
Any
#++++
Any

#---- any_keyword_lowercase
any
#++++
Any

#==== nullable_special_forms
#---- nullable_integer
integer | NULL
#++++
integer | NULL

#---- nullable_integer_with_null_on_left
NULL | integer
#++++
integer | NULL

#---- nullable_list_item
list[integer | NULL]
#++++
list[integer | NULL]

#---- nullable_named_list_item
list[named: character | NULL]
#++++
list[named: character | NULL]

#---- nullable_record_field
list{value:integer|NULL}
#++++
list{value: integer | NULL}

#---- nullable_tuple_item
list{integer|NULL,character}
#++++
list{integer | NULL, character}

#---- nullable_function_return
fn(integer)->character|NULL
#++++
fn(integer) -> character | NULL

#---- nullable_function_parameter
fn(integer|NULL)->character
#++++
fn(integer | NULL) -> character

#---- nullable_function_return_with_null_on_left
fn(integer)->NULL | character
#++++
fn(integer) -> character | NULL

#---- invalid_non_nullable_union
error:
integer | character
#++++
InvalidSyntax { message: "only nullable unions with a single `NULL` member are supported." }

#---- invalid_union_with_multiple_non_null_members
error:
integer | character | NULL
#++++
InvalidSyntax { message: "only nullable unions with a single `NULL` member are supported." }

#---- invalid_null_null_union
error:
NULL | NULL
#++++
InvalidSyntax { message: "user-facing type syntax does not allow `NULL | NULL`." }

#==== nested_special_forms
#---- nested_any_and_unknown
list{fallback:Any,unresolved:Unknown}
#++++
list{fallback: Any, unresolved: Unknown}

#---- nested_nullable_special_record
list{value:integer|NULL,meta:list{missing:Unknown,default:Any}}
#++++
list{value: integer | NULL, meta: list{missing: Unknown, default: Any}}

#---- special_forms_in_higher_order_function
fn(handler:fn(Unknown)->Any)->list{result:Any,missing:Unknown|NULL}
#++++
fn(handler: fn(Unknown) -> Any) -> list{result: Any, missing: Unknown | NULL}

#---- nullable_function_inside_list
list[fn(integer)->NULL]
#++++
list[fn(integer) -> NULL]
