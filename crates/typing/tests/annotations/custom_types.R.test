#==== named_type_definitions
#---- nominal_type_definition
@type Person {list{name: character, age: double}}
#++++
@type Person {list{name: character, age: double}}

#---- nominal_type_definition_with_whitespace
@type   Person   { list{ name: character, age: double } }
#++++
@type Person {list{name: character, age: double}}

#---- alias_definition
@alias PersonShape {list{name: character, age: double}}
#++++
@alias PersonShape {list{name: character, age: double}}

#---- alias_definition_with_nested_function
@alias Formatter {fn(count: integer) -> character}
#++++
@alias Formatter {fn(count: integer) -> character}

#==== nominal_introduction
#---- nominal_introduction
@new Person
#++++
@new Person

#---- nominal_introduction_with_whitespace
@new   Person
#++++
@new Person

#---- invalid_nominal_introduction_missing_name
error:
@new
#++++
InvalidSyntax { message: "expected a type after the annotation prefix." }

#---- invalid_nominal_introduction_scalar_payload
error:
@new integer
#++++
InvalidSyntax { message: "expected a type." }

#---- invalid_nominal_introduction_structural_payload
error:
@new list{name: character}
#++++
InvalidSyntax { message: "expected a type." }

#==== named_type_references
#---- bare_named_type_reference
Person
#++++
Person

#---- alias_name_reference
PersonShape
#++++
PersonShape

#---- nullable_named_type_reference
Person | NULL
#++++
Person | NULL

#---- list_of_named_type
list[Person]
#++++
list[Person]

#---- named_list_of_named_type
list[named: Person]
#++++
list[named: Person]

#---- tuple_with_named_type
list{Person, integer}
#++++
list{Person, integer}

#---- record_with_named_type
list{owner: Person}
#++++
list{owner: Person}

#---- function_with_named_type_parameter_and_return
fn(Person) -> Person
#++++
fn(Person) -> Person

#---- function_with_nullable_named_type_parameter_and_named_list_return
fn(Person | NULL) -> list[named: Person]
#++++
fn(Person | NULL) -> list[named: Person]

#==== named_type_definition_errors
#---- invalid_type_definition_missing_name
error:
@type {list{name: character}}
#++++
InvalidSyntax { message: "expected a type name." }

#---- invalid_alias_definition_missing_body
error:
@alias Person
#++++
InvalidSyntax { message: "expected `{TYPE}` after the type name." }

#---- invalid_type_definition_with_trailing_text
error:
@type Person {list{name: character}} extra
#++++
InvalidSyntax { message: "did not expect trailing text after the named type definition." }
