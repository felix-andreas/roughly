#==== for_loops
#---- for_variable_introduces_fresh_binding
for (x in list(1L)) {
  x
}
#++++
For(x@b0)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Symbol(x@b0)

#---- for_variable_shadows_outer_binding_inside_loop
x <- 1L
for (x in list(1L)) {
  x
}
x
#++++
Assign(x@b0)
  Integer(1L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Symbol(x@b1)
Symbol(x@b0)

#---- loop_body_resolves_other_outer_binding
y <- 1L
for (x in list(1L)) {
  y
}
#++++
Assign(y@b0)
  Integer(1L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Symbol(y@b0)

#---- assignment_inside_loop_rhs_sees_loop_binding
x <- 0L
for (x in list(1L)) {
  x <- x
  x
}
x
#++++
Assign(x@b0)
  Integer(0L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Assign(x@b2)
      Symbol(x@b1)
    Symbol(x@b2)
Symbol(x@b0)

#---- assignment_inside_loop_rhs_can_use_other_outer_binding
y <- 0L
for (x in list(1L)) {
  y <- y
  y
}
y
#++++
Assign(y@b0)
  Integer(0L)
For(x@b1)
  Call
    Symbol(list@?)
    Argument
      Integer(1L)
  Block
    Assign(y@b2)
      Symbol(y@b0)
    Symbol(y@b2)
Symbol(y@b0)
