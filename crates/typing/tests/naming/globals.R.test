#==== value_globals
#---- later_file_uses_earlier_global
#---- a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)
#---- b.R
x
#++++
Symbol(x@b0)

#---- later_file_call_resolves_cross_file_callee_and_argument
#---- a.R
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)
#---- b.R
identity <- function(x) x
#++++
Assign(identity@b2)
  Function(x@b1)
    Symbol(x@b1)
#---- c.R
identity(value)
#++++
Call
  Symbol(identity@b2)
  Argument
    Symbol(value@b0)

#---- later_file_rebinding_wins_for_later_files
#---- a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)
#---- b.R
x <- x
#++++
Assign(x@b1)
  Symbol(x@b1)
#---- c.R
x
#++++
Symbol(x@b1)

#---- function_body_uses_global_from_other_file
#---- a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)
#---- b.R
f <- function() x
#++++
Assign(f@b1)
  Function()
    Symbol(x@b0)

#==== type_globals
#---- annotation_uses_nominal_type_from_other_file
#---- a.R
#: @type Person {integer}
#++++
TypeDefinition(Person = integer)
#---- b.R
#: Person
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)

#---- annotation_uses_alias_from_other_file
#---- a.R
#: @alias Count {integer}
#++++
TypeAlias(Count = integer)
#---- b.R
#: Count
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)

#---- definition_forward_reference_resolves_across_files
#---- a.R
#: @type Team {list{owner: Person}}
#++++
TypeDefinition(Team = list{owner: Person})
#---- b.R
#: @type Person {list{name: character}}
#++++
TypeDefinition(Person = list{name: character})
#---- c.R
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)

#---- generic_parameter_shadows_global_type_from_other_file
#---- a.R
#: @type T {integer}
#++++
TypeDefinition(T = integer)
#---- b.R
#: @type Box<T> {list{value: T}}
#++++
TypeDefinition(Box<T> = list{value: T})
#---- c.R
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)

#---- nominal_introduction_uses_type_from_other_file
#---- a.R
#: @type Person {list{name: character}}
#++++
TypeDefinition(Person = list{name: character})
#---- b.R
#: @new Person
value <- list(name = "bob")
#++++
Assign(value@b0)
  Call
    Symbol(list@?)
    Argument(name)
      Character("\"bob\"")
