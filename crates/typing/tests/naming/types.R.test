#==== definitions
#---- definition_can_reference_previous_definition
#: @type Person {list{name: character}}
#: @type Team {list{owner: Person}}
value <- 1L
#++++
TypeDefinition(Person = list{name: character})
TypeDefinition(Team = list{owner: Person})
Assign(value@b0)
  Integer(1L)

#---- generic_type_parameter_in_scope_inside_definition
#: @type Box<T> {list{value: T}}
value <- 1L
#++++
TypeDefinition(Box<T> = list{value: T})
Assign(value@b0)
  Integer(1L)

#---- generic_type_parameter_shadows_global_type_name
#: @type T {integer}
#: @type Box<T> {list{value: T}}
value <- 1L
#++++
TypeDefinition(T = integer)
TypeDefinition(Box<T> = list{value: T})
Assign(value@b0)
  Integer(1L)

#---- duplicate_nominal_type_name
#: @type Person {integer}
#: @type Person {double}
value <- 1L
#++++
error[syntax-error] invalid semantics: type name `Person` is already defined by an earlier @type declaration.
--> 2:1-2:25
| #: @type Person {double}

#---- duplicate_alias_name
#: @alias Person {integer}
#: @alias Person {double}
value <- 1L
#++++
error[syntax-error] invalid semantics: type name `Person` is already defined by an earlier @alias declaration.
--> 2:1-2:26
| #: @alias Person {double}

#---- alias_collides_with_nominal_type_name
#: @type Person {integer}
#: @alias Person {double}
value <- 1L
#++++
error[syntax-error] invalid semantics: type name `Person` is already defined by an earlier @type declaration.
--> 2:1-2:26
| #: @alias Person {double}

#---- nominal_type_collides_with_alias_name
#: @alias Person {integer}
#: @type Person {double}
value <- 1L
#++++
error[syntax-error] invalid semantics: type name `Person` is already defined by an earlier @alias declaration.
--> 2:1-2:25
| #: @type Person {double}

#---- definition_unknown_type
#: @type Team {list{owner: Person}}
value <- 1L
#++++
error[syntax-error] type syntax error: unknown type `Person`
--> 1:1-1:36
| #: @type Team {list{owner: Person}}

#==== annotations
#---- annotation_can_reference_declared_nominal
#: @type Person {integer}

#: Person
value <- 1L
#++++
TypeDefinition(Person = integer)
Assign(value@b0)
  Integer(1L)

#---- annotation_can_reference_alias
#: @alias Count {integer}

#: Count
value <- 1L
#++++
TypeAlias(Count = integer)
Assign(value@b0)
  Integer(1L)

#---- annotation_unknown_type
#: Person
value <- 1L
#++++
error[syntax-error] type syntax error: unknown type `Person`
--> 1:1-1:10
| #: Person

#---- annotation_unknown_type_nested_in_generic_argument
#: @alias Box<T> {list{value: T}}

#: Box<Person>
value <- list(value = 1L)
#++++
error[syntax-error] type syntax error: unknown type `Person`
--> 3:1-3:15
| #: Box<Person>

#==== nominal_introduction
#---- nominal_introduction_accepts_nominal_type
#: @type Person {list{name: character}}

#: @new Person
value <- list(name = "bob")
#++++
TypeDefinition(Person = list{name: character})
Assign(value@b0)
  Call
    Symbol(list@?)
    Argument(name)
      Character("\"bob\"")

#---- nominal_introduction_rejects_alias
#: @alias Person {list{name: character}}
value <- 1L
#: @new Person
other <- list(name = "bob")
#++++
error[syntax-error] invalid semantics: `@new` requires a nominal type declared with `@type`, but `Person` is an alias.
--> 3:1-3:15
| #: @new Person
