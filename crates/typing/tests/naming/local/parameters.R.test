#==== parameters
#---- function_parameter_referenced_in_body
identity <- function(x) x
#++++
Assign(identity@b1)
  Function(x@b0)
    Symbol(x@b0)

No diagnostics.

#---- multiple_parameters_referenced_in_order
pair <- function(x, y) {
  x
  y
}
#++++
Assign(pair@b2)
  Function(x@b0, y@b1)
    Block
      Symbol(x@b0)
      Symbol(y@b1)

No diagnostics.

#---- unused_parameter_still_introduces_binding
identity <- function(x, y) x
#++++
Assign(identity@b2)
  Function(x@b0, y@b1)
    Symbol(x@b0)

No diagnostics.

#---- parameter_referenced_after_local_statement
identity <- function(x) {
  helper <- 1L
  x
}
#++++
Assign(identity@b2)
  Function(x@b0)
    Block
      Assign(helper@b1)
        Integer(1L)
      Symbol(x@b0)

No diagnostics.
