#==== top_level
#---- top_level_reference
x <- 1L
x
#++++
Assign(x@b0)
  Integer(1L)
Symbol(x@?)

No diagnostics.

#---- top_level_reference_before_first_binding
x
x <- 1L
#++++
Symbol(x@?)
Assign(x@b0)
  Integer(1L)

No diagnostics.

#---- top_level_call_resolves_callee_and_argument
value <- 1L
identity <- function(x) x
identity(value)
#++++
Assign(value@b0)
  Integer(1L)
Assign(identity@b2)
  Function(x@b1)
    Symbol(x@b1)
Call
  Symbol(identity@?)
  Argument
    Symbol(value@?)

No diagnostics.

#---- distinct_top_level_bindings_have_distinct_uses
x <- 1L
y <- "ok"
x
y
#++++
Assign(x@b0)
  Integer(1L)
Assign(y@b1)
  Character("\"ok\"")
Symbol(x@?)
Symbol(y@?)

No diagnostics.

#==== rebinding
#---- top_level_rebinding_creates_fresh_binding
x <- 1L
x <- "ok"
x
#++++
Assign(x@b0)
  Integer(1L)
Assign(x@b1)
  Character("\"ok\"")
Symbol(x@?)

No diagnostics.

#---- earlier_use_resolves_to_final_global_binding
x <- 1L
x
x <- "ok"
x
#++++
Assign(x@b0)
  Integer(1L)
Symbol(x@?)
Assign(x@b1)
  Character("\"ok\"")
Symbol(x@?)

No diagnostics.

#---- assignment_rhs_resolves_to_final_global_binding
x <- 1L
x <- x
x
#++++
Assign(x@b0)
  Integer(1L)
Assign(x@b1)
  Symbol(x@?)
Symbol(x@?)

No diagnostics.
