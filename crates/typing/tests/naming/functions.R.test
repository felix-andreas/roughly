#==== parameters
#---- function_parameter_referenced_in_body
identity <- function(x) x
#++++
Assign(identity@b1)
  Function(x@b0)
    Symbol(x@b0)

#---- top_level_binding_used_inside_function
x <- 1L
f <- function() x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b1)
  Function()
    Symbol(x@b0)

#---- parameter_shadows_outer_binding
x <- 1L
f <- function(x) x
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b2)
  Function(x@b1)
    Symbol(x@b1)

#---- local_assignment_shadows_outer_binding
x <- 1L
f <- function() {
  x <- "ok"
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b2)
  Function()
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Symbol(x@b1)

#---- local_assignment_shadows_parameter
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(f@b2)
  Function(x@b0)
    Block
      Assign(x@b1)
        Character("\"ok\"")
      Symbol(x@b1)

#==== nested_functions
#---- nested_function_closes_over_outer_local
f <- function() {
  x <- 1L
  g <- function() x
}
#++++
Assign(f@b2)
  Function()
    Block
      Assign(x@b0)
        Integer(1L)
      Assign(g@b1)
        Function()
          Symbol(x@b0)

#---- nested_function_closes_over_outer_parameter
f <- function(x) {
  g <- function() x
}
#++++
Assign(f@b2)
  Function(x@b0)
    Block
      Assign(g@b1)
        Function()
          Symbol(x@b0)

#---- nested_function_parameter_shadows_enclosing_binding
f <- function() {
  x <- 1L
  g <- function(x) x
}
#++++
Assign(f@b3)
  Function()
    Block
      Assign(x@b0)
        Integer(1L)
      Assign(g@b2)
        Function(x@b1)
          Symbol(x@b1)

#---- nested_function_local_shadows_enclosing_binding
f <- function(x) {
  g <- function() {
    x <- "ok"
    x
  }
}
#++++
Assign(f@b3)
  Function(x@b0)
    Block
      Assign(g@b2)
        Function()
          Block
            Assign(x@b1)
              Character("\"ok\"")
            Symbol(x@b1)

#---- multi_hop_nested_function_closes_over_outer_local
f <- function() {
  x <- 1L
  g <- function() {
    h <- function() x
  }
}
#++++
Assign(f@b3)
  Function()
    Block
      Assign(x@b0)
        Integer(1L)
      Assign(g@b2)
        Function()
          Block
            Assign(h@b1)
              Function()
                Symbol(x@b0)

#---- multi_hop_nested_function_uses_nearest_shadowing_binding
x <- 1L
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    h <- function() x
  }
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b5)
  Function()
    Block
      Assign(x@b1)
        Character("\"outer\"")
      Assign(g@b4)
        Function()
          Block
            Assign(x@b2)
              Logical(true)
            Assign(h@b3)
              Function()
                Symbol(x@b2)

#---- repeated_shadow_chain
x <- 1L
f <- function(x) {
  x <- "ok"
  x
}
#++++
Assign(x@b0)
  Integer(1L)
Assign(f@b3)
  Function(x@b1)
    Block
      Assign(x@b2)
        Character("\"ok\"")
      Symbol(x@b2)
