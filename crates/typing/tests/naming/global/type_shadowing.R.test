#==== definitions
#---- generic_type_parameter_shadows_global_type_name
#---- R/main.R
#: @type T {integer}
#: @type Box<T> {list{value: T}}
value <- 1L
#++++
TypeDefinition(T = integer)
TypeDefinition(Box<T> = list{value: T})
Assign(value@b0)
  Integer(1L)

#---- generic_type_parameter_shadows_global_alias_name
#---- R/main.R
#: @alias T {integer}
#: @alias Box<T> {list{value: T}}
value <- 1L
#++++
TypeAlias(T = integer)
TypeAlias(Box<T> = list{value: T})
Assign(value@b0)
  Integer(1L)

#---- generic_type_parameter_shadows_global_type_from_other_file
#---- R/a.R
#: @type T {integer}
#++++
TypeDefinition(T = integer)
#---- R/b.R
#: @type Box<T> {list{value: T}}
#++++
TypeDefinition(Box<T> = list{value: T})
#---- R/c.R
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)
