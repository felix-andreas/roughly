#==== value_globals
#---- later_file_uses_earlier_global
#---- R/a.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)
#---- R/b.R
x
#++++
Symbol(x@b0)

#---- earlier_file_uses_later_global
#---- R/a.R
x
#++++
Symbol(x@b0)
#---- R/b.R
x <- 1L
#++++
Assign(x@b0)
  Integer(1L)

#---- later_file_call_resolves_cross_file_callee_and_argument
#---- R/a.R
value <- 1L
#++++
Assign(value@b0)
  Integer(1L)
#---- R/b.R
identity <- function(x) x
#++++
Assign(identity@b2)
  Function(x@b1)
    Symbol(x@b1)
#---- R/c.R
identity(value)
#++++
Call
  Symbol(identity@b2)
  Argument
    Symbol(value@b0)

