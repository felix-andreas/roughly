#==== basics
#---- assignment_and_reference
value <- 1L
value
#++++
Assign(value@b0)
  Integer(1L)
Symbol(value@b0)

#---- call_resolves_callee_and_argument
value <- 1L
identity <- function(x) x
identity(value)
#++++
Assign(value@b0)
  Integer(1L)
Assign(identity@b2)
  Function(x@b1)
    Symbol(x@b1)
Call
  Symbol(identity@b2)
  Argument
    Symbol(value@b0)
