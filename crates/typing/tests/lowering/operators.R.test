#==== operators
#---- unary_minus
-1L
#++++
UnaryMinus
  Integer("1L")

#---- binary_plus
1L + 2L
#++++
Call
  Symbol(+)
  Argument:
    Integer("1L")
  Argument:
    Integer("2L")

#---- binary_minus
1L - 2L
#++++
Call
  Symbol(-)
  Argument:
    Integer("1L")
  Argument:
    Integer("2L")

#---- binary_multiply
1L * 2L
#++++
Call
  Symbol(*)
  Argument:
    Integer("1L")
  Argument:
    Integer("2L")

#---- binary_divide
1L / 2L
#++++
Call
  Symbol(/)
  Argument:
    Integer("1L")
  Argument:
    Integer("2L")

#---- binary_power
1L ** 2L
#++++
Call
  Symbol(**)
  Argument:
    Integer("1L")
  Argument:
    Integer("2L")

#---- logical_and
TRUE && FALSE
#++++
Call
  Symbol(&&)
  Argument:
    Logical(true)
  Argument:
    Logical(false)

#---- logical_or
TRUE || FALSE
#++++
Call
  Symbol(||)
  Argument:
    Logical(true)
  Argument:
    Logical(false)

#---- assignment_left
x <- 1L
#++++
Assign x
  Integer("1L")

#---- assignment_equals
x = 1L
#++++
Assign x
  Integer("1L")
