#==== annotations
#---- top_level_assignment
#: integer
x <- 1L
#++++
#: integer
Assign x
  Integer("1L")

#---- function_assignment
#: fn(integer) -> integer
f <- function(x) x
#++++
#: fn(integer) -> integer
Assign f
  Function (x)
    Symbol(x)

#---- expression_annotation
#: integer
1L
#++++
#: integer
Integer("1L")

#---- nested_block_annotation
{
  #: integer
  x <- 1L
}
#++++
Block (trailing_semi: false)
  #: integer
  Assign x
    Integer("1L")

#---- if_unknown_annotation
#: @if-unknown integer
x <- 1L
#++++
#: @if-unknown integer
Assign x
  Integer("1L")

#---- trust_annotation
#: @trust integer
x <- 1L
#++++
#: @trust integer
Assign x
  Integer("1L")

#---- nominal_introduction_annotation
#: @type Person {list{name: character}}

#: @new Person
x <- list(name = "bob")
#++++
TypeDefinition Person = list{name: character}
#: @new Person
Assign x
  Call
    Symbol(list)
    Argument name:
      Character("\"bob\"")

#---- generic_nominal_introduction_annotation
#: @type Person<T> {T}

#: @new Person<integer>
x <- 1L
#++++
TypeDefinition Person<T> = T
#: @new Person<integer>
Assign x
  Integer("1L")

#---- checked_generic_nominal_annotation
#: @type Person<T> {list{value: T}}

#: Person<integer>
x <- list(value = 1L)
#++++
TypeDefinition Person<T> = list{value: T}
#: Person<integer>
Assign x
  Call
    Symbol(list)
    Argument value:
      Integer("1L")

#---- expanded_optional_parameter_annotation
#: @param {integer} count
#: @param {character} [label]
#: @returns {integer}
f <- function(count, label = NULL) count
#++++
#: fn(count: integer, [label]: character) -> integer
Assign f
  Function (count, label)
    Symbol(count)

#---- generic_expanded_annotation
#: @forall T
#: @param {T} value
#: @return {T}
identity <- function(value) value
#++++
#: <T> fn(value: T) -> T
Assign identity
  Function (value)
    Symbol(value)

#---- multiline_annotation
#: @param {integer} a
#: @param {integer} b
#: @return {integer}
f <- function(a, b) a + b
#++++
#: fn(a: integer, b: integer) -> integer
Assign f
  Function (a, b)
    Call
      Symbol(+)
      Argument:
        Symbol(a)
      Argument:
        Symbol(b)

#---- standalone_alias
#: @alias Count {integer}
#++++
TypeAlias Count = integer

#---- generic_alias_definition
#: @alias Box<T> {list{value: T}}
#++++
TypeAlias Box<T> = list{value: T}

#---- standalone_type
#: @type Pair<T, U> {list{first: T, second: U}}
#++++
TypeDefinition Pair<T, U> = list{first: T, second: U}

#---- multiline_definition_block
#: @alias PersonShape {list{name: character}}
#: @type Person {PersonShape}
#++++
TypeAlias PersonShape = list{name: character}
TypeDefinition Person = PersonShape

#---- definition_unknown_type_is_not_lowering_error
#: @type Team {list{owner: Person}}
value <- 1L
#++++
TypeDefinition Team = list{owner: Person}
Assign value
  Integer("1L")

#---- nominal_introduction_alias_check_is_not_lowering_error
#: @alias Person {list{name: character}}
value <- 1L
#: @new Person
other <- list(name = "bob")
#++++
TypeAlias Person = list{name: character}
Assign value
  Integer("1L")
#: @new Person
Assign other
  Call
    Symbol(list)
    Argument name:
      Character("\"bob\"")
