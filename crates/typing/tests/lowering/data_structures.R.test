#==== data_structures
#---- subset_single
x[1L]
#++++
Subset
  Symbol(x)
  Argument:
    Integer("1L")

#---- subset_multiple
x[1L, 2L]
#++++
Subset
  Symbol(x)
  Argument:
    Integer("1L")
  Argument:
    Integer("2L")

#---- subset_named
x[row = 1L, col = 2L]
#++++
Subset
  Symbol(x)
  Argument row:
    Integer("1L")
  Argument col:
    Integer("2L")

#---- subset2_single
x[[1L]]
#++++
Subset2
  Symbol(x)
  Argument:
    Integer("1L")

#---- subset2_multiple
x[[1L, 2L]]
#++++
Subset2
  Symbol(x)
  Argument:
    Integer("1L")
  Argument:
    Integer("2L")

#---- subset2_named
x[[row = 1L, col = 2L]]
#++++
Subset2
  Symbol(x)
  Argument row:
    Integer("1L")
  Argument col:
    Integer("2L")

#---- subset2_string_literal_converted
x[["a"]]
#++++
Subset2
  Symbol(x)
  Argument:
    StringLiteralName("a")

#---- dollar_identifier
x$a
#++++
Dollar a
  Symbol(x)

#---- dollar_string_converted
x$"a"
#++++
Dollar a
  Symbol(x)
