#==== general
#---- empty_input
#++++
No diagnostics.

#---- valid_assignment
value <- 1L
#++++
No diagnostics.

#---- invalid_syntax
value <-
#++++
error[syntax-error] Missing syntax near 2:1
--> 2:1-2:1
| <empty line>

#==== names
#---- unknown_name
value
#++++
error[type-error] I could not find `value` in scope.
--> 1:1-1:6
| value

#==== calls
#---- call_argument_type_error
identity <- function(x) x
identity(1)
identity("oops")
#++++
error[type-error] This expression has type `scalar character`, but it needs to be `scalar double`.
--> 3:1-3:17
| identity("oops")

#---- calling_non_function
value <- 1L
value(2L)
#++++
error[type-error] This expression has type `fn(scalar integer) -> type1`, but it needs to be `scalar integer`.
--> 2:1-2:10
| value(2L)

#---- call_arity_mismatch
identity <- function(x) x
identity(1L, 2L)
#++++
error[type-error] This call passes 2 positional argument(s), but the function accepts 1.
--> 2:1-2:17
| identity(1L, 2L)
