#==== general
#---- empty_input
#++++
No diagnostics.

#---- valid_assignment
value <- 1L
#++++
No diagnostics.

#---- invalid_syntax
value <-
#++++
error[syntax-error] Missing syntax near 2:1
--> 2:1-2:1
| <empty line>

#==== names
#---- unknown_name
value
#++++
error[type-error] I could not find `value` in scope.
--> 1:1-1:6
| value

#==== calls
#---- polymorphic_identity_multiple_types
identity <- function(x) x
identity(1L)
identity("oops")
#++++
No diagnostics.

#---- calling_non_function
value <- 1L
value(2L)
#++++
error[type-error] expected `integer`, found `fn(integer) -> type1`
--> 2:1-2:10
| value(2L)

#---- call_arity_mismatch
identity <- function(x) x
identity(1L, 2L)
#++++
error[type-error] This call passes 2 positional argument(s), but the function accepts 1.
--> 2:1-2:17
| identity(1L, 2L)

#---- polymorphic_arity_after_valid_use
identity <- function(x) x
identity(1L)
identity(1L, 2L)
#++++
error[type-error] This call passes 2 positional argument(s), but the function accepts 1.
--> 3:1-3:17
| identity(1L, 2L)

#---- unknown_callee_in_call
missing(1L)
#++++
error[type-error] I could not find `missing` in scope.
--> 1:1-1:8
| missing(1L)

#---- polymorphic_assignment_multiple_types
identity <- function(x) x
first <- identity(1L)
second <- identity("ok")
#++++
No diagnostics.

#---- unknown_callee_after_valid_polymorphic_use
identity <- function(x) x
identity(1L)
missing(identity("ok"))
#++++
error[type-error] I could not find `missing` in scope.
--> 3:1-3:8
| missing(identity("ok"))

#---- call_arity_after_polymorphic_assignment
identity <- function(x) x
first <- identity(1L)
identity("ok", "extra")
#++++
error[type-error] This call passes 2 positional argument(s), but the function accepts 1.
--> 3:1-3:24
| identity("ok", "extra")

#---- polymorphic_repeated_independent_uses
identity <- function(x) x
first <- identity(1L)
second <- identity("ok")
third <- identity(2L)
#++++
No diagnostics.

#---- polymorphic_higher_order_apply
apply <- function(f) function(x) f(x)
identity <- function(x) x
int_apply <- apply(identity)
first <- int_apply(1L)
second <- int_apply("ok")
#++++
No diagnostics.

#---- polymorphic_higher_order_conflict
apply <- function(f) function(x) f(x + 1L)
identity <- function(x) x
mixed_apply <- apply(identity)
mixed_apply("ok")
#++++
error[type-error] expected `numeric`, found `type1`
--> 1:36-1:37
| apply <- function(f) function(x) f(x + 1L)

#==== arithmetic
#---- string_plus_integer
"foo" + 4L
#++++
error[type-error] expected `numeric`, found `character`
--> 1:1-1:6
| "foo" + 4L

#---- vector_plus_scalar
c(1L, 2L) + 3L
#++++
No diagnostics.

#---- scalar_plus_vector
1L + c(2L, 3L)
#++++
No diagnostics.

#---- double_vector_plus_integer_scalar
c(1.5, 2.5) + 1L
#++++
No diagnostics.
