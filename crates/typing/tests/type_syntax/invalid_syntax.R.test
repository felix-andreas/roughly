#==== directive_failures
#---- bare_at_sign
@
#++++
InvalidSyntax { message: "unknown annotation directive `@`. expected one of `@type`, `@alias`, `@if-unknown`, `@trust`, or `@new`." }

#---- unknown_directive_without_payload
@unknown
#++++
InvalidSyntax { message: "unknown annotation directive `@unknown`. expected one of `@type`, `@alias`, `@if-unknown`, `@trust`, or `@new`." }

#---- unknown_directive_with_payload
@unknown integer
#++++
InvalidSyntax { message: "unknown annotation directive `@unknown`. expected one of `@type`, `@alias`, `@if-unknown`, `@trust`, or `@new`." }

#==== incomplete_forms
#---- bare_list_keyword
list
#++++
InvalidSyntax { message: "expected `[` or `{` after `list` in a list type." }

#---- bare_function_keyword
fn
#++++
InvalidSyntax { message: "expected `(` after `fn`." }

#---- empty_list_brackets
list[]
#++++
InvalidSyntax { message: "expected a type." }

#---- empty_named_list_value
list[named:]
#++++
InvalidSyntax { message: "expected a type." }

#==== unexpected_closing_delimiters
#---- bare_closing_brace
}
#++++
InvalidSyntax { message: "expected a type." }

#---- bare_closing_bracket
]
#++++
InvalidSyntax { message: "expected a type." }

#---- bare_closing_paren
)
#++++
InvalidSyntax { message: "expected a type." }

#==== missing_closing_delimiters
#---- unclosed_list_bracket
list[integer
#++++
InvalidSyntax { message: "missing closing delimiter ]" }

#---- unclosed_list_brace
list{integer
#++++
InvalidSyntax { message: "expected `}` to close `list{...}`." }

#---- unclosed_function_parameters
fn(integer
#++++
InvalidSyntax { message: "expected `)` to close `fn(...)`." }

#---- unclosed_named_list
list[named: integer
#++++
InvalidSyntax { message: "missing closing delimiter ]" }

#==== malformed_separators
#---- double_comma_in_function_parameters
fn(integer,,character)
#++++
InvalidSyntax { message: "expected a type. (while parsing positional parameter)" }

#---- double_comma_in_tuple_items
list{integer,,character}
#++++
InvalidSyntax { message: "expected a type. (while parsing tuple item)" }

#---- semicolon_in_function_parameters
fn(integer;character)
#++++
InvalidSyntax { message: "expected `)` to close `fn(...)`." }

#---- semicolon_in_tuple_items
list{integer;character}
#++++
InvalidSyntax { message: "expected `}` to close `list{...}`." }

#==== unexpected_trailing_or_mismatched_delimiters
#---- trailing_closing_brace_after_primitive
integer}
#++++
InvalidSyntax { message: "unexpected trailing input starting at byte 7." }

#---- trailing_closing_bracket_after_primitive
integer]
#++++
InvalidSyntax { message: "unexpected trailing input starting at byte 7." }

#---- mismatched_named_list_record_closer
list[named: integer}
#++++
InvalidSyntax { message: "missing closing delimiter ]" }

#---- mismatched_function_list_closer
fn(integer]
#++++
InvalidSyntax { message: "expected `)` to close `fn(...)`." }

#==== generic_syntax_failures
#---- square_bracket_named_generic_definition
@type Person[T] {list{value: T}}
#++++
InvalidSyntax { message: "expected `{TYPE}` after the type name." }

#---- square_bracket_named_generic_alias_definition
@alias Box[T] {list{value: T}}
#++++
InvalidSyntax { message: "expected `{TYPE}` after the type name." }

#---- misplaced_binder_inside_named_type_body
@type Person {<T> list{value: T}}
#++++
InvalidSyntax { message: "expected a type." }

#---- misplaced_binder_inside_named_alias_body
@alias Box {<T> list{value: T}}
#++++
InvalidSyntax { message: "expected a type." }

#---- attached_function_binder_not_supported
fn<T>(T) -> T
#++++
InvalidSyntax { message: "expected `(` after `fn`." }

#---- attached_named_type_application_not_supported
Person[T]
#++++
InvalidSyntax { message: "unexpected trailing input starting at byte 6." }

#---- bare_forall_without_type
<T>
#++++
InvalidSyntax { message: "expected a type." }

#---- empty_forall_parameter_list
<> fn(integer) -> integer
#++++
InvalidSyntax { message: "expected at least one type parameter in `<...>`." }

#---- trailing_comma_in_forall
<T,> fn(T) -> T
#++++
InvalidSyntax { message: "expected a type parameter name in `<...>`." }

#---- repeated_comma_in_forall
<T,,U> fn(T) -> U
#++++
InvalidSyntax { message: "expected a type parameter name in `<...>`." }

#---- malformed_expanded_forall_trailing_comma
@forall T,
#++++
InvalidSyntax { message: "expected a type parameter name in `@forall`." }

#---- malformed_expanded_forall_double_comma
@forall T,,U
#++++
InvalidSyntax { message: "expected a type parameter name in `@forall`." }

#---- unclosed_universal_binder
<T fn(T) -> T
#++++
InvalidSyntax { message: "expected `,` or `>` in `<...>`." }

#---- unclosed_named_generic_application
Person<integer
#++++
InvalidSyntax { message: "expected `,` or `>` in type argument list." }

#---- empty_named_generic_application
Person<>
#++++
InvalidSyntax { message: "expected at least one type argument in generic type application." }

#---- trailing_comma_in_named_generic_application
Person<integer,>
#++++
InvalidSyntax { message: "expected a type." }

#---- double_comma_in_named_generic_application
Person<integer,,character>
#++++
InvalidSyntax { message: "expected a type." }

#---- missing_comma_in_named_generic_application
Person<integer character>
#++++
InvalidSyntax { message: "expected `,` or `>` in type argument list." }

#---- malformed_named_generic_definition_parameter_list
@alias Box<T,> {list{value: T}}
#++++
InvalidSyntax { message: "expected a type parameter name." }

#---- trailing_pipe_in_union
integer |
#++++
InvalidSyntax { message: "expected a type." }

#---- leading_pipe_in_union
| integer
#++++
InvalidSyntax { message: "expected a type." }

#---- bare_pipe
|
#++++
InvalidSyntax { message: "expected a type." }

#---- double_pipe_in_union
integer || NULL
#++++
InvalidSyntax { message: "expected a type." }
