#==== nullable_primitives
#---- nullable_integer
integer | NULL
#++++
integer | NULL

#---- nullable_logical
logical|NULL
#++++
logical | NULL

#---- nullable_character_with_lowercase_null
character | null
#++++
character | NULL

#---- nullable_integer_with_null_on_left
NULL | integer
#++++
integer | NULL

#==== nullable_vectors
#---- nullable_integer_vector
integer[] | NULL
#++++
integer[] | NULL

#---- nullable_named_character_vector
character[named]|NULL
#++++
character[named] | NULL

#---- nullable_logical_vector_with_lowercase_null
logical[] | null
#++++
logical[] | NULL

#==== nullable_lists
#---- nullable_list_item
list[integer | NULL]
#++++
list[integer | NULL]

#---- nullable_named_list_item
list[named: character | NULL]
#++++
list[named: character | NULL]

#---- nullable_record_field
list{value:integer|NULL}
#++++
list{value: integer | NULL}

#---- nullable_tuple_item
list{integer|NULL,character}
#++++
list{integer | NULL, character}

#==== nullable_functions
#---- nullable_function_return
fn(integer)->character|NULL
#++++
fn(integer) -> character | NULL

#---- nullable_function_parameter
fn(integer|NULL)->character
#++++
fn(integer | NULL) -> character

#---- nullable_function_return_with_null_on_left
fn(integer)->NULL | character
#++++
fn(integer) -> character | NULL

#---- nullable_function_inside_list
list[fn(integer)->NULL]
#++++
list[fn(integer) -> NULL]

#==== nested_nullable_forms
#---- nested_nullable_special_record
list{value:integer|NULL,meta:list{missing:Unknown,default:Any}}
#++++
list{value: integer | NULL, meta: list{missing: Unknown, default: Any}}

#---- special_forms_in_higher_order_function
fn(handler:fn(Unknown)->Any)->list{result:Any,missing:Unknown|NULL}
#++++
fn(handler: fn(Unknown) -> Any) -> list{result: Any, missing: Unknown | NULL}

#==== invalid_unions
#---- invalid_non_nullable_union
integer | character
#++++
UnsupportedConstruct { message: "only nullable unions with `NULL` are supported for now." }

#---- invalid_union_with_multiple_non_null_members
integer | character | NULL
#++++
UnsupportedConstruct { message: "only nullable unions with `NULL` are supported for now." }

#---- invalid_null_null_union
NULL | NULL
#++++
UnsupportedConstruct { message: "`NULL | NULL` is not valid type syntax." }
