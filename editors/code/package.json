{
	"name": "roughly",
	"displayName": "Roughly",
	"description": "R language support",
	"author": "Felix Andreas",
	"version": "0.2.4",
	"publisher": "felix-andreas",
	"license": "UPL-1.0",
	"homepage": "https://roughly.felixandreas.me",
	"repository": {
		"type": "git",
		"url": "https://github.com/felix-andreas/roughly"
	},
	"bugs": {
		"url": "https://github.com/felix-andreas/roughly/issues"
	},
	"icon": "images/icon.png",
	"keywords": [
		"r",
		"language server",
		"formatting",
		"linting"
	],
	"categories": [
		"Formatters",
		"Linters",
		"Programming Languages"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"scripts": {
		"vscode:prepublish": "bun run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"package": "vsce package",
		"vsce": "vsce"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@types/node": "^20.19.8",
		"@types/vscode": "^1.75.1",
		"@vscode/vsce": "^3.6.0",
		"eslint": "^9.31.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.37.0"
	},
	"main": "./out/extension",
	"activationEvents": [
		"onLanguage:r",
		"workspaceContains:*.r",
		"workspaceContains:*.R"
	],
	"contributes": {
		"languages": [
			{
				"id": "r",
				"aliases": [
					"R",
					"r"
				],
				"extensions": [
					".R",
					".r",
					".Rprofile",
					".rprofile"
				],
				"filenames": [
					"NAMESPACE"
				],
				"configuration": "language-configuration.json"
			}
		],
		"commands": [
			{
				"title": "Roughly: Restart Server",
				"command": "roughly.restartServer"
			},
			{
				"title": "Roughly: Start Server",
				"command": "roughly.startServer"
			},
			{
				"title": "Roughly: Stop Server",
				"command": "roughly.stopServer"
			},
			{
				"title": "Roughly: Open Logs",
				"command": "roughly.openLogs"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Roughly",
			"properties": {
				"roughly.path": {
					"scope": "resource",
					"type": [
						"null",
						"string"
					],
					"format": "path",
					"markdownDescription": "Location of the `roughly` executable, e.g., `\"/path/to/roughly\"`.",
					"default": null
				},
				"roughly.args": {
					"scope": "resource",
					"type": [
						"null",
						"array"
					],
					"items": {
						"type": "string"
					},
					"markdownDescription": "Arguments passed to the `roughly` executable.",
					"default": null
				},
				"roughly.experimentalFeatures": {
					"scope": "resource",
					"type": [
						"null",
						"array"
					],
					"items": {
						"type": "string"
					},
					"markdownDescription": "Enable experimental features.",
					"default": null
				}
			}
		}
	}
}