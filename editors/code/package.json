{
	"name": "roughly",
	"displayName": "Roughly",
	"description": "R language support",
	"author": "Felix Andreas",
	"version": "0.0.6",
	"publisher": "felix-andreas",
	"icon": "images/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/felix-andreas/roughly"
	},
	"license": "UPL-1.0",
	"keywords": [
		"r"
	],
	"categories": [
		"Formatters",
		"Linters",
		"Programming Languages"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"scripts": {
		"vscode:prepublish": "bun run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"package": "vsce package",
		"vsce": "vsce"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@types/node": "^20",
		"@types/vscode": "^1.75.1",
		"@vscode/vsce": "^3.5.0",
		"eslint": "^9.29.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.1"
	},
	"main": "./out/extension",
	"activationEvents": [
		"onLanguage:r",
		"workspaceContains:R"
	],
	"contributes": {
		"commands": [
			{
				"title": "Roughly: Restart Server",
				"command": "roughly.restartServer"
			},
			{
				"title": "Roughly: Start Server",
				"command": "roughly.startServer"
			},
			{
				"title": "Roughly: Stop Server",
				"command": "roughly.stopServer"
			},
			{
				"title": "Roughly: Open Logs",
				"command": "roughly.openLogs"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Roughly",
			"properties": {
				"roughly.path": {
					"scope": "resource",
					"type": [
						"string",
						"null"
					],
					"format": "path",
					"default": null,
					"markdownDescription": "Location of the `roughly` executable, e.g., `[\"/path/to/roughly\"]`."
				},
				"roughly.args": {
					"scope": "resource",
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"server"
					],
					"markdownDescription": "Arguments passed to `roughly`."
				}
			}
		}
	}
}